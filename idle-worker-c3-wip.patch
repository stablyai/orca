diff --git a/src/main/runtime/orchestration/db/failure-resume-enqueue.ts b/src/main/runtime/orchestration/db/failure-resume-enqueue.ts
new file mode 100644
index 00000000000..ddd84f68017
--- /dev/null
+++ b/src/main/runtime/orchestration/db/failure-resume-enqueue.ts
@@ -0,0 +1,50 @@
+import type { OrchestrationDb } from './orchestration-db'
+import { runLifecycleWriteTransaction } from './lifecycle-write-transaction-runner'
+import type { JournalFailureEnqueueAuthority } from '../../../native-chat/agent-session-journal/journal-failure-authority'
+import { StructuredAgentSessionInputNotAdmitted } from '../../../native-chat/agent-session-wire/delivery/structured-agent-session-input-admission'
+
+export function failureResumeAuthoritySnapshot(
+  run: NonNullable<ReturnType<OrchestrationDb['getRun']>>,
+  dispatch: NonNullable<ReturnType<OrchestrationDb['getDispatchContextById']>>
+): string {
+  return JSON.stringify([
+    run.id,
+    run.consumer_generation,
+    run.coordinator_handle,
+    run.coordinator_pane_key,
+    run.coordinator_orca_session_id_generation === run.consumer_generation
+      ? run.coordinator_orca_session_id
+      : null,
+    dispatch.id,
+    dispatch.status,
+    dispatch.consumer_generation,
+    dispatch.assignee_handle,
+    dispatch.assignee_orca_session_id,
+    dispatch.assignee_pane_key,
+    dispatch.process_incarnation,
+    dispatch.host_scope,
+    dispatch.capability_revoked_at
+  ])
+}
+
+/** The authority writer stays fenced through the synchronous provider write; no await owns this lock. */
+export function withFailureResumeAuthority<T>(
+  db: OrchestrationDb,
+  authority: JournalFailureEnqueueAuthority,
+  enqueue: () => T
+): T {
+  return runLifecycleWriteTransaction(db.db, 'failure_resume_enqueue', () => {
+    const dispatch = db.getDispatchContextById(authority.dispatchId)
+    const run = dispatch && db.getRun(dispatch.run_id)
+    if (
+      !dispatch ||
+      dispatch.status !== 'dispatched' ||
+      !run ||
+      run.id !== authority.runId ||
+      failureResumeAuthoritySnapshot(run, dispatch) !== authority.snapshot
+    ) {
+      throw new StructuredAgentSessionInputNotAdmitted()
+    }
+    return enqueue()
+  })
+}
