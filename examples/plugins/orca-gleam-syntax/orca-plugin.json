{
  "$schema": "./orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "orca-gleam-syntax",
  "publisher": "stablyai",
  "name": "Gleam",
  "version": "1.0.0",
  "description": "Syntax highlighting for Gleam files.",
  "engines": { "orca": ">=1.4.245" },
  "contributes": {
    "syntaxes": [
      {
        "id": "gleam",
        "title": "Gleam",
        "scopeName": "source.gleam",
        "path": "syntaxes/gleam.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".gleam"]
      }
    ]
  }
}
