{
  "name": "@orca-cloud/postgres-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apply-postgres-schema": {
      "types": "./dist/apply-postgres-schema.d.ts",
      "default": "./dist/apply-postgres-schema.js"
    },
    "./catalog-object-precheck": {
      "types": "./dist/catalog-object-precheck.d.ts",
      "default": "./dist/catalog-object-precheck.js"
    },
    "./schema-lock-target": {
      "types": "./dist/schema-lock-target.d.ts",
      "default": "./dist/schema-lock-target.js"
    },
    "./*": "./*"
  }
}
