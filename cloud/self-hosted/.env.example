# Copy to .env and fill in. Keep .env private.

# Public hostname. Point its DNS at this machine and open ports 80 and 443.
ORCA_DOMAIN=orca.example.com

# The administrator who signs in with the secret below.
ORCA_AUTH_EMAIL=you@example.com
# Generate each with: openssl rand -base64 48
ORCA_AUTH_ADMIN_SECRET=
ORCA_RELAY_ASSIGNMENT_SIGNING_KEY=

# Trying it without public DNS: Caddy's own CA, which phones and packaged
# desktops do not trust. Put the port in ORCA_DOMAIN too.
# ORCA_TLS=internal
# ORCA_DOMAIN=orca.test:8443
# ORCA_HTTPS_PORT=8443
# ORCA_HTTP_PORT=8080
