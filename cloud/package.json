{
  "name": "orca-cloud",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:process-host": "tsc -p ../src/packages/process-host/tsconfig.json --typeRoots ./node_modules/@types",
    "dev": "pnpm --filter @orca-cloud/relay dev",
    "lint": "pnpm -r lint",
    "pretest": "pnpm test:runner",
    "test": "pnpm build:libs && pnpm -r --config.enable-pre-post-scripts=false --filter \"!@orca-cloud/relay\" test && pnpm --filter @orca-cloud/relay test",
    "build:libs": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test:runner": "node --import tsx --conditions=orca-source --test dev/scripts/run-relay-tests.test.mjs \"../.github/actions/cloud-sql-rollout-lease/*.test.mjs\""
  },
  "devDependencies": {
    "@orca/process-host": "link:../src/packages/process-host",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
