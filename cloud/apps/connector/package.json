{
  "name": "@orca-cloud/connector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "discord-operator": "node dist/discord-operator-cli.js",
    "slack-operator": "node dist/slack-operator-cli.js",
    "pretest": "pnpm --filter @orca-cloud/postgres-schema build && pnpm --filter @orca-cloud/push-contract build && pnpm --filter @orca-cloud/connector-contract build && pnpm --filter @orca-cloud/cloud-database build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@hono/node-server": "^2.1.5",
    "@orca-cloud/cloud-database": "workspace:*",
    "@orca-cloud/connector-contract": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@orca-cloud/postgres-schema": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "8.22.0"
  }
}
