{
  "name": "@orca-cloud/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "lint": "pnpm typecheck",
    "pretest": "pnpm --dir ../.. build:process-host && pnpm --filter @orca-cloud/postgres-schema build && pnpm --filter @orca-cloud/relay-contract build",
    "start": "node dist/index.js",
    "test": "node --import tsx --conditions=orca-source ../../dev/scripts/run-relay-tests.mjs",
    "typecheck": "pnpm --dir ../.. build:process-host && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@orca-cloud/postgres-schema": "workspace:*",
    "@orca-cloud/relay-contract": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "^5.0.5"
  }
}
