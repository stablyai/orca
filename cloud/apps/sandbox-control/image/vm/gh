#!/usr/bin/env bash
# gh for agents in Orca Cloud workspaces: GitHub actions an agent takes in a teammate's turn (gh pr create,
# comments, reviews) act as that teammate, through their own placeholder, swapped at egress for their GitHub
# user token (never in the VM). Orcad attests the sender exactly as for git (orca-git-identity). With no
# attested teammate, or before the control plane turns this on (ORCA_GH_AS_MEMBER=on), gh runs as before:
# the workspace identity.
# Layout: the real gh is /opt/orca/tools/gh/bin/gh (off PATH); /opt/orca/tools/bin/gh, first on every agent
# PATH, is a link to this script. Symlinks are resolved so the link never finds itself.
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
real="${ORCA_REAL_GH:-}"
if [ -z "$real" ] && [ -x "${ORCA_HOME:-/opt/orca}/tools/gh/bin/gh" ]; then
  real="${ORCA_HOME:-/opt/orca}/tools/gh/bin/gh"
fi
if [ -z "$real" ]; then
  IFS=: read -r -a dirs <<<"${PATH:-/usr/bin:/bin}"
  for dir in "${dirs[@]}" /usr/local/bin /usr/bin; do
    if [ -x "$dir/gh" ] && [ "$(readlink -f "$dir/gh" 2>/dev/null || echo "$dir/gh")" != "$self" ]; then
      real="$dir/gh"
      break
    fi
  done
fi
[ -n "$real" ] || { echo 'gh: not installed in this sandbox' >&2; exit 127; }
if [ "${ORCA_GH_AS_MEMBER:-}" = on ] && [ -n "${ORCA_TERMINAL_HANDLE:-}${ORCA_AGENT_SESSION_ID:-}" ]; then
  file="$(sudo -n --preserve-env=ORCA_TERMINAL_HANDLE,ORCA_PANE_KEY,ORCA_AGENT_LAUNCH_TOKEN,ORCA_AGENT_SESSION_ID \
    /opt/orca/bin/orca-git-identity 2>/dev/null)" && [ -n "$file" ] && {
    token="$(git config -f "$file" orca.ghtoken 2>/dev/null || true)"
    rm -f "$file"
    case "$token" in
      orca-ph-* | orca-mph-*) exec env GH_TOKEN="$token" GITHUB_TOKEN="$token" "$real" "$@" ;;
    esac
  }
fi
exec "$real" "$@"
