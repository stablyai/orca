{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2024"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@types/node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@xterm/xterm": [
        "./types/xterm-theme.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "image"
  ]
}
