{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local `wrangler dev` only (with wrangler.jsonc: `pnpm dev`): the environment build runner Worker.
  // It hosts the EnvironmentBuildRunner Durable Object and nothing else; every build step runs in the
  // control plane over the CONTROL RPC binding. See src/build-runner.ts.
  "name": "orca-sandbox-build-runner-local",
  "main": "src/build-runner.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "services": [{ "binding": "CONTROL", "service": "orca-sandbox-control-local", "entrypoint": "BuildTicker" }],
  "migrations": [{ "tag": "env-build-runner-v1", "new_sqlite_classes": ["EnvironmentBuildRunner"] }]
}
