{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local `wrangler dev` only. It has no routes and workers.dev is off, so a
  // deploy without --env publishes nothing reachable.
  "name": "orca-relay-edge-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The cells' credential store is imported unchanged; resolve its workspace import to source.
  "alias": {
    "@orca-cloud/relay-contract": "../../packages/relay-contract/src/index.ts"
  },
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "HOST_RELAY", "class_name": "HostRelay" },
      { "name": "SPLICE_RELAY", "class_name": "SpliceRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["SpliceRelay"] }
  ],
  // Local dev/tests only: Postgres on 127.0.0.1:55432 (see test/mvp.ts). Deployed environments
  // bind a real Hyperdrive config instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://relay:local-test@127.0.0.1:55433/relay"
    }
  ],
  "vars": {
    "EDGE_CELL_ID": "edge",
    "RELAY_JWT_AUDIENCE": "orca-relay",
    "PING_INTERVAL_MS": "30000",
    "SILENCE_TIMEOUT_MS": "75000",
    "ORPHAN_GRACE_MS": "30000"
  },
  "env": {
    // Cloudflare de-risk spike: workers.dev only, no custom domains or routes, test keys only.
    // RELAY_JWKS (public test key) and SPIKE_RESUME_TOKEN_HASHES are set with `wrangler secret put`.
    "spike": {
      "name": "orca-relay-edge-spike",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          { "name": "HOST_RELAY", "class_name": "HostRelay" },
          { "name": "SPLICE_RELAY", "class_name": "SpliceRelay" }
        ],
        // Per-deploy override: --durable-objects-code-update-mode "deferred 120s"
        "code_update_strategy": { "mode": "deferred", "max_delay": 300 }
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "orca_relay_edge_spike" }],
      "vars": {
        // No database on the spike: stub credentials, no epoch check (load tests only).
        "EDGE_BACKEND": "spike",
        "RELAY_JWT_AUDIENCE": "orca-relay",
        "PING_INTERVAL_MS": "45000",
        "SILENCE_TIMEOUT_MS": "75000",
        "ORPHAN_GRACE_MS": "30000",
        "SPIKE_DEBUG": "1",
        "EDGE_VERSION": "v1"
      }
    }
  }
}
