{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["../config/**/*.ts", "../*.ts", "../src/types/**/*"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tooling.tsbuildinfo",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    },
    "types": ["electron-vite/node"]
  }
}
