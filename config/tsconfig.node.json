{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../electron.vite.config.*",
    "../build-plugins/**/*",
    "../src/main/**/*",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../src/relay/**/*",
    "../src/types/**/*",
    // Task 2's shared path-derivation module, consumed by the main-process
    // browser/host detection in src/main/chat-import (mirrors the reverse
    // whitelist in tsconfig.cli.json for src/main files the CLI needs).
    "../src/cli/chat-import-host/native-messaging-host-paths.ts",
    "../src/cli/chat-import-host/install-native-messaging-host.ts",
    "../src/cli/chat-import-host/native-messaging-manifest.ts",
    "../src/cli/chat-import-host/resolve-host-exec-command.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
