+function poly1305WasmBytes(createPoly1305) {
+  // The Emscripten factory embeds its WASM binary as a base64 data URI, so
+  // the factory's own source carries the payload wherever the module can be
+  // loaded from (plain node_modules, an Electron app.asar, or inlined into a
+  // single-file bundle where __dirname no longer points at this package).
+  let match = Function.prototype.toString.call(createPoly1305)
+    .match(POLY1305_PAYLOAD_RE);
+  if (!match) {
+    // Fallback when function source is unavailable (e.g. compiled bytecode).
+    try {
+      match = readFileSync(join(__dirname, 'crypto', 'poly1305.js'), 'utf8')
+        .match(POLY1305_PAYLOAD_RE);
+    } catch {}
+  }
+  if (!match)
+    throw new Error('Failed to locate poly1305 WASM payload');
+  return Buffer.from(match[1], 'base64');
