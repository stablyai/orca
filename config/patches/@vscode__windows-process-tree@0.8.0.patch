index 0000000..6c82221
--- /dev/null
+++ b/src/process_file_users.cc
@@ -0,0 +1,189 @@
+// Orca: which processes have a file or folder open.
+//
+// Windows refuses to rename or delete a folder while any process holds a
+// handle inside it, and a shell or agent whose working directory is there
+// names no path on its command line. The kernel keeps the answer per file:
+// FileProcessIdsUsingFileInformation, the query Restart Manager is built on.
+// It opens only the path itself -- no other process is opened or read.
+//
+// Each query walks the system's whole handle table in the kernel: ~50 ms per
+// path with 200k handles open, NTFS and ReFS alike. Callers keep the path list
+// short, and the paths are asked on a few threads of this one worker rather
+// than on several libuv workers the main process needs for its file I/O.
+
+#include "process_file_users.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <thread>
+#include <windows.h>
+#include <winternl.h>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+namespace {
+
+const ULONG kFileProcessIdsUsingFileInformation = 47;
+const NTSTATUS kStatusInfoLengthMismatch = static_cast<NTSTATUS>(0xC0000004L);
+// A list that outgrows this is not a holder list a dialog can show anyway.
+const size_t kMaxBufferBytes = 1 << 20;
+// Measured: 8 threads ask 51 folders in a third of the single-thread time; more contend in the kernel.
+const size_t kMaxThreads = 8;
+
+// FILE_INFORMATION_CLASS in winternl.h does not name class 47, so the class
+// travels as a ULONG rather than a cast enum.
+typedef NTSTATUS(NTAPI* NtQueryInformationFileFn)(HANDLE, PIO_STATUS_BLOCK, PVOID, ULONG, ULONG);
+
+// FILE_PROCESS_IDS_USING_FILE_INFORMATION from ntifs.h.
+struct FileProcessIdsUsingFile {
+  ULONG NumberOfProcessIdsInList;
+  ULONG_PTR ProcessIdList[1];
+};
+
+// ntdll ships no import library for this entry point; it has to be resolved.
+NtQueryInformationFileFn NtQueryInformationFileEntry() {
+  static const NtQueryInformationFileFn entry = []() -> NtQueryInformationFileFn {
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    return ntdll ? reinterpret_cast<NtQueryInformationFileFn>(
+                       GetProcAddress(ntdll, "NtQueryInformationFile"))
+                 : nullptr;
+  }();
+  return entry;
+}
+
+struct PathUsers {
+  bool ok = false;
+  std::vector<DWORD> pids;
+};
+
+PathUsers QueryPathUsers(const std::wstring& path) {
+  PathUsers result;
+  const NtQueryInformationFileFn query = NtQueryInformationFileEntry();
+  if (!query) {
+    return result;
+  }
+  // Attributes only, sharing everything: the probe must never be the holder
+  // that blocks the delete it is diagnosing. Backup semantics opens folders.
+  HANDLE file = CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES,
+                            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+                            OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return result;
+  }
+  std::vector<unsigned char> buffer(4096);
+  NTSTATUS status = kStatusInfoLengthMismatch;
+  IO_STATUS_BLOCK io{};
+  while (true) {
+    status = query(file, &io, buffer.data(), static_cast<ULONG>(buffer.size()),
+                   kFileProcessIdsUsingFileInformation);
+    if (status != kStatusInfoLengthMismatch || buffer.size() >= kMaxBufferBytes) {
+      break;
+    }
+    buffer.resize(buffer.size() * 4);
+  }
+  CloseHandle(file);
+  if (status < 0) {
+    return result;
+  }
+  const auto* info = reinterpret_cast<const FileProcessIdsUsingFile*>(buffer.data());
+  const size_t capacity =
+      (buffer.size() - offsetof(FileProcessIdsUsingFile, ProcessIdList)) / sizeof(ULONG_PTR);
+  const size_t count = info->NumberOfProcessIdsInList < capacity
+                           ? info->NumberOfProcessIdsInList
+                           : capacity;
+  result.pids.reserve(count);
+  for (size_t index = 0; index < count; index++) {
+    result.pids.push_back(static_cast<DWORD>(info->ProcessIdList[index]));
+  }
+  result.ok = true;
+  return result;
+}
+
+class PathUsersWorker : public Napi::AsyncWorker {
+ public:
+  PathUsersWorker(Napi::Env env, std::vector<std::wstring> paths)
+      : Napi::AsyncWorker(env),
+        paths_(std::move(paths)),
+        deferred_(Napi::Promise::Deferred::New(env)) {}
+
+  Napi::Promise Promise() const { return deferred_.Promise(); }
+
+ protected:
+  void Execute() override {
+    results_.resize(paths_.size());
+    std::atomic<size_t> next{0};
+    auto drain = [this, &next]() {
+      for (size_t index = next++; index < paths_.size(); index = next++) {
+        results_[index] = QueryPathUsers(paths_[index]);
+      }
+    };
+    const size_t cores = std::max<size_t>(1, std::thread::hardware_concurrency());
+    const size_t helpers = std::min({kMaxThreads, cores, paths_.size()});
+    std::vector<std::thread> threads;
+    for (size_t count = 1; count < helpers; count++) {
+      try {
+        threads.emplace_back(drain);
+      } catch (const std::system_error&) {
+        break;  // Fewer threads only make it slower.
+      }
+    }
+    drain();
+    for (std::thread& thread : threads) {
+      thread.join();
+    }
+  }
+
+  void OnOK() override {
+    Napi::Env env = Env();
+    Napi::Array out = Napi::Array::New(env, results_.size());
+    for (size_t index = 0; index < results_.size(); index++) {
+      const PathUsers& users = results_[index];
+      if (!users.ok) {
+        out.Set(static_cast<uint32_t>(index), env.Null());
+        continue;
+      }
+      Napi::Array pids = Napi::Array::New(env, users.pids.size());
+      for (size_t pid = 0; pid < users.pids.size(); pid++) {
+        pids.Set(static_cast<uint32_t>(pid), Napi::Number::New(env, users.pids[pid]));
+      }
+      out.Set(static_cast<uint32_t>(index), pids);
+    }
+    deferred_.Resolve(out);
+  }
+
+  void OnError(const Napi::Error& error) override { deferred_.Reject(error.Value()); }
+
+ private:
+  std::vector<std::wstring> paths_;
+  std::vector<PathUsers> results_;
+  Napi::Promise::Deferred deferred_;
+};
+
+}  // namespace
+
+// getProcessIdsUsingPaths(paths) -> Promise<(number[] | null)[]>, null where a
+// path could not be opened or queried.
+Napi::Value GetProcessIdsUsingPaths(const Napi::CallbackInfo& args) {
+  Napi::Env env(args.Env());
+  if (args.Length() != 1 || !args[0].IsArray()) {
+    throw Napi::TypeError::New(env, "getProcessIdsUsingPaths expects an array of paths.");
+  }
+  const Napi::Array input = args[0].As<Napi::Array>();
+  std::vector<std::wstring> paths;
+  paths.reserve(input.Length());
+  for (uint32_t index = 0; index < input.Length(); index++) {
+    const Napi::Value value = input.Get(index);
+    if (!value.IsString()) {
+      throw Napi::TypeError::New(env, "getProcessIdsUsingPaths expects an array of paths.");
+    }
+    const std::u16string text = value.As<Napi::String>().Utf16Value();
+    paths.emplace_back(text.begin(), text.end());
+  }
+  auto* worker = new PathUsersWorker(env, std::move(paths));
+  const Napi::Promise promise = worker->Promise();
+  worker->Queue();
+  return promise;
+}
