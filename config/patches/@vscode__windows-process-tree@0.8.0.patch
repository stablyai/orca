+Napi::Value ReadProcessCreationTime(const Napi::CallbackInfo& args) {
+  Napi::Env env(args.Env());
+  if (args.Length() != 1 || !args[0].IsNumber()) {
+    return env.Undefined();
+  }
+  const double pid = args[0].As<Napi::Number>().DoubleValue();
+  if (!(pid >= 1 && pid <= MAXDWORD) || pid != static_cast<DWORD>(pid)) {
+    return env.Undefined();
+  }
+  ProcessInfo pinfo{};
+  pinfo.pid = static_cast<DWORD>(pid);
+  GetProcessCreationTime(pinfo);
+  if (pinfo.creationTimeMs == 0) {
+    return env.Undefined();
+  }
+  return Napi::Number::New(env, static_cast<double>(pinfo.creationTimeMs));
+}
+
 Napi::Object Init(Napi::Env env, Napi::Object exports) {
+  exports.Set("getProcessCreationTime", Napi::Function::New(env, ReadProcessCreationTime));
   exports.Set("getProcessList", Napi::Function::New(env, GetProcessList));
   exports.Set("getProcessCpuUsage", Napi::Function::New(env, GetProcessCpuUsage));
+  // Lets a caller prove THIS BINARY understands CREATIONTIME. The JS enum is
+  // patched source and says nothing about what the .node was compiled from.
+  exports.Set("supportedProcessDataFlags",
+              Napi::Number::New(env, MEMORY | COMMANDLINE | CREATIONTIME));
   return exports;
 }
 
