om the preceding placeholder cell.\nexport interface IPlaceholderLocation {\n  row: number;\n  column: number;\n  highByte: number;\n}\n\nexport function decodePlaceholderLocation(chars: string): IPlaceholderLocation {\n  const location: IPlaceholderLocation = { row: 0, column: 0, highByte: 0 };\n  let index = 0;\n  for (const ch of chars) {\n    if (index === 1) {\n      location.row = PLACEHOLDER_DIACRITIC_VALUES.get(ch.codePointAt(0) ?? -1) ?? -1;\n    } else if (index === 2) {\n      location.column = PLACEHOLDER_DIACRITIC_VALUES.get(ch.codePointAt(0) ?? -1) ?? -1;\n    } else if (index === 3) {\n      location.highByte = PLACEHOLDER_DIACRITIC_VALUES.get(ch.codePointAt(0) ?? -1) ?? -1;\n    } else if (index > 3) {\n      break;\n    }\n    index++;\n  }\n  return location;\n}\n","/**\n * Copyright (c) 2026 The xterm.js authors. All rights reserved.\n * @license MIT\n */\n\nimport { IDisposable } from '@xterm/xterm';\nimport { ImageRenderer } from '../ImageRenderer';\nimport type { IImageSource } from '../ImageSource';\nimport { ImageStorage } from '../ImageStorage';\nimport { Attributes, IBufferLineExt, ImageLayer, IAddImageOpts, IImageDrawCall } from '../Types';\nimport { decodePlaceholderLocation, IKittyImageData, IPlaceholderLocation, IVirtualPlacement, PLACEHOLDER_CHAR } from './KittyGraphicsTypes';\nimport { captureKittyStorageCheckpoint, prepareKittyCheckpointImages, type KittyStorageCheckpoint } from './KittyStorageCheckpoint';\n\ninterface IPlaceholderCell {\n  imageId: number;\n  placementId: number;\n  location: IPlaceholderLocation;\n}\n\n// Kitty-specific image storage controller.\n//\n// Wraps shared ImageStorage with kitty protocol semantics:\n// - tracks transmitted image payloads by kitty image id\n// - tracks kitty image id -> shared ImageStorage id mapping for displayed images\n// - tracks virtual placements that U+10EEEE cells display\n// - mirrors shared-storage evictions into kitty maps\n// - applies protocol-level undisplayed-image eviction policy\nexport class KittyImageStorage implements IDisposable {\n  private static readonly _maxStoredImages = 256;\n\n  private _nextImageId = 1;\n  private _disposed = false;\n  private readonly _images: Map<number, IKittyImageData> = new Map();\n  // TODO: Track physical placements by (image id, placement id), like virtual placements.\n  private readonly _kittyIdToStorageId: Map<number, number> = new Map();\n  private readonly _storageIdToKittyId: Map<number, number> = new Map();\n  private readonly _virtualPlacements: Map<number, Map<number, IVirtualPlacement>> = new Map();\n  private readonly _virtualStorageIds = new Map<number, { kittyId: number, placementId: number }>();\n\n  private readonly _previousOnImageDeleted: ((storageId: number) => void) | undefined;\n  private readonly _wrappedOnImageDeleted: (storageId: number) => void;\n  private readonly _handleStorageImageDeleted = (storageId: number): void => {\n    const virtual = this._virtualStorageIds.get(storageId);\n    if (virtual) {\n      this._virtualStorageIds.delete(storageId);\n      const placements = this._virtualPlacements.get(virtual.kittyId);\n      placements?.delete(virtual.placementId);\n      if (!placements?.size) this._virtualPlacements.delete(virtual.kittyId);\n    }\n    const kittyId = this._storageIdToKittyId.get(storageId);\n    if (kittyId !== undefined) {\n      this._kittyIdToStorageId.delete(kittyId);\n      this._storageIdToKittyId.delete(storageId);\n    }\n  };\n  private _addImageOpts: IAddImageOpts = { scrolling: true, layer: 'top', zIndex: 0, cursorPos: 'iip' };\n\n  constructor(\n    private readonly _storage: ImageStorage,\n    private readonly _renderer: ImageRenderer\n  ) {\n    this._previousOnImageDeleted = this._storage.onImageDeleted;\n    this._wrappedOnImageDeleted = (storageId: number) => {\n      this._previousOnImageDeleted?.(storageId);\n      this._handleStorageImageDeleted(storageId);\n    };\n    this._storage.onImageDeleted = this._wrappedOnImageDeleted;\n    this._storage.onRenderLine = this._renderPlaceholderLine;\n    this._storage.onCollectVisibleImageIds = this._collectVisibleImageIds;\n  }\n\n  public reset(): void {\n    this._nextImageId = 1;\n    this._images.clear();\n    this._kittyIdToStorageId.clear();\n    this._storageIdToKittyId.clear();\n    this._virtualPlacements.clear();\n    this._virtualStorageIds.clear();\n  }\n\n  public captureCheckpoint(maxBytes: number): KittyStorageCheckpoint {\n    if (this._disposed) throw new Error('Kitty image storage is disposed');\n    return captureKittyStorageCheckpoint(this._images, this._kittyIdToStorageId, this._virtualPlacements, this._nextImageId, maxBytes);\n  }\n\n  public restoreCheckpoint(checkpoint: KittyStorageCheckpoint, maxPayloadBytes: number): void {\n    if (this._disposed) throw new Error('Kitty image storage is disposed');\n    const images = prepareKittyCheckpointImages(checkpoint, this._storage, maxPayloadBytes);\n    this.reset();\n    this._nextImageId = checkpoint.metadata.nextImageId;\n    for (const [id, image] of images) this._images.set(id, image);\n    for (const placement of checkpoint.metadata.physicalPlacements) {\n      this._kittyIdToStorageId.set(placement.kittyId, placement.storageId);\n      this._storageIdToKittyId.set(placement.storageId, placement.kittyId);\n    }\n    for (const placement of checkpoint.metadata.virtualPlacements) {\n      let placements = this._virtualPlacements.get(placement.kittyId);\n      if (!placements) {\n        placements = new Map();\n        this._virtualPlacements.set(placement.kittyId, placements);\n      }\n      placements.set(placement.placementId, {\n        placementId: placement.placementId, storageId: placement.storageId, cols: placement.cols, rows: placement.rows\n      });\n      this._virtualStorageIds.set(placement.storageId, { kittyId: placement.kittyId, placementId: placement.placementId });\n    }\n    this._renderer.refreshAll();\n  }\n\n  public dispose(): void {\n    this._disposed = true;\n    this.reset();\n    if (this._storage.onImageDeleted === this._wrappedOnImageDeleted) {\n      this._storage.onImageDeleted = this._previousOnImageDeleted;\n    }\n    if (this._storage.onRenderLine === this._renderPlaceholderLine) {\n      this._storage.onRenderLine = undefined;\n    }\n    if (this._storage.onCollectVisibleImageIds === this._collectVisibleImageIds) {\n      this._storage.onCollectVisibleImageIds = undefined;\n    }\n  }\n\n  public storeImage(id: number | undefined, imageData: Omit<IKittyImageData, 'id'>): number {\n    const imageId = id ?? this._nextImageId++;\n\n    this._deleteVirtualPlacements(imageId);\n    const oldStorageId = this._kittyIdToStorageId.get(imageId);\n    if (oldStorageId !== undefined) {\n      this._storage.deleteImage(oldStorageId);\n      this._kittyIdToStorageId.delete(imageId);\n      this._storageIdToKittyId.delete(oldStorageId);\n    }\n\n    const byteLimit = this._storage.getLimit() * 1000000;\n    this._images.delete(imageId);\n    let retainedBytes = 0;\n    for (const image of this._images.values()) retainedBytes += image.data.byteLength;\n    const needsEviction = (): boolean => retainedBytes + imageData.data.byteLength > byteLimit\n      || this._images.size >= KittyImageStorage._maxStoredImages;\n    // Source eviction must not free a bitmap still owned by a decoded placement.\n    const visible = needsEviction() ? this._visibleKittyIds() : new Set<number>();\n    for (const rank of [0, 1, 2]) {\n      for (const [oldestId, image] of this._images) {\n        if (!needsEviction()) break;\n        const imageRank = visible.has(oldestId) ? 2\n          : this._kittyIdToStorageId.has(oldestId) || this._virtualPlacements.has(oldestId) ? 1 : 0;\n        if (imageRank !== rank) continue;\n        retainedBytes -= image.data.byteLength;\n        this._images.delete(oldestId);\n      }\n    }\n\n    this._images.set(imageId, {\n      ...imageData,\n      data: new Uint8Array(imageData.data),\n      id: imageId\n    });\n    return imageId;\n  }\n\n  public addImage(kittyId: number, image: IImageSource, scrolling: boolean, layer: ImageLayer, zIndex: number): void {\n    // Clean up stale reverse-mapping from a previous placement of the same\n    // kitty image.  The old shared-storage entry is kept (it may still be\n    // visible on screen) but its reverse mapping is removed so that eviction\n    // of the old entry won't incorrectly delete the kitty image data.\n    const oldStorageId = this._kittyIdToStorageId.get(kittyId);\n    if (oldStorageId !== undefined) {\n      this._storageIdToKittyId.delete(oldStorageId);\n    }\n    this._addImageOpts.scrolling = scrolling;\n    this._addImageOpts.layer = layer;\n    this._addImageOpts.zIndex = zIndex;\n    this._addImageOpts.kittyId = kittyId;\n    const storageId = this._storage.addImage(image, this._addImageOpts);\n    this._kittyIdToStorageId.set(kittyId, storageId);\n    this._storageIdToKittyId.set(storageId, kittyId);\n  }\n\n  public getImage(kittyId: number): IKittyImageData | undefined {\n    return this._images.get(kittyId);\n  }\n\n  // Fit prototypes at render time so each placement holds only the source pixels.\n  public addVirtualPlacement(kittyId: number, placementId: number, image: IImageSource, cols: number, rows: number): void {\n    const previous = this._virtualPlacements.get(kittyId)?.get(placementId);\n    if (previous) this._storage.deleteImage(previous.storageId);\n    const storageId = this._storage.addUnplacedImage(image, { scrolling: false, layer: 'top', zIndex: 0, kittyId, cursorPos: 'iip' });\n    let placements = this._virtualPlacements.get(kittyId);\n    if (!placements) {\n      placements = new Map();\n      this._virtualPlacements.set(kittyId, placements);\n    }\n    placements.set(placementId, { placementId, storageId, cols, rows });\n    this._virtualStorageIds.set(storageId, { kittyId, placementId });\n    this._renderer.refreshAll();\n  }\n\n  private _virtualPlacementFor(kittyI