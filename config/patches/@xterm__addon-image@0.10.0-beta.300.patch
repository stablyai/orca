 size?.height, premultiplyAlpha: 'premultiply' });\n  }\n\n  public crop(source: IImageSource, x: number, y: number, width: number, height: number): ImageOperation<IImageSource> {\n    this._checkSize(width, height);\n    if (this._backend) return this._checkedRaster(this._backend.crop(rasterSource(source), x, y, width, height));\n    if (typeof createImageBitmap !== 'function') return this._canvasTransform(width, height, ctx => ctx.drawImage(browserSource(source), x, y, width, height, 0, 0, width, height));\n    return createImageBitmap(browserSource(source), x, y, width, height, { premultiplyAlpha: 'premultiply' });\n  }\n\n  public resize(source: IImageSource, width: number, height: number): ImageOperation<IImageSource> {\n    this._checkSize(width, height);\n    if (width === source.width && height === source.height) return source;\n    if (this._backend) return this._checkedRaster(this._backend.resize(rasterSource(source), width, height));\n    if (typeof createImageBitmap !== 'function') return this._canvasTransform(width, height, ctx => ctx.drawImage(browserSource(source), 0, 0, width, height));\n    return createImageBitmap(browserSource(source), { resizeWidth: width, resizeHeight: height, premultiplyAlpha: 'premultiply' });\n  }\n\n  private _canvasTransform(width: number, height: number, draw: (context: CanvasRenderingContext2D) => void): HTMLCanvasElement {\n    const canvas = createImageCanvas(undefined, width, height);\n    try {\n      const context = canvas.getContext('2d');\n      if (!context) throw new Error('Failed to create image canvas context');\n      draw(context);\n      return canvas;\n    } catch (error) {\n      canvas.width = canvas.height = 0;\n      throw error;\n    }\n  }\n\n  public offset(source: IImageSource, x: number, y: number, width: number, height: number): ImageOperation<IImageSource> {\n    this._checkSize(width, height);\n    if (this._backend) return this._checkedRaster(this._backend.offset(rasterSource(source), x, y, width, height));\n    const canvas = createImageCanvas(undefined, width, height);\n    const context = canvas.getContext('2d');\n    if (!context) throw new Error('Failed to create offset canvas context');\n    context.drawImage(browserSource(source), x, y);\n    if (typeof createImageBitmap !== 'function') return canvas;\n    return createImageBitmap(canvas, { premultiplyAlpha: 'premultiply' }).then(\n      result => { canvas.width = canvas.height = 0; return result; },\n      error => { canvas.width = canvas.height = 0; throw error; }\n    );\n  }\n}\n","/**\n * Copyright (c) 2020 The xterm.js authors. All rights reserved.\n * @license MIT\n */\n\nimport { IDisposable } from '@xterm/xterm';\nimport { ImageRenderer } from './ImageRenderer';\nimport { closeImageSource, isImageRaster, type IImageSource } from './ImageSource';\nimport { captureImageStorageCheckpoint } from './ImageStorageCheckpointCapture';\nimport type { ImageStorageCheckpoint } from './ImageStorageCheckpoint';\nimport { checkImageCheckpointGeometry, prepareImageCheckpointSources, visitImageCheckpointCells } from './ImageStorageCheckpointRestore';\nimport {\n  ITerminalExt, IExtendedAttrsImage, IImageAddonOptions, IImageSpec,\n  IBufferLineExt, BgFlags, Cell, Content, ICellSize, ExtFlags, Attributes,\n  UnderlineStyle, IAddImageOpts, IImageDrawCall\n} from './Types';\n\n\n// fallback default cell size\nexport const CELL_SIZE_DEFAULT: ICellSize = {\n  width: 7,\n  height: 14\n};\n\n/**\n * Extend extended attribute to also hold image tile information.\n *\n * Object definition is copied from base repo to fully mimick its behavior.\n * Image data is added as additional public properties `imageId` and `tileId`.\n */\nclass ExtendedAttrsImage implements IExtendedAttrsImage {\n  private _ext: number = 0;\n  public get ext(): number {\n    if (this._urlId) {\n      return (\n        (this._ext & ~ExtFlags.UNDERLINE_STYLE) |\n        (this.underlineStyle << 26)\n      );\n    }\n    return this._ext;\n  }\n  public set ext(value: number) { this._ext = value; }\n\n  public get underlineStyle(): UnderlineStyle {\n    // Always return the URL style if it has one\n    if (this._urlId) {\n      return UnderlineStyle.DASHED;\n    }\n    return (this._ext & ExtFlags.UNDERLINE_STYLE) >> 26;\n  }\n  public set underlineStyle(value: UnderlineStyle) {\n    this._ext &= ~ExtFlags.UNDERLINE_STYLE;\n    this._ext |= (value << 26) & ExtFlags.UNDERLINE_STYLE;\n  }\n\n  public get underlineColor(): number {\n    return this._ext & (Attributes.CM_MASK | Attributes.RGB_MASK);\n  }\n  public set underlineColor(value: number) {\n    this._ext &= ~(Attributes.CM_MASK | Attributes.RGB_MASK);\n    this._ext |= (value === -1 ? 0 : value) & (Attributes.CM_MASK | Attributes.RGB_MASK);\n  }\n\n  public get underlineVariantOffset(): number {\n    const val = (this._ext & ExtFlags.VARIANT_OFFSET) >> 29;\n    if (val < 0) {\n      return val ^ 0xFFFFFFF8;\n    }\n    return val;\n  }\n  public set underlineVariantOffset(value: number) {\n    this._ext &= ~ExtFlags.VARIANT_OFFSET;\n    this._ext |= (value << 29) & ExtFlags.VARIANT_OFFSET;\n  }\n\n  private _urlId: number = 0;\n  public get urlId(): number {\n    return this._urlId;\n  }\n  public set urlId(value: number) {\n    this._urlId = value;\n  }\n\n  constructor(\n    ext: number = 0,\n    urlId: number = 0,\n    public imageId = -1,\n    public tileId = -1\n  ) {\n    this._ext = ext;\n    this._urlId = urlId;\n  }\n\n  public clone(): IExtendedAttrsImage {\n    /**\n     * Technically we dont need a clone variant of ExtendedAttrsImage,\n     * as we never clone a cell holding image data.\n     * Note: Clone is only meant to be used by the InputHandler for\n     * sticky attributes, which is never the case for image data.\n     * We still provide a proper clone method to reflect the full ext attr\n     * state in case there are future use cases for clone.\n     */\n    return new ExtendedAttrsImage(this._ext, this._urlId, this.imageId, this.tileId);\n  }\n\n  public isEmpty(): boolean {\n    return this.underlineStyle === UnderlineStyle.NONE && this._urlId === 0 && this.imageId === -1\n      && (this.underlineColor & Attributes.CM_MASK) === 0;\n  }\n}\nconst EMPTY_ATTRS = new ExtendedAttrsImage();\n\n\n/**\n * ImageStorage - extension of CoreTerminal:\n * - hold image data\n * - write/read image data to/from buffer\n *\n * TODO: image composition for overwrites\n */\nexport class ImageStorage implements IDisposable {\n  private static readonly _maxImages = 4096;\n  // storage\n  private _images: Map<number, IImageSpec> = new Map();\n  // last used id\n  private _lastId = 0;\n  private _checkpointGeneration = 0;\n  private _disposed = false;\n  // whether a full clear happened before\n  private _fullyCleared = false;\n  // whether render should do a full clear\n  private _needsFullClear = false;\n  // hard limit of stored pixels (fallback limit of 10 MB)\n  private _pixelLimit: number = 2500000;\n\n  private _viewportMetrics: { cols: number, rows: number };\n  public onImageAdded: (() => void) | undefined;\n  public onImageDeleted: ((storageId: number) => void) | undefined;\n  // Placeholder cells carry image references in text and colors, not tile attributes.\n  public onRenderLine: ((line: IBufferLineExt, row: number, cols: number, draws: IImageDrawCall[]) => void) | undefined;\n  public onCollectVisibleImageIds: ((line: IBufferLineExt, cols: number, ids: Set<number>) => void) | undefined;\n\n  constructor(\n    private _terminal: ITerminalExt,\n    private _renderer: ImageRenderer,\n    private _opts: IImageAddonOptions\n  ) {\n    try {\n      this.setLimit(this._opts.storageLimit);\n    } catch (e: unknown) {\n      if (e instanceof Error) {\n        console.error(e.message);\n      }\n      console.warn(`storageLimit is set to ${this.getLimit()} MB`);\n    }\n    this._viewportMetrics = {\n      cols: this._terminal.cols,\n      rows: this._terminal.rows\n    };\n  }\n\n  public dispose(): void {\n    this._disposed = true;\n    this.reset();\n  }\n\n  public reset(): void {\n    ++this._checkpointGeneration;\n    for (const id of [...this._images.keys()]) {\n      this.deleteImage(id);\n    }\n    this._renderer.clearAll();\n  }\n\n  public captureCheckpoint(maxBytes: number): ImageStorageCheckpoint {\n    if (this._disposed) throw new Error('Image storage is disposed');\n    return captureImageStorageCheckpoint(this._terminal, this._images, this._lastId, maxBytes);\n  }\n\n  // The snapshot owner must hold terminal output until this preparation finishes.\n  public async restoreCheckpoint(checkpoint: ImageStorageCheckpoint): Promise<void> {\n    if (this._disposed) throw new Error('Image storage is disposed');\n    checkImageCheckpointGeometry(this._terminal, checkpoint);\n    const generation = ++this._checkpointGeneration;\n    const sources = await prepareImageCheckpointSources(checkpoint, this._opts);\n    let committed = false;\n    try {\n      checkImageCheckpointGeometry(this._terminal, checkpoint);\n      if (this._disposed || generation !== this._checkpointGeneration) throw new Error('Image storage changed during restoration');\n      // Old marker callbacks must finish before IDs are reused by the new entries.\n      this.reset();\n      const { normal, alt } = this._terminal._core.buffers;\n      for (const buffer of [normal, alt]) {\n        const cell = buffer.getNullCell();\n        for (let row = 0; row < buffer.lines.length; ++row) {\n          const line = buffer.lines.get(row);\n          if (!line) continue;\n          for (let col = 0; col < line.length; ++col) {\n            if (!(line.getBg(col) & BgFlags.HAS_EXTENDED)) continue;\n            line.loadCell(col, cell);\n            if (!('imageId' in cell.extended)) continue;\n            cell.extended = new ExtendedAttrsImage(cell.extended.ext, cell.extended.urlId);\n            line.setCell(col, cell);\n          }\n        }\n      }\n      for (const image of checkpoint.metadata.imag