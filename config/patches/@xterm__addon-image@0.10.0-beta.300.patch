*/\n  public get dimensions(): IRenderDimensions | undefined {\n    return this._terminal.dimensions;\n  }\n\n  /**\n   * Current cell size (float).\n   */\n  public get cellSize(): ICellSize {\n    const size = this._rasterBackend?.getCellSize?.();\n    if (size && Number.isFinite(size.width) && Number.isFinite(size.height) && size.width > 0 && size.height > 0) return { width: size.width, height: size.height };\n    return {\n      width: this.dimensions?.css.cell.width || -1,\n      height: this.dimensions?.css.cell.height || -1\n    };\n  }\n\n  public refreshAll(): void {\n    this._renderService?.refreshRows(0, this._terminal.rows - 1);\n  }\n\n  /**\n   * Clear a region of the image layer canvas.\n   */\n  public clearLines(start: number, end: number, layer?: ImageLayer): void {\n    const y = start * (this.dimensions?.css.cell.height || 0);\n    const w = this.dimensions?.css.canvas.width || 0;\n    const h = (end + 1 - start) * (this.dimensions?.css.cell.height || 0);\n    if (!layer || layer === 'top') {\n      this._layers.get('top')?.clearRect(0, y, w, h);\n    }\n    if (!layer || layer === 'bottom') {\n      this._layers.get('bottom')?.clearRect(0, y, w, h);\n      this._layers.get('bottom-background')?.clearRect(0, y, w, h);\n    }\n  }\n\n  /**\n   * Clear whole image canvas.\n   */\n  public clearAll(layer?: ImageLayer): void {\n    if (!layer || layer === 'top') {\n      const ctx = this._layers.get('top');\n      ctx?.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n    }\n    if (!layer || layer === 'bottom') {\n      const ctx = this._layers.get('bottom');\n      ctx?.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n      const background = this._layers.get('bottom-background');\n      background?.clearRect(0, 0, background.canvas.width, background.canvas.height);\n    }\n  }\n\n  /**\n   * Draw neighboring tiles on the image layer canvas.\n   */\n  public draw(imgSpec: IImageSpec, tileId: number, col: number, row: number, count: number = 1): void {\n    const layer = imgSpec.layer === 'bottom' && imgSpec.zIndex < -1073741824 ? 'bottom-background' : imgSpec.layer;\n    const ctx = this._layers.get(layer);\n    if (!ctx && !(this._collecting && imgSpec.layer === 'bottom')) {\n      return;\n    }\n    const { width, height } = this.cellSize;\n\n    // Don't try to draw anything, if we cannot get valid renderer metrics.\n    if (width === -1 || height === -1) {\n      return;\n    }\n\n    this._rescaleImage(imgSpec, width, height);\n    const img = imgSpec.actual!;\n    if (isImageRaster(img)) return;\n    const { width: sourceWidth, height: sourceHeight } = imgSpec.actualCellSize;\n    const cols = Math.ceil(img.width / sourceWidth);\n\n    const sx = (tileId % cols) * sourceWidth;\n    const sy = Math.floor(tileId / cols) * sourceHeight;\n    const dx = col * width;\n    const dy = row * height;\n\n    // safari bug: never access image source out of bounds\n    const finalWidth = count * sourceWidth + sx > img.width ? img.width - sx : count * sourceWidth;\n    const finalHeight = sy + sourceHeight > img.height ? img.height - sy : sourceHeight;\n\n    // Floor all pixel offsets to get stable tile mapping without any overflows.\n    // Note: For not pixel perfect aligned cells like in the DOM renderer\n    // this will move a tile slightly to the top/left (subpixel range, thus ignore it).\n    // FIX #34: avoid striping on displays with pixelDeviceRatio != 1 by ceiling height and width\n    this._draw(imgSpec, ctx, img,\n      Math.floor(sx), Math.floor(sy), Math.ceil(finalWidth), Math.ceil(finalHeight),\n      Math.floor(dx), Math.floor(dy), Math.ceil(finalWidth * width / sourceWidth), Math.ceil(finalHeight * height / sourceHeight)\n    );\n  }\n\n  // Fit the original source into the cell grid without distorting its aspect ratio.\n  public drawCellImage(imgSpec: IImageSpec, boxCols: number, boxRows: number, gridRow: number, gridCol: number, count: number, col: number, row: number): void {\n    const layer = imgSpec.layer === 'bottom' && imgSpec.zIndex < -1073741824 ? 'bottom-background' : imgSpec.layer;\n    const ctx = this._layers.get(layer);\n    if (!ctx && !(this._collecting && imgSpec.layer === 'bottom')) {\n      return;\n    }\n    const { width, height } = this.cellSize;\n    // Don't try to draw anything, if we cannot get valid renderer metrics.\n    if (width === -1 || height === -1) {\n      return;\n    }\n    const img = imgSpec.orig;\n    if (!img) {\n      return;\n    }\n\n    const boxWidth = boxCols * width;\n    const boxHeight = boxRows * height;\n    let xScale: number;\n    let yScale: number;\n    let xOffset: number;\n    let yOffset: number;\n    if (img.width * boxHeight > img.height * boxWidth) {\n      // Wider than the box: fit to width and center vertically.\n      xScale = boxWidth / Math.max(1, img.width);\n      yScale = xScale;\n      xOffset = 0;\n      yOffset = (boxHeight - img.height * yScale) / 2;\n    } else {\n      // Taller than the box: fit to height and center horizontally.\n      yScale = boxHeight / Math.max(1, img.height);\n      xScale = yScale;\n      xOffset = (boxWidth - img.width * xScale) / 2;\n      yOffset = 0;\n    }\n\n    // Clip source and destination together so edge tiles are not stretched.\n    let dx = col * width;\n    let dy = row * height;\n    let dw = count * width;\n    let dh = height;\n    let sx = (gridCol * width - xOffset) / xScale;\n    let sy = (gridRow * height - yOffset) / yScale;\n    let sw = dw / xScale;\n    let sh = dh / yScale;\n    if (sx < 0) {\n      const clipped = -sx * xScale;\n      dx += clipped;\n      dw -= clipped;\n      sw += sx;\n      sx = 0;\n    }\n    if (sy < 0) {\n      const clipped = -sy * yScale;\n      dy += clipped;\n      dh -= clipped;\n      sh += sy;\n      sy = 0;\n    }\n    if (sx + sw > img.width) {\n      sw = img.width - sx;\n      dw = sw * xScale;\n    }\n    if (sy + sh > img.height) {\n      sh = img.height - sy;\n      dh = sh * yScale;\n    }\n    if (sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) {\n      return;\n    }\n    this._draw(imgSpec, ctx, img, sx, sy, sw, sh, dx, dy, dw, dh);\n  }\n\n  /**\n   * Extract a single tile from an image.\n   */\n  public extractTile(imgSpec: IImageSpec, tileId: number): HTMLCanvasElement | undefined {\n    const { width, height } = this.cellSize;\n    // Don't try to draw anything, if we cannot get valid renderer metrics.\n    if (width === -1 || height === -1) {\n      return;\n    }\n    this._rescaleImage(imgSpec, width, height);\n    const img = imgSpec.actual!;\n    if (isImageRaster(img)) return;\n    const { width: sourceWidth, height: sourceHeight } = imgSpec.actualCellSize;\n    const cols = Math.ceil(img.width / sourceWidth);\n    const sx = (tileId % cols) * sourceWidth;\n    const sy = Math.floor(tileId / cols) * sourceHeight;\n    const finalWidth = sourceWidth + sx > img.width ? img.width - sx : sourceWidth;\n    const finalHeight = sy + sourceHeight > img.height ? img.height - sy : sourceHeight;\n\n    const canvas = ImageRenderer.createCanvas(this.document, Math.ceil(finalWidth * width / sourceWidth), Math.ceil(finalHeight * height / sourceHeight));\n    const ctx = canvas.getContext('2d');\n    if (ctx) {\n      ctx.drawImage(\n        img,\n        Math.floor(sx), Math.floor(sy), Math.floor(finalWidth), Math.floor(finalHeight),\n        0, 0, canvas.width, canvas.height\n      );\n      return canvas;\n    }\n  }\n\n  /**\n   * Draw a line with placeholder on the image layer canvas.\n   */\n  public drawPlaceholder(col: number, row: number, count: number = 1): void {\n    const ctx = this._layers.get('top');\n    if (ctx) {\n      const { width, height } = this.cellSize;\n\n      // Don't try to draw anything, if we cannot get valid renderer metrics.\n      if (width === -1 || height === -1) {\n        return;\n      }\n\n      if (!this._placeholder) {\n        this._createPlaceHolder(Math.max(height + 1, Constants.PLACEHOLDER_HEIGHT));\n      } else if (height >= this._placeholder!.height) {\n        this._createPlaceHolder(height + 1);\n      }\n      if (!this._placeholder) return;\n      ctx.drawImage(\n        this._placeholderBitmap ?? this._placeholder!,\n        col * width,\n        (row * height) % 2 ? 0 : 1,  // needs %2 offset correction\n        width * count,\n        height,\n        col * width,\n        row * height,\n        width * count,\n        height\n      );\n    }\n  }\n\n  /**\n   * Rescale image layer canvas if needed.\n   * Checked once from `ImageStorage.render`.\n   */\n  public rescaleCanvas(): void {\n    const w = this.dimensions?.css.canvas.width || 0;\n    const h = this.dimensions?.css.canvas.height || 0;\n    for (const ctx of this._layers.values()) {\n      if (ctx.canvas.width !== w || ctx.canvas.height !== h) {\n        ctx.canvas.width = w;\n        ctx.canvas.height = h;\n      }\n    }\n  }\n\n  /**\n   * Rescale image in storage if needed.\n   */\n  private _rescaleImage(spec: IImageSpec, currentWidth: number, currentHeight: number): void {\n    if (!spec.orig || isImageRaster(spec.orig)) return;\n    if (currentWidth === spec.actualCellSize.width && currentHeight === spec.actualCellSize.height) {\n      return;\n    }\n    const { width: originalWidth, height: originalHeight } = spec.origCellSize;\n    if (currentWidth === originalWidth && currentHeight === originalHeight) {\n      spec.actual = spec.orig;\n      spec.actualCellSize.width = originalWidth;\n      spec.actualCellSize.height = originalHeight;\n      return;\n    }\n    const scaledWidth = Math.ceil(spec.orig!.width * currentWidth / originalWidth);\n    const scaledHeight = Math.ceil(spec.orig!.height * currentHeight / originalHeight);\n    // Upscale visible tiles directly; a full zoomed copy can dwarf the image budget.\n    if (scaledWidth * scaledHeight > spec.orig!.width * spec.orig!.height) {\n      spec.actual = spec.orig;\n      spec.actualCellSize.width = originalWidth;\n      spec.a