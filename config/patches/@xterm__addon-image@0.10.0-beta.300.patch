ge data (current behavior)\n    // When implementing, also update _handleQuery to accept these transmission mediums.\n    const transmission = cmd.transmission ?? 'd';\n    if (transmission !== 'd') {\n      if (cmd.id !== undefined) {\n        this._sendResponse(cmd.id, 'EINVAL:unsupported transmission medium', cmd.quiet ?? 0);\n      }\n      return true;\n    }\n\n    if (decodeError || bytes.length === 0) return true;\n\n    this._kittyStorage.storeImage(cmd.id, {\n      data: bytes,\n      width: cmd.width ?? 0,\n      height: cmd.height ?? 0,\n      format: (cmd.format ?? KittyFormat.RGBA) as 24 | 32 | 100,\n      compression: cmd.compression ?? ''\n    });\n    return true;\n  }\n\n  private _handleTransmitDisplay(cmd: IKittyCommand, bytes: Uint8Array, decodeError: boolean): boolean | Promise<boolean> {\n    if (decodeError) {\n      if (cmd.id !== undefined) {\n        this._sendResponse(cmd.id, 'EINVAL:invalid base64 data', cmd.quiet ?? 0);\n      }\n      return true;\n    }\n\n    this._handleTransmit(cmd, bytes, decodeError);\n\n    const id = cmd.id ?? this._kittyStorage.lastImageId;\n    const image = this._kittyStorage.getImage(id);\n    if (image) {\n      const result = cmd.unicodePlaceholder === 1\n        ? this._placeVirtual(image, cmd)\n        : this._displayImage(image, cmd);\n      if (cmd.id !== undefined) {\n        return mapImageOperation(result, success => {\n          this._sendResponse(id, success ? 'OK' : 'EINVAL:image rendering failed', cmd.quiet ?? 0);\n          return true;\n        });\n      }\n      return mapImageOperation(result, () => true);\n    }\n    return true;\n  }\n\n  private _handleQuery(cmd: IKittyCommand, bytes: Uint8Array, decodeError: boolean): boolean {\n    const id = cmd.id ?? 0;\n    const quiet = cmd.quiet ?? 0;\n\n    // Per spec: reject unsupported transmission mediums (only t=d is supported atm)\n    // TODO: When filesystem support is added (Node.js/Electron), update this to accept\n    // t=f (file), t=t (temp file), and t=s (shared memory) and respond OK for queries.\n    const transmission = cmd.transmission ?? 'd';\n    if (transmission !== 'd') {\n      this._sendResponse(id, 'EINVAL:unsupported transmission medium', quiet);\n      return true;\n    }\n\n    // Check decode error first (invalid base64)\n    if (decodeError) {\n      this._sendResponse(id, 'EINVAL:invalid base64 data', quiet);\n      return true;\n    }\n\n    // Capability query (no payload) - just respond OK\n    if (bytes.length === 0) {\n      this._sendResponse(id, 'OK', quiet);\n      return true;\n    }\n\n    const format = cmd.format ?? KittyFormat.RGBA;\n\n    if (format === KittyFormat.PNG) {\n      this._sendResponse(id, 'OK', quiet);\n    } else {\n      const width = cmd.width ?? 0;\n      const height = cmd.height ?? 0;\n\n      if (!width || !height) {\n        this._sendResponse(id, 'EINVAL:width and height required for raw pixel data', quiet);\n        return true;\n      }\n\n      const bytesPerPixel = format === KittyFormat.RGBA ? KittyPixelConstants.BYTES_PER_PIXEL_RGBA : KittyPixelConstants.BYTES_PER_PIXEL_RGB;\n      const expectedBytes = width * height * bytesPerPixel;\n\n      if (bytes.length < expectedBytes) {\n        this._sendResponse(id, `EINVAL:insufficient pixel data`, quiet);\n        return true;\n      }\n\n      this._sendResponse(id, 'OK', quiet);\n    }\n    return true;\n  }\n\n  private _handleDelete(cmd: IKittyCommand): boolean {\n    // Per spec: default delete selector is 'a' (delete all visible placements)\n    const selector = cmd.deleteSelector ?? 'a';\n\n    switch (selector) {\n      case 'a':\n        this._kittyStorage.deletePhysicalPlacements();\n        break;\n      case 'A':\n        this._cleanupAllPending();\n        this._kittyStorage.deleteAll(true);\n        break;\n      case 'i':\n      case 'I':\n        if (cmd.id !== undefined) {\n          if (selector === 'I') {\n            const pending = this._pendingTransmissions.get(cmd.id);\n            pending?.decoder.release();\n            this._removePendingEntry(cmd.id);\n            this._kittyStorage.deleteById(cmd.id, cmd.placementId);\n          } else {\n            this._kittyStorage.deletePlacementsById(cmd.id, cmd.placementId);\n          }\n        }\n        break;\n      default:\n        // Unsupported selectors (c, n, p, q, r, x, y, z, f) — ignore for now\n        break;\n    }\n    return true;\n  }\n\n  private _sendResponse(id: number, message: string, quiet: number, placementId?: number): void {\n    const isOk = message === 'OK';\n    if (isOk && quiet >= 1) return;\n    if (!isOk && quiet >= 2) return;\n\n    const pPart = placementId ? `,p=${placementId}` : '';\n    const response = `\\x1b_Gi=${id}${pPart};${message}\\x1b\\\\`;\n    this._coreTerminal._core.coreService.triggerDataEvent(response);\n  }\n\n  // Image display\n\n  private _displayImage(image: IKittyImageData, cmd: IKittyCommand): ImageOperation<boolean> {\n    return this._renderPlacement(image, cmd, false);\n  }\n\n  private _renderPlacement(image: IKittyImageData, cmd: IKittyCommand, virtual: boolean): ImageOperation<boolean> {\n    const generation = this._generation;\n    const owner = new ImageSourceOwner();\n    const failed = (): boolean => { owner.dispose(); return false; };\n    const checkGeneration = (): void => {\n      if (generation !== this._generation) throw new Error('image decode canceled');\n    };\n    try {\n      const result = mapImageOperation(this._createBitmap(image), source => {\n        owner.replace(source);\n        checkGeneration();\n        return mapImageOperation(this._cropImage(source, cmd), cropped => {\n          owner.replace(cropped);\n          checkGeneration();\n          if (!virtual) return this._placePhysical(owner, cmd, image.id, checkGeneration);\n          const { width: cw, height: ch } = this._cellSize();\n          const { cols, rows } = this._placementGrid(owner.value, cmd, cw, ch);\n          this._kittyStorage.addVirtualPlacement(image.id, cmd.placementId ?? 0, owner.value, cols, rows);\n          owner.transfer();\n          return true;\n        });\n      });\n      return result instanceof Promise ? result.catch(failed) : result;\n    } catch {\n      return failed();\n    }\n  }\n\n  private _cellSize(): { width: number; height: number } {\n    const size = this._renderer.cellSize;\n    return size.width > 0 && size.height > 0 ? size : CELL_SIZE_DEFAULT;\n  }\n\n  private _placePhysical(owner: ImageSourceOwner, cmd: IKittyCommand, imageId: number, checkGeneration: () => void): ImageOperation<boolean> {\n    const { width: cw, height: ch } = this._cellSize();\n    let { cols: imgCols, rows: imgRows } = this._placementGrid(owner.value, cmd, cw, ch);\n    const w = cmd.columns !== undefined || cmd.rows !== undefined ? Math.round(imgCols * cw) : owner.value.width;\n    const h = cmd.columns !== undefined || cmd.rows !== undefined ? Math.round(imgRows * ch) : owner.value.height;\n    const buffer = this._coreTerminal._core.buffer;\n    const savedX = buffer.x;\n    const savedY = buffer.y;\n    const savedYbase = buffer.ybase;\n    const commit = (): boolean => {\n      checkGeneration();\n      const zIndex = cmd.zIndex ?? 0;\n      const layer: ImageLayer = zIndex < 0 ? 'bottom' : 'top';\n      this._kittyStorage.addImage(imageId, owner.value, true, layer, zIndex);\n      owner.transfer();\n      if (cmd.cursorMovement === 1) {\n        const scrolled = buffer.ybase - savedYbase;\n        buffer.x = savedX;\n        buffer.y = Math.max(savedY - scrolled, 0);\n      } else {\n        buffer.x = Math.min(savedX + imgCols, this._coreTerminal.cols);\n      }\n      return true;\n    };\n    return mapImageOperation(this._sources.resize(owner.value, w, h), scaled => {\n      owner.replace(scaled);\n      checkGeneration();\n      const xOffset = Math.min(Math.max(0, cmd.xOffset ?? 0), cw - 1);\n      const yOffset = Math.min(Math.max(0, cmd.yOffset ?? 0), ch - 1);\n      if (xOffset === 0 && yOffset === 0) return commit();\n      const canvasW = cmd.columns !== undefined ? Math.round(imgCols * cw) : Math.floor(owner.value.width + xOffset);\n      const canvasH = cmd.rows !== undefined ? Math.round(imgRows * ch) : Math.floor(owner.value.height + yOffset);\n      return mapImageOperation(this._sources.offset(owner.value, xOffset, yOffset, canvasW, canvasH), padded => {\n        owner.replace(padded);\n        if (cmd.columns === undefined) imgCols = Math.ceil(padded.width / cw);\n        if (cmd.rows === undefined) imgRows = Math.ceil(padded.height / ch);\n        return commit();\n      });\n    });\n  }\n\n  // Keep the uncropped path synchronous to preserve its parser scheduling.\n  private _cropImage(bitmap: IImageSource, cmd: IKittyCommand): ImageOperation<IImageSource> {\n    const cropX = Math.max(0, cmd.x ?? 0);\n    const cropY = Math.max(0, cmd.y ?? 0);\n    const cropW = cmd.sourceWidth || (bitmap.width - cropX);\n    const cropH = cmd.sourceHeight || (bitmap.height - cropY);\n\n    const maxCropW = Math.max(0, bitmap.width - cropX);\n    const maxCropH = Math.max(0, bitmap.height - cropY);\n    const finalCropW = Math.max(0, Math.min(cropW, maxCropW));\n    const finalCropH = Math.max(0, Math.min(cropH, maxCropH));\n\n    if (finalCropW === 0 || finalCropH === 0) {\n      throw new Error('invalid source rectangle');\n    }\n\n    if (cropX !== 0 || cropY !== 0 || finalCropW !== bitmap.width || finalCropH !== bitmap.height) {\n      return this._sources.crop(bitmap, cropX, cropY, finalCropW, finalCropH);\n    }\n    return bitmap;\n  }\n\n  // An omitted grid dimension follows the source aspect ratio.\n  private _placementGrid(bitmap: IImageSource, cmd: IKittyCommand, cw: number, ch: number): { cols: number; rows: number } {\n    if (cmd.columns !== undefined && cmd.rows !== undefined) {\n      return { cols: cmd.columns, rows: cmd.rows };\n    }\n    if (cmd.columns !== undefined) {\n      return { cols: cmd.columns, ro