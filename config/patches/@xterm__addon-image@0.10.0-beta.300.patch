+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+export function checkpointNumberText(value: number): string {
+  return Object.is(value, -0) ? '-0' : String(value);
+}
+
+export function restoreCheckpointNumber(text: string): number {
+  if (typeof text !== 'string' || text.length > 32 || checkpointNumberText(Number(text)) !== text) {
+    throw new Error('Invalid image checkpoint numeric field');
+  }
+  return Number(text);
+}
+
+export function captureCheckpointNumberValue(value: number): number | string {
+  return Number.isFinite(value) && !Object.is(value, -0) ? value : checkpointNumberText(value);
+}
+
+export function restoreCheckpointNumberValue(value: number | string): number {
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value) || Object.is(value, -0)) throw new Error('Invalid image checkpoint numeric value');
+    return value;
+  }
+  return restoreCheckpointNumber(value);
+}
