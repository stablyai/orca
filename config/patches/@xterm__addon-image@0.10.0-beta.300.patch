+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type { IBuffer } from 'common/buffer/Types';
+import { isImageRaster } from './ImageSource';
+import { CHECKPOINT_LEASE_BYTES } from './ImageCheckpointResources';
+import { BgFlags, type IImageSpec, type ITerminalExt } from './Types';
+import {
+  CHECKPOINT_TILE_BYTES, ImageStorageCheckpoint,
+  type ICheckpointImage, type ICheckpointTileRun
+} from './ImageStorageCheckpoint';
+
+function visitBufferTiles(buffer: IBuffer, bufferType: IImageSpec['bufferType'], visit: (run: ICheckpointTileRun) => void): void {
+  const cell = buffer.getNullCell();
+  for (let row = 0; row < buffer.lines.length; ++row) {
+    const line = buffer.lines.get(row);
+    if (!line) throw new Error('Missing image checkpoint buffer line');
+    let run: ICheckpointTileRun | undefined;
+    for (let col = 0; col < line.length; ++col) {
+      let imageId = -1;
+      let tileId = -1;
+      if (line.getBg(col) & BgFlags.HAS_EXTENDED) {
+        const attrs = line.loadCell(col, cell).extended;
+        if ('imageId' in attrs && 'tileId' in attrs && typeof attrs.imageId === 'number' && typeof attrs.tileId === 'number') {
+          imageId = attrs.imageId;
+          tileId = attrs.tileId;
+        }
+      }
+      if (imageId !== -1 && tileId !== -1) {
+        if (!Number.isSafeInteger(imageId) || imageId <= 0 || !Number.isSafeInteger(tileId) || tileId < 0) {
+          throw new RangeError('Invalid image checkpoint tile');
+        }
+        if (run && run.imageId === imageId && run.tileId + run.count === tileId) {
+          run = { ...run, count: run.count + 1 };
+          continue;
+        }
+      }
+      if (run) visit(run);
+      run = imageId !== -1 && tileId !== -1 ? { bufferType, row, col, imageId, tileId, count: 1 } : undefined;
+    }
+    if (run) visit(run);
+  }
+}
+
+export function captureImageStorageCheckpoint(
+  terminal: ITerminalExt, images: ReadonlyMap<number, IImageSpec>, lastId: number, maxBytes: number
+): ImageStorageCheckpoint {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0 || maxBytes > CHECKPOINT_LEASE_BYTES) {
+    throw new RangeError('Invalid image checkpoint byte budget');
+  }
+  if (!Number.isSafeInteger(lastId) || lastId < 0 || images.size > 4096) throw new RangeError('Invalid image checkpoint IDs');
+  const { normal, alt } = terminal._core.buffers;
+  const visitTiles = (visit: (run: ICheckpointTileRun) => void): void => {
+    visitBufferTiles(normal, 'normal', visit);
+    visitBufferTiles(alt, 'alternate', visit);
+  };
+  let byteLength = 0;
+  for (const [id, spec] of images) {
+    const source = spec.orig;
+    if (!Number.isSafeInteger(id) || id <= 0 || id > lastId || !source || !isImageRaster(source)
+      || !Number.isSafeInteger(source.width) || !Number.isSafeInteger(source.height)
+      || source.width <= 0 || source.height <= 0 || source.data.byteLength !== source.width * source.height * 4) {
+      throw new RangeError('Image checkpoint requires valid execution-host rasters');
+    }
+    byteLength += source.data.byteLength;
+    if (byteLength > maxBytes) throw new RangeError('Image checkpoint exceeds byte budget');
+  }
+  let tileBytes = 0;
+  visitTiles(() => {
+    tileBytes += CHECKPOINT_TILE_BYTES;
+    if (byteLength + tileBytes > maxBytes) throw new RangeError('Image checkpoint exceeds byte budget');
+  });
+  const resources = new Map<number, Uint8Array>();
+  const entries: ICheckpointImage[] = [];
+  for (const [id, spec] of images) {
+    const source = spec.orig;
+    if (!source || !isImageRaster(source)) throw new Error('Image checkpoint source changed during capture');
+    const resourceId = resources.size + 1;
+    resources.set(resourceId, new Uint8Array(source.data));
+    entries.push(Object.freeze({
+      id, width: source.width, height: source.height, resourceId,
+      origCellSize: Object.freeze({ ...spec.origCellSize }),
+      bufferType: spec.bufferType, layer: spec.layer, zIndex: spec.zIndex, kittyId: spec.kittyId,
+      virtual: !!spec.virtual, markerLine: spec.marker?.isDisposed ? undefined : spec.marker?.line,
+      tileCount: spec.tileCount
+    }));
+  }
+  const tiles = new Uint8Array(tileBytes);
+  const view = new DataView(tiles.buffer);
+  let offset = 0;
+  visitTiles(run => {
+    view.setUint32(offset, run.bufferType === 'normal' ? 0 : 1, true);
+    view.setUint32(offset + 4, run.row, true);
+    view.setUint32(offset + 8, run.col, true);
+    // Internal image IDs are safe integers, rather than unsigned protocol IDs.
+    view.setFloat64(offset + 12, run.imageId, true);
+    view.setFloat64(offset + 20, run.tileId, true);
+    view.setUint32(offset + 28, run.count, true);
+    offset += CHECKPOINT_TILE_BYTES;
+  });
+  const tilesResourceId = resources.size + 1;
+  resources.set(tilesResourceId, tiles);
+  return new ImageStorageCheckpoint(Object.freeze({
+    cols: terminal.cols, rows: terminal.rows,
+    normalLength: normal.lines.length, alternateLength: alt.lines.length, lastId,
+    images: Object.freeze(entries), tilesResourceId,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength }))),
+    byteLength: byteLength + tileBytes
+  }), resources);
+}
