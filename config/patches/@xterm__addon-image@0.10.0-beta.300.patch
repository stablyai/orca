d of this._storage.getVisibleImageIds()) {\n      const kittyId = this._virtualStorageIds.get(storageId)?.kittyId ?? this._storageIdToKittyId.get(storageId);\n      if (kittyId !== undefined) ids.add(kittyId);\n    }\n    return ids;\n  }\n\n  // Omitted diacritics inherit only from a consecutive matching placeholder.\n  private readonly _renderPlaceholderLine = (line: IBufferLineExt, row: number, cols: number, draws: IImageDrawCall[]): void => {\n    this._visitPlaceholderRuns(line, cols, (cell, start, count) => {\n      const placement = this._placementForRun(cell, count);\n      const spec = placement && this._storage.getImageSpec(placement.storageId);\n      if (!placement || !spec) return;\n      const gridCol = cell.location.column - count;\n      draws.push({ imgSpec: spec, boxCols: placement.cols, boxRows: placement.rows,\n        gridRow: cell.location.row - 1, gridCol, count: Math.min(count, placement.cols - gridCol), col: start, row });\n    });\n  };\n\n  private readonly _collectVisibleImageIds = (line: IBufferLineExt, cols: number, ids: Set<number>): void => {\n    this._visitPlaceholderRuns(line, cols, (cell, _start, count) => {\n      const placement = this._placementForRun(cell, count);\n      if (placement) ids.add(placement.storageId);\n    });\n  };\n\n  private _visitPlaceholderRuns(line: IBufferLineExt, cols: number,\n    visit: (cell: IPlaceholderCell, start: number, count: number) => void): void {\n    if (this._virtualPlacements.size === 0) {\n      return;\n    }\n    let runLength = 0;\n    let previous: IPlaceholderCell | undefined;\n    for (let col = 0; col <= cols; ++col) {\n      const cell = col < cols ? this._placeholderCell(line, col) : undefined;\n      if (runLength > 0 && cell !== undefined && previous !== undefined\n        && cell.imageId === previous.imageId\n        && cell.placementId === previous.placementId\n        && (cell.location.row === 0 || cell.location.row === previous.location.row)\n        && (cell.location.column === 0 || cell.location.column === previous.location.column + 1)\n        && (cell.location.highByte === 0 || cell.location.highByte === previous.location.highByte)) {\n        runLength++;\n        cell.location.row = Math.max(previous.location.row, 1);\n        cell.location.column = previous.location.column + 1;\n        cell.location.highByte = Math.max(previous.location.highByte, 1);\n      } else {\n        if (runLength > 0 && previous !== undefined) {\n          visit(previous, col - runLength, runLength);\n        }\n        runLength = 0;\n        if (cell !== undefined) {\n          runLength = 1;\n          if (!cell.location.row) cell.location.row = 1;\n          if (!cell.location.column) cell.location.column = 1;\n          if (!cell.location.highByte) cell.location.highByte = 1;\n        }\n      }\n      previous = cell ?? previous;\n    }\n  }\n\n  private _placeholderCell(line: IBufferLineExt, col: number): IPlaceholderCell | undefined {\n    if (!line.isCombined(col) && line.getCodePoint(col) !== PLACEHOLDER_CHAR) {\n      return undefined;\n    }\n    const chars = line.getString(col);\n    if (chars.codePointAt(0) !== PLACEHOLDER_CHAR) {\n      return undefined;\n    }\n\n    const fg = line.getFg(col);\n    const fgMode = fg & Attributes.CM_MASK;\n    const imageId = fgMode === Attributes.CM_RGB\n      ? fg & Attributes.RGB_MASK\n      : fgMode === 0 ? 0 : fg & Attributes.PCOLOR_MASK;\n    if (fgMode === 0) {\n      return undefined;\n    }\n\n    // Placement IDs use underline color without an underline style.\n    let placementId = 0;\n    const underlineColor = line._extendedAttrs?.[col]?.underlineColor ?? 0;\n    if (underlineColor > 0) {\n      const underlineMode = underlineColor & Attributes.CM_MASK;\n      placementId = underlineMode === Attributes.CM_RGB\n        ? underlineColor & Attributes.RGB_MASK\n        : underlineMode === 0 ? 0 : underlineColor & Attributes.PCOLOR_MASK;\n    }\n\n    const location = decodePlaceholderLocation(chars);\n    if (location.row < 0 || location.column < 0 || location.highByte < 0 || location.highByte > 256) return undefined;\n    return { imageId, placementId, location };\n  }\n\n  private _placementForRun(cell: IPlaceholderCell, count: number): IVirtualPlacement | undefined {\n    const imageId = (cell.imageId | ((cell.location.highByte - 1) << 24)) >>> 0;\n    const placement = this._virtualPlacementFor(imageId, cell.placementId);\n    // `column` is 1-based and holds the last cell of the run.\n    const gridRow = cell.location.row - 1;\n    const gridCol = cell.location.column - count;\n    if (!placement || gridRow < 0 || gridRow >= placement.rows || gridCol < 0 || gridCol >= placement.cols) {\n      return undefined;\n    }\n    return placement;\n  }\n}\n","/**\n * Copyright (c) 2026 The xterm.js authors. All rights reserved.\n * @license MIT\n */\n\nimport { ImageCheckpointResources, CHECKPOINT_LEASE_BYTES, type ICheckpointResource } from '../ImageCheckpointResources';\nimport type { ImageStorage } from '../ImageStorage';\nimport type { IKittyImageData, IVirtualPlacement } from './KittyGraphicsTypes';\n\nexport interface IKittyCheckpointImage extends Omit<IKittyImageData, 'data'> {\n  readonly resourceId: number;\n  readonly byteLength: number;\n}\n\nexport interface IKittyCheckpointPlacement extends Readonly<IVirtualPlacement> {\n  readonly kittyId: number;\n}\n\nexport interface IKittyStorageCheckpointMetadata {\n  readonly nextImageId: number;\n  readonly images: readonly Readonly<IKittyCheckpointImage>[];\n  readonly physicalPlacements: readonly Readonly<{ kittyId: number; storageId: number }>[];\n  readonly virtualPlacements: readonly IKittyCheckpointPlacement[];\n  readonly resources: readonly ICheckpointResource[];\n  readonly byteLength: number;\n}\n\nexport class KittyStorageCheckpoint extends ImageCheckpointResources<IKittyStorageCheckpointMetadata> {}\n\nexport function captureKittyStorageCheckpoint(\n  images: ReadonlyMap<number, IKittyImag