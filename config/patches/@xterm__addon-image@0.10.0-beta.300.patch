t * (this.dimensions?.css.cell.height || 0);\n    const w = this.dimensions?.css.canvas.width || 0;\n    const h = (end + 1 - start) * (this.dimensions?.css.cell.height || 0);\n    if (!layer || layer === 'top') {\n      this._layers.get('top')?.clearRect(0, y, w, h);\n    }\n    if (!layer || layer === 'bottom') {\n      this._layers.get('bottom')?.clearRect(0, y, w, h);\n      this._layers.get('bottom-background')?.clearRect(0, y, w, h);\n    }\n  }\n\n  /**\n   * Clear whole image canvas.\n   */\n  public clearAll(layer?: ImageLayer): void {\n    if (!layer || layer === 'top') {\n      const ctx = this._layers.get('top');\n      ctx?.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n    }\n    if (!layer || layer === 'bottom') {\n      const ctx = this._layers.get('bottom');\n      ctx?.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);\n      const background = this._layers.get('bottom-background');\n      background?.clearRect(0, 0, background.canvas.width, background.canvas.height);\n    }\n  }\n\n  /**\n   * Draw neighboring tiles on the image layer canvas.\n   */\n  public draw(imgSpec: IImageSpec, tileId: number, col: number, row: number, count: number = 1): void {\n    const layer = imgSpec.layer === 'bottom' && imgSpec.zIndex < -1073741824 ? 'bottom-background' : imgSpec.layer;\n    const ctx = this._layers.get(layer);\n    if (!ctx && !(this._collecting && imgSpec.layer === 'bottom')) {\n      return;\n    }\n    const { width, height } = this.cellSize;\n\n    // Don't try to draw anything, if we cannot get valid renderer metrics.\n    if (width === -1 || height === -1) {\n      return;\n    }\n\n    this._rescaleImage(imgSpec, width, height);\n    const img = imgSpec.actual!;\n    if (isImageRaster(img)) return;\n    const { width: sourceWidth, height: sourceHeight } = imgSpec.actualCellSize;\n    const cols = Math.ceil(img.width / sourceWidth);\n\n    const sx = (tileId % cols) * sourceWidth;\n    const sy = Math.floor(tileId / cols) * sourceHe