from '../ImageCheckpointResources';\nimport type { ImageStorage } from '../ImageStorage';\nimport type { IKittyImageData, IVirtualPlacement } from './KittyGraphicsTypes';\n\nexport interface IKittyCheckpointImage extends Omit<IKittyImageData, 'data'> {\n  readonly resourceId: number;\n  readonly byteLength: number;\n}\n\nexport interface IKittyCheckpointPlacement extends Readonly<IVirtualPlacement> {\n  readonly kittyId: number;\n}\n\nexport interface IKittyStorageCheckpointMetadata {\n  readonly nextImageId: number;\n  readonly images: readonly Readonly<IKittyCheckpointImage>[];\n  readonly physicalPlacements: readonly Readonly<{ kittyId: number; storageId: number }>[];\n  readonly virtualPlacements: readonly IKittyCheckpointPlacement[];\n  readonly resources: readonly ICheckpointResource[];\n  readonly byteLength: number;\n}\n\nexport class KittyStorageCheckpoint extends ImageCheckpointResources<IKittyStorageCheckpointMetadata> {}\n\nexport function captureKittyStorageCheckpoint(\n  images: ReadonlyMap<number, IKittyImageData>, physical: ReadonlyMap<number, number>,\n  virtual: ReadonlyMap<number, ReadonlyMap<number, IVirtualPlacement>>, nextImageId: number, maxBytes: number\n): KittyStorageCheckpoint {\n  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0 || maxBytes > CHECKPOINT_LEASE_BYTES) {\n    throw new RangeError('Invalid Kitty checkpoint byte budget');\n  }\n  const virtualPlacements: IKittyCheckpointPlacement[] = [];\n  for (const [kittyId, placements] of virtual) {\n    for (const placement of placements.values()) {\n      virtualPlacements.push(Object.freeze({ ...placement, kittyId }));\n      if (virtualPlacements.length + physical.size > 4096) throw new RangeError('Kitty checkpoint exceeds placement limit');\n    }\n  }\n  if (images.size > 256 || physical.size > 4096) throw new RangeError('Kitty checkpoint exceeds object limit');\n  let byteLength = 0;\n  for (const image of images.values()) {\n    byteLength += image.data.byteLength;\n    if (byte