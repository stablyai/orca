@@ -0,0 +1,101 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import { CHECKPOINT_LEASE_BYTES } from './ImageCheckpointResources';
+import { ownImageCheckpointMetadata } from './ImageCheckpointMetadata';
+import { restoreCheckpointNumberValue } from './ImageCheckpointNumber';
+import { CHECKPOINT_TILE_BYTES, forEachImageCheckpointTileRun,
+  type ImageStorageCheckpoint, type ICheckpointImage, type IImageStorageCheckpointMetadata } from './ImageStorageCheckpoint';
+import type { IImageAddonOptions } from './Types';
+
+export interface IImageStorageCheckpointPlan {
+  readonly metadata: IImageStorageCheckpointMetadata;
+  readonly tiles: Uint8Array;
+  readonly pixelCount: number;
+  readonly largestImagePixels: number;
+}
+function uint(value: number, min = 0): boolean {
+  return Number.isSafeInteger(value) && value >= min;
+}
+function cellDimension(value: number): boolean { return Number.isFinite(value) && value > 0; }
+
+export function checkImageCheckpointPixelLimits(
+  plan: Pick<IImageStorageCheckpointPlan, 'pixelCount' | 'largestImagePixels'>, opts: IImageAddonOptions
+): void {
+  if (!Number.isFinite(opts.pixelLimit) || opts.pixelLimit <= 0 || plan.largestImagePixels > opts.pixelLimit) {
+    throw new RangeError('Image checkpoint exceeds target pixel limit');
+  }
+  if (!Number.isFinite(opts.storageLimit) || opts.storageLimit <= 0
+    || plan.pixelCount * 4 > Math.max(opts.storageLimit * 1000000, opts.pixelLimit * 4)) {
+    throw new RangeError('Image checkpoint exceeds target storage budget');
+  }
+}
+
+export function prepareImageStorageCheckpointPlan(checkpoint: ImageStorageCheckpoint, opts: IImageAddonOptions): IImageStorageCheckpointPlan {
+  if (checkpoint.isDisposed) throw new Error('Image checkpoint lease is disposed');
+  const metadata = ownImageCheckpointMetadata(checkpoint.metadata);
+  if (!uint(metadata.cols, 1) || !uint(metadata.rows, 1) || !uint(metadata.normalLength, metadata.rows)
+    || (metadata.alternateLength !== 0 && metadata.alternateLength !== metadata.rows) || !uint(metadata.lastId)
+    || !Array.isArray(metadata.images) || metadata.images.length > 4096 || !Array.isArray(metadata.resources)
+    || metadata.resources.length !== metadata.images.length + 1 || !uint(metadata.byteLength)
+    || metadata.byteLength > CHECKPOINT_LEASE_BYTES) throw new Error('Invalid decoded image checkpoint header');
+  const resources = new Map<number, number>();
+  let bytes = 0;
+  for (const resource of metadata.resources) {
+    if (!uint(resource.id, 1) || resources.has(resource.id) || !uint(resource.byteLength)) throw new Error('Invalid decoded image resource');
+    resources.set(resource.id, resource.byteLength);
+    bytes += resource.byteLength;
+    if (bytes > CHECKPOINT_LEASE_BYTES || checkpoint.getResourceByteLength(resource.id) !== resource.byteLength) {
+      throw new Error('Invalid decoded image resource length');
+    }
+  }
+  if (bytes !== metadata.byteLength) throw new Error('Invalid decoded image byte length');
+  const used = new Set<number>();
+  const images = new Map<number, ICheckpointImage>();
+  let pixelCount = 0;
+  let largestImagePixels = 0;
+  for (const image of metadata.images) {
+    if (!uint(image.id, 1) || image.id > metadata.lastId || images.has(image.id) || !uint(image.width, 1) || !uint(image.height, 1)
+      || !uint(image.width * image.height * 4, 1) || resources.get(image.resourceId) !== image.width * image.height * 4
+      || used.has(image.resourceId) || !cellDimension(image.origCellSize.width) || !cellDimension(image.origCellSize.height)
+      || !uint(Math.ceil(image.width / image.origCellSize.width) * Math.ceil(image.height / image.origCellSize.height), 1)
+      || (image.bufferType !== 'normal' && image.bufferType !== 'alternate') || (image.layer !== 'top' && image.layer !== 'bottom')
+      || typeof image.virtual !== 'boolean' || !uint(image.tileCount)
+      || (image.kittyId !== undefined && (!uint(image.kittyId) || image.kittyId > 0xffffffff))
+      || (image.markerLine !== undefined && (!uint(image.markerLine) || image.markerLine >= metadata.normalLength))) {
+      throw new Error('Invalid decoded image checkpoint entry');
+    }
+    restoreCheckpointNumberValue(image.zIndex);
+    images.set(image.id, image); used.add(image.resourceId);
+    pixelCount += image.width * image.height;
+    largestImagePixels = Math.max(largestImagePixels, image.width * image.height);
+  }
+  const tileBytes = resources.get(metadata.tilesResourceId);
+  if (tileBytes === undefined || tileBytes % CHECKPOINT_TILE_BYTES || used.has(metadata.tilesResourceId)) {
+    throw new Error('Invalid decoded image tile resource');
+  }
+  const admission = { pixelCount, largestImagePixels };
+  checkImageCheckpointPixelLimits(admission, opts);
+  const tiles = checkpoint.copyResource(metadata.tilesResourceId, tileBytes);
+  let priorBuffer = -1;
+  let priorRow = -1;
+  let priorEndCol = 0;
+  forEachImageCheckpointTileRun(tiles, run => {
+    const bufferIndex = run.bufferType === 'normal' ? 0 : 1;
+    if (bufferIndex < priorBuffer || (bufferIndex === priorBuffer && (run.row < priorRow
+      || (run.row === priorRow && run.col < priorEndCol)))) throw new Error('Invalid decoded image tile ordering');
+    priorBuffer = bufferIndex; priorRow = run.row; priorEndCol = run.col + run.count;
+    const image = images.get(run.imageId);
+    const length = run.bufferType === 'normal' ? metadata.normalLength : metadata.alternateLength;
+    if (!image || image.bufferType !== run.bufferType || !uint(run.tileId) || run.row >= length || run.col >= metadata.cols
+      || run.count < 1 || run.col + run.count > metadata.cols
+      || run.tileId + run.count > Math.ceil(image.width / image.origCellSize.width) * Math.ceil(image.height / image.origCellSize.height)) {
+      throw new Error('Invalid decoded image tile reference');
+    }
+  });
+  if (checkpoint.isDisposed) throw new Error('Image checkpoint lease is disposed');
+  checkImageCheckpointPixelLimits(admission, opts);
+  return { metadata, tiles, ...admission };
+}
