\n    const maxCropW = Math.max(0, bitmap.width - cropX);\n    const maxCropH = Math.max(0, bitmap.height - cropY);\n    const finalCropW = Math.max(0, Math.min(cropW, maxCropW));\n    const finalCropH = Math.max(0, Math.min(cropH, maxCropH));\n\n    if (finalCropW === 0 || finalCropH === 0) {\n      throw new Error('invalid source rectangle');\n    }\n\n    if (cropX !== 0 || cropY !== 0 || finalCropW !== bitmap.width || finalCropH !== bitmap.height) {\n      return this._sources.crop(bitmap, cropX, cropY, finalCropW, finalCropH);\n    }\n    return bitmap;\n  }\n\n  // An omitted grid dimension follows the source aspect ratio.\n  private _placementGrid(bitmap: IImageSource, cmd: IKittyCommand, cw: number, ch: number): { cols: number; rows: number } {\n    if (cmd.columns !== undefined && cmd.rows !== undefined) {\n      return { cols: cmd.columns, rows: cmd.rows };\n    }\n    if (cmd.columns !== undefined) {\n      return { cols: cmd.columns, rows: Math.max(1, Math.ceil((bitmap.height / bitmap.width) * (cmd.columns * cw) / ch)) };\n    }\n    if (cmd.rows !== undefined) {\n      return { cols: Math.max(1, Math.ceil((bitmap.width / bitmap.height) * (cmd.rows * ch) / cw)), rows: cmd.rows };\n    }\n    return { cols: Math.ceil(bitmap.width / cw), rows: Math.ceil(bitmap.height / ch) };\n  }\n\n  private _placeVirtual(image: IKittyImageData, cmd: IKittyCommand): ImageOperation<boolean> {\n    return this._renderPlacement(image, cmd, true);\n  }\n\n  private _createBitmap(image: IKittyImageData): ImageOperation<IImageSource> {\n    const decode = (): ImageOperation<IImageSource> => {\n      const bytes = image.compression === KittyCompression.ZLIB ? this._decompressZlib(image.data) : image.data;\n      return mapImageOperation(bytes, value => this._createBitmapFromBytes(image, value));\n    };\n    if (this._opts.rasterBackend) return decode();\n    try {\n      return Promise.resolve(decode());\n    } catch (error) {\n      return Promise.reject(error);\n    }\n  }\n