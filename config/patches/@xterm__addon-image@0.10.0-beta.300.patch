(checkpoint, this._pendingTransmissions, this._lastPendingKey,\n      this._maxEncodedBytes, this._initialEncodedBytes, this._opts.storageLimit * 1000000);\n    try {\n      if (this._disposed || generation !== this._generation || checkpoint.isDisposed) {\n        throw new Error('Kitty handler changed during active checkpoint preparation');\n      }\n      requireImageParserState(this._coreTerminal, 0);\n      const previous = this._activeDecoder;\n      const previousAlias = prepared.alias?.decoder;\n      startImageCheckpointParser(this._coreTerminal, [0x1B, 0x5F, 0x47], 16);\n      const meta = prepared.state;\n      this._controlData.set(meta.control);\n      this._controlLength = meta.control.length;\n      this._inControlData = meta.inControlData;\n      this._parsedCommand = prepared.command;\n      this._totalEncodedSize = meta.totalEncodedSize;\n      this._aborted = meta.aborted;\n      this._decodeError = meta.decodeError;\n      this._activeDecoder = prepared.decoder;\n      if (prepared.alias && prepared.decoder) {\n        prepared.alias.decoder.release();\n        prepared.alias.decoder = prepared.decoder;\n      }\n      if (previous && previous !== previousAlias) previous.release();\n    } catch (error) {\n      prepared.decoder?.release();\n      throw error;\n    }\n  }\n\n  private _removePendingEntry(key: number): void {\n    this._pendingTransmissions.delete(key);\n    if (this._lastPendingKey === key) {\n      this._lastPendingKey = undefined;\n    }\n  }\n\n  private _cleanupAllPending(): void {\n    for (const pending of this._pendingTransmissions.values()) {\n      pending.decoder.release();\n    }\n    this._pendingTransmissions.clear();\n    this._lastPendingKey = undefined;\n  }\n\n  public start(): void {\n    this._generation++;\n    this._escapeActive = true;\n    this._aborted = false;\n    this._decodeError = false;\n    this._inControlData = true;\n    this._controlLength = 0;\n    this._parsedCommand = null;\n    // Pre-calculate