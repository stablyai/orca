eImageIds) {\n      this._storage.onCollectVisibleImageIds = undefined;\n    }\n  }\n\n  public storeImage(id: number | undefined, imageData: Omit<IKittyImageData, 'id'>): number {\n    const imageId = id ?? this._nextImageId++;\n\n    this._deleteVirtualPlacements(imageId);\n    const oldStorageId = this._kittyIdToStorageId.get(imageId);\n    if (oldStorageId !== undefined) {\n      this._storage.deleteImage(oldStorageId);\n      this._kittyIdToStorageId.delete(imageId);\n      this._storageIdToKittyId.delete(oldStorageId);\n    }\n\n    const byteLimit = this._storage.getLimit() * 1000000;\n    this._images.delete(imageId);\n    let retainedBytes = 0;\n    for (const image of this._images.values()) retainedBytes += image.data.byteLength;\n    const needsEviction = (): boolean => retainedBytes + imageData.data.byteLength > byteLimit\n      || this._images.size >= KittyImageStorage._maxStoredImages;\n    // Source eviction must not free a bitmap still owned by a decoded placement.\n    const visible = needsEviction() ? this._visibleKittyIds() : new Set<number>();\n    for (const rank of [0, 1, 2]) {\n      for (const [oldestId, image] of this._images) {\n        if (!needsEviction()) break;\n        const imageRank = visible.has(oldestId) ? 2\n          : this._kittyIdToStorageId.has(oldestId) || this._virtualPlacements.has(oldestId) ? 1 : 0;\n        if (imageRank !== rank) continue;\n        retainedBytes -= image.data.byteLength;\n        this._images.delete(oldestId);\n      }\n    }\n\n    this._images.set(imageId, {\n      ...imageData,\n      data: new Uint8Array(imageData.data),\n      id: imageId\n    });\n    return imageId;\n  }\n\n  public addImage(kittyId: number, image: IImageSource, scrolling: boolean, layer: ImageLayer, zIndex: number): void {\n    // Clean up stale reverse-mapping from a previous placement of the same\n    // kitty image.  The old shared-storage entry is kept (it may still be\n    // visible on screen) but its reverse mapping is rem