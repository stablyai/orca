nst end = this._textarea.selectionEnd ?? this._textarea.value.length;\r\n      this._compositionPosition.end = Math.max(this._compositionPosition.start, end);\r\n    }\r\n    if (this._isComposing || this.hasPendingCompositionFinalization) {\r\n      this._finalizeComposition(false);\r\n    }\r\n  }\r\n\r\n  public dispose(): void {\r\n    if (this._textareaChangeTimer !== undefined) {\r\n      clearTimeout(this._textareaChangeTimer);\r\n      this._textareaChangeTimer = undefined;\r\n    }\r\n    for (const timer of this._compositionTimers) {\r\n      clearTimeout(timer);\r\n    }\r\n    this._compositionTimers.clear();\r\n    this._compositionPositionTimer = undefined;\r\n    this._compositionViewTimer = undefined;\r\n    this._compositionEndTimer = undefined;\r\n    this._pendingComposition = undefined;\n    this._pendingCompositionDeletion = undefined;\n    this._isAwaitingCompositionEnd = false;\r\n    this._isComposing = false;\r\n    this._compositionTransactionId++;\r\n  }\n\n  /**\n   * Handles the keydown event, routing any necessary events to the CompositionHelper functions.\n   * @param ev The keydown event.\n   * @returns Whether the Terminal should continue processing the keydown event.\n   */\n  public keydown(ev: KeyboardEvent): boolean {\n    if (this._canceledKey?.code === ev.code && this._canceledKey.timeStamp === ev.timeStamp) {\r\n      this._canceledKey = undefined;\r\n      return false;\r\n    }\r\n    if (ev.key === 'Escape' && (this._isComposing || this.hasPendingCompositionFinalization)) {\r\n      this._canceledKey = { code: ev.code, timeStamp: ev.timeStamp };\r\n      this._cancelComposition();\r\n      return false;\r\n    }\r\n    const deletionKey =\n      ev.code === 'Backspace' || ev.code === 'Delete'\n        ? ev.code\n        : ev.key === 'Backspace' || ev.key === 'Delete'\n          ? ev.key\n          : undefined;\n    if (this._isComposing && ev.keyCode === 229 && deletionKey) {\n      this._deferCompositionDeletion(deletionKey);\n      return false;\n    }\r\n    if (this._isComposing || this.hasPendingCompositionFinalization) {\r\n      if (ev.keyCode === 20 || ev.keyCode === 229) {\n        // 20 is CapsLock, 229 is Enter\n        // Continue composing if the keyCode is the \"composition character\"\n        return false;\n      }\n      if (ev.keyCode === 16 || ev.keyCode === 17 || ev.keyCode === 18) {\n        // Continue composing if the keyCode is a modifier key\n        return false;\n      }\n      // Finish composition immediately. This is mainly here for the case where enter is\n      // pressed and the handler needs to be triggered before the command is executed.\n      this._finalizeComposition(false);\n    }\n\n    if (ev.keyCode === 229) {\n      // If the \"composition character\" is used but gets to this point it means a non-composition\n      // character (eg. numbers and punctuation) was pressed when the IME was active.\n      this._handleAnyTextareaChanges();\n      return false;\n    }\n\n    return true;\n  }\n\n  private _deferCompositionDeletion(key: 'Backspace' | 'Delete'): void {\n    const pendingDeletion: IPendingCompositionDeletion = {\n      transactionId: this._compositionTransactionId,\n      compositionData: this._lastCompositionData\n    };\n    this._pendingCompositionDeletion = pendingDeletion;\n    const textareaValue = this._textarea.value;\n    const selectionStart = this._textarea.selectionStart ?? this._compositionPosition.end;\n    const selectionEnd = this._textarea.selectionEnd ?? selectionStart;\n    this._defer(() => {\n      if (this._pendingCompositionDeletion !== pendingDeletion) {\n        return;\n      }\n      this._pendingCompositionDeletion = undefined;\n      if (\n        !this._isComposing ||\n        this._compositionTransactionId !== pendingDeletion.transactionId ||\n        this._lastCompositionData !== pendingDeletion.compositionData ||\n        this._textarea.value !== textareaValue\n      ) {\n        return;\n      }\n      const compositionData = pendingDeletion.compositionData;\n      const compositionStart = this._compositionPosition.start;\r\n      const compositionEnd = compositionStart + compositionData.length;\r\n      const start = Math.max(compositionStart, Math.min(selectionStart, compositionEnd));\r\n      const end = Math.max(start, Math.min(selectionEnd, compositionEnd));\r\n      const relativeStart = start - compositionStart;\r\n      const relativeEnd = end - compositionStart;\r\n      let nextData = compositionData;\r\n      let nextCaret = relativeStart;\r\n      if (relativeStart !== relativeEnd) {\r\n        nextData =\r\n          compositionData.substring(0, relativeStart) +\r\n          compositionData.substring(relativeEnd);\r\n      } else if (key === 'Backspace' && relativeStart > 0) {\r\n        const before = Array.from(compositionData.substring(0, relativeStart));\r\n        before.pop();\r\n        const prefix = before.join('');\r\n        nextData = prefix + compositionData.substring(relativeStart);\r\n        nextCaret = prefix.length;\r\n      } else if (key === 'Delete' && relativeStart < compositionData.length) {\r\n        const after = Array.from(compositionData.substring(relativeStart));\r\n        after.shift();\r\n        nextData = compositionData.substring(0, relativeStart) + after.join('');\r\n      } else {\r\n        return;\r\n      }\r\n      this._lastCompositionData = nextData;\r\n      this._compositionPosition.end = compositionStart + nextData.length;\r\n      this._compositionView.textContent = `\\u200E${nextData}\\u200E`;\r\n      this._textarea.value =\r\n        textareaValue.substring(0, compositionStart) +\r\n        nextData +\r\n        textareaValue.substring(compositionEnd);\r\n      const caret = compositionStart + nextCaret;\r\n      this._textarea.setSelectionRange(caret, caret);\r\n      this.updateCompositionElements();\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Defers keypress text while a composition finalizer is pending