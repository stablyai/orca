+++ b/src/kitty/KittyStorageCheckpoint.ts
@@ -0,0 +1,111 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import { ImageCheckpointResources, CHECKPOINT_LEASE_BYTES, type ICheckpointResource } from '../ImageCheckpointResources';
+import type { ImageStorage } from '../ImageStorage';
+import type { IKittyImageData, IVirtualPlacement } from './KittyGraphicsTypes';
+
+export interface IKittyCheckpointImage extends Omit<IKittyImageData, 'data'> {
+  readonly resourceId: number;
+  readonly byteLength: number;
+}
+
+export interface IKittyCheckpointPlacement extends Readonly<IVirtualPlacement> {
+  readonly kittyId: number;
+}
+
+export interface IKittyStorageCheckpointMetadata {
+  readonly nextImageId: number;
+  readonly images: readonly Readonly<IKittyCheckpointImage>[];
+  readonly physicalPlacements: readonly Readonly<{ kittyId: number; storageId: number }>[];
+  readonly virtualPlacements: readonly IKittyCheckpointPlacement[];
+  readonly resources: readonly ICheckpointResource[];
+  readonly byteLength: number;
+}
+
+export class KittyStorageCheckpoint extends ImageCheckpointResources<IKittyStorageCheckpointMetadata> {}
+
+export function captureKittyStorageCheckpoint(
+  images: ReadonlyMap<number, IKittyImageData>, physical: ReadonlyMap<number, number>,
+  virtual: ReadonlyMap<number, ReadonlyMap<number, IVirtualPlacement>>, nextImageId: number, maxBytes: number
+): KittyStorageCheckpoint {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0 || maxBytes > CHECKPOINT_LEASE_BYTES) {
+    throw new RangeError('Invalid Kitty checkpoint byte budget');
+  }
+  const virtualPlacements: IKittyCheckpointPlacement[] = [];
+  for (const [kittyId, placements] of virtual) {
+    for (const placement of placements.values()) {
+      virtualPlacements.push(Object.freeze({ ...placement, kittyId }));
+      if (virtualPlacements.length + physical.size > 4096) throw new RangeError('Kitty checkpoint exceeds placement limit');
+    }
+  }
+  if (images.size > 256 || physical.size > 4096) throw new RangeError('Kitty checkpoint exceeds object limit');
+  let byteLength = 0;
+  for (const image of images.values()) {
+    byteLength += image.data.byteLength;
+    if (byteLength > maxBytes) throw new RangeError('Kitty checkpoint exceeds byte budget');
+  }
+  const resources = new Map<number, Uint8Array>();
+  const entries: Readonly<IKittyCheckpointImage>[] = [];
+  for (const image of images.values()) {
+    const resourceId = resources.size + 1;
+    resources.set(resourceId, new Uint8Array(image.data));
+    entries.push(Object.freeze({
+      id: image.id, width: image.width, height: image.height, format: image.format,
+      compression: image.compression, resourceId, byteLength: image.data.byteLength
+    }));
+  }
+  return new KittyStorageCheckpoint(Object.freeze({
+    nextImageId, images: Object.freeze(entries), byteLength,
+    physicalPlacements: Object.freeze([...physical].map(([kittyId, storageId]) => Object.freeze({ kittyId, storageId }))),
+    virtualPlacements: Object.freeze(virtualPlacements),
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareKittyCheckpointImages(
+  checkpoint: KittyStorageCheckpoint, storage: ImageStorage, maxPayloadBytes: number
+): Map<number, IKittyImageData> {
+  if (checkpoint.isDisposed) throw new Error('Kitty checkpoint lease is disposed');
+  if (!Number.isSafeInteger(maxPayloadBytes) || maxPayloadBytes <= 0 || maxPayloadBytes > CHECKPOINT_LEASE_BYTES) {
+    throw new RangeError('Invalid Kitty checkpoint payload limit');
+  }
+  const metadata = checkpoint.metadata;
+  if (!Number.isSafeInteger(metadata.nextImageId) || metadata.nextImageId < 1
+    || metadata.images.length > 256 || metadata.virtualPlacements.length + metadata.physicalPlacements.length > 4096) {
+    throw new RangeError('Invalid Kitty checkpoint counts');
+  }
+  const used = new Set<number>();
+  const checkPlacement = (kittyId: number, storageId: number, virtual: boolean): void => {
+    const spec = storage.getImageSpec(storageId);
+    if (!spec || spec.kittyId !== kittyId || !!spec.virtual !== virtual || used.has(storageId)) {
+      throw new Error('Kitty checkpoint does not match restored decoded placements');
+    }
+    used.add(storageId);
+  };
+  for (const placement of metadata.physicalPlacements) checkPlacement(placement.kittyId, placement.storageId, false);
+  for (const placement of metadata.virtualPlacements) checkPlacement(placement.kittyId, placement.storageId, true);
+  let byteLength = 0;
+  const ids = new Set<number>();
+  for (const image of metadata.images) {
+    if (ids.has(image.id) || !Number.isSafeInteger(image.byteLength) || image.byteLength < 0 || image.byteLength > maxPayloadBytes) {
+      throw new RangeError('Kitty checkpoint exceeds payload limit or repeats a source');
+    }
+    ids.add(image.id);
+    byteLength += image.byteLength;
+  }
+  // A single admitted source can exceed a smaller configured cache budget.
+  if (byteLength > Math.max(storage.getLimit() * 1000000, maxPayloadBytes)) {
+    throw new RangeError('Kitty checkpoint exceeds source storage budget');
+  }
+  const images = new Map<number, IKittyImageData>();
+  for (const image of metadata.images) {
+    images.set(image.id, {
+      id: image.id, width: image.width, height: image.height, format: image.format,
+      compression: image.compression, data: checkpoint.copyResource(image.resourceId, image.byteLength)
+    });
+  }
+  return images;
+}
