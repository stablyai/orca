@@ -0,0 +1,58 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+export const IMAGE_CHECKPOINT_METADATA_BYTES = 8 * 1024 * 1024;
+
+export function imageCheckpointMetadataBytes(value: unknown): number {
+  let bytes = 0;
+  let nodes = 0;
+  const ancestors = new Set<object>();
+  function charge(n: number): void {
+    bytes += n;
+    if (bytes > IMAGE_CHECKPOINT_METADATA_BYTES) throw new RangeError('Image checkpoint metadata exceeds budget');
+  }
+  function visit(item: unknown, depth: number): void {
+    if (++nodes > 262144 || depth > 64) throw new RangeError('Image checkpoint metadata exceeds structural limits');
+    if (item === null || typeof item === 'boolean') { charge(8); return; }
+    if (typeof item === 'number') { charge(24); return; }
+    if (typeof item === 'string') { charge(item.length * 6 + 2); return; }
+    if (!item || typeof item !== 'object') throw new Error('Unsupported image checkpoint metadata value');
+    if (ancestors.has(item)) throw new Error('Cyclic image checkpoint metadata');
+    const array = Array.isArray(item);
+    if (!array && Object.getPrototypeOf(item) !== Object.prototype && Object.getPrototypeOf(item) !== null) {
+      throw new Error('Unsupported image checkpoint metadata object');
+    }
+    if (Array.isArray(item) && item.length > 8192) throw new RangeError('Image checkpoint metadata exceeds array limit');
+    const keys = Object.keys(item);
+    if (Array.isArray(item) && (keys.length !== item.length || keys.some((key, i) => key !== String(i)))) {
+      throw new Error('Image checkpoint metadata requires dense arrays');
+    }
+    if ((array && keys.length > 8192) || (!array && keys.length > 64)) throw new RangeError('Image checkpoint metadata exceeds object limits');
+    charge(16);
+    ancestors.add(item);
+    for (const key of keys) {
+      const descriptor = Object.getOwnPropertyDescriptor(item, key);
+      if (!descriptor || !('value' in descriptor)) throw new Error('Image checkpoint metadata cannot contain accessors');
+      if (descriptor.value === undefined && !array) continue;
+      charge(array ? 8 : key.length * 6 + 4);
+      visit(descriptor.value, depth + 1);
+    }
+    ancestors.delete(item);
+  }
+  visit(value, 0);
+  return bytes;
+}
+
+export function ownImageCheckpointMetadata<T>(value: T): T {
+  imageCheckpointMetadataBytes(value);
+  const clone: T = structuredClone(value);
+  function freeze(item: unknown): void {
+    if (!item || typeof item !== 'object') return;
+    for (const value of Object.values(item)) freeze(value);
+    Object.freeze(item);
+  }
+  freeze(clone);
+  return clone;
+}
