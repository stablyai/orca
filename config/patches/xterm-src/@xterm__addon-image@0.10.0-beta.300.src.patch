@@ -0,0 +1,59 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import { LIMITS } from 'sixel/lib/wasm';
+import { ImageCheckpointResources, type ICheckpointResource } from './ImageCheckpointResources';
+import { checkUploadCheckpointBudget } from './Base64UploadCheckpoint';
+
+export interface ISixelProgramOptions {
+  readonly sixelScrolling: boolean;
+  readonly sixelPaletteLimit: number;
+}
+export interface ISixelStateCheckpointMetadata extends ISixelProgramOptions {
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+export class SixelStateCheckpoint extends ImageCheckpointResources<ISixelStateCheckpointMetadata> {}
+
+export function checkedSixelProgramOptions(options: ISixelProgramOptions): ISixelProgramOptions {
+  const state = Object.freeze({ sixelScrolling: options.sixelScrolling, sixelPaletteLimit: options.sixelPaletteLimit });
+  if (typeof state.sixelScrolling !== 'boolean' || !Number.isSafeInteger(state.sixelPaletteLimit)
+    || state.sixelPaletteLimit < 0 || state.sixelPaletteLimit > LIMITS.PALETTE_SIZE) {
+    throw new Error('Invalid SIXEL program options');
+  }
+  return state;
+}
+export function captureSixelStateCheckpoint(
+  palette: Uint32Array, options: ISixelProgramOptions, maxBytes: number
+): SixelStateCheckpoint {
+  const state = checkedSixelProgramOptions(options);
+  const byteLength = LIMITS.PALETTE_SIZE * 4;
+  checkUploadCheckpointBudget(maxBytes, byteLength);
+  if (palette.length !== LIMITS.PALETTE_SIZE) throw new Error('Unsupported SIXEL palette layout');
+  const bytes = new Uint8Array(byteLength);
+  const view = new DataView(bytes.buffer);
+  for (let i = 0; i < palette.length; i++) view.setUint32(i * 4, palette[i], true);
+  return new SixelStateCheckpoint(Object.freeze({ ...state, byteLength,
+    resources: Object.freeze([Object.freeze({ id: 1, byteLength })])
+  }), new Map([[1, bytes]]));
+}
+export function prepareSixelStateCheckpoint(checkpoint: SixelStateCheckpoint): {
+  options: ISixelProgramOptions; palette: Uint32Array
+} {
+  if (checkpoint.isDisposed) throw new Error('SIXEL state checkpoint lease is disposed');
+  const supplied = checkpoint.metadata;
+  const options = checkedSixelProgramOptions(supplied);
+  const byteLength = LIMITS.PALETTE_SIZE * 4;
+  if (supplied.byteLength !== byteLength || !Array.isArray(supplied.resources) || supplied.resources.length !== 1
+    || supplied.resources[0].id !== 1 || supplied.resources[0].byteLength !== byteLength
+    || checkpoint.getResourceByteLength(1) !== byteLength) {
+    throw new Error('Invalid SIXEL state palette resource');
+  }
+  const bytes = checkpoint.copyResource(1, byteLength);
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const palette = new Uint32Array(LIMITS.PALETTE_SIZE);
+  for (let i = 0; i < palette.length; i++) palette[i] = view.getUint32(i * 4, true);
+  return { options, palette };
+}
