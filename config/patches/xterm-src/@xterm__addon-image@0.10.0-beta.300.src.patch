+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type { ITerminalExt } from './Types';
+import type { ImageStorage } from './ImageStorage';
+import type { KittyGraphicsHandler } from './kitty/KittyGraphicsHandler';
+import type { IIPHandler } from './IIPHandler';
+import type { SixelHandler } from './SixelHandler';
+import { requireImageParserState } from './ImageParserCheckpoint';
+import { ImageAddonCheckpoint, validateImageAddonCheckpoint } from './ImageAddonCheckpoint';
+
+interface IImageCheckpointTarget {
+  terminal: ITerminalExt;
+  storage: ImageStorage;
+  kitty?: KittyGraphicsHandler;
+  iip?: IIPHandler;
+  sixel?: SixelHandler;
+  isCurrent: () => boolean;
+}
+
+export async function restoreImageAddonCheckpoint(checkpoint: ImageAddonCheckpoint, target: IImageCheckpointTarget): Promise<void> {
+  const header = validateImageAddonCheckpoint(checkpoint);
+  requireImageParserState(target.terminal, 0);
+  if (target.terminal.buffer.active.type !== header.activeBuffer) throw new Error('Image checkpoint text buffer mismatch');
+  for (const entry of header.components) {
+    if ((entry.kind.startsWith('kitty-') && !target.kitty) || (entry.kind.startsWith('iip-') && !target.iip)
+      || (entry.kind.startsWith('sixel-') && !target.sixel)) throw new Error('Image checkpoint protocol is disabled');
+  }
+  function checkCurrent(): void {
+    if (checkpoint.isDisposed || target.storage.isDisposed || !target.isCurrent()) throw new Error('Image checkpoint restore is stale');
+  }
+  // The whole-model owner publishes this replacement only after every component succeeds.
+  for (const entry of header.components) {
+    checkCurrent();
+    const part = checkpoint.openComponent(entry);
+    try {
+      switch (part.kind) {
+        case 'decoded': await target.storage.restoreCheckpoint(part.checkpoint); break;
+        case 'kitty-sources': target.kitty?.restoreStorageCheckpoint(part.checkpoint); break;
+        case 'kitty-pending': target.kitty?.restorePendingCheckpoint(part.checkpoint); break;
+        case 'kitty-active': target.kitty?.restoreActiveCheckpoint(part.checkpoint); break;
+        case 'iip-pending': target.iip?.restorePendingCheckpoint(part.checkpoint); break;
+        case 'iip-active': target.iip?.restoreActiveCheckpoint(part.checkpoint); break;
+        case 'sixel-state': target.sixel?.restoreStateCheckpoint(part.checkpoint); break;
+        case 'sixel-active': target.sixel?.restoreActiveCheckpoint(part.checkpoint); break;
+      }
+      checkCurrent();
+    } finally { part.checkpoint.dispose(); }
+  }
+}
