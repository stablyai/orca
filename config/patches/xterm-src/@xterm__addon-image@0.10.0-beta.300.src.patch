+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0 || maxBytes > CHECKPOINT_LEASE_BYTES) {
+    throw new RangeError('Invalid image checkpoint byte budget');
+  }
+  if (!Number.isSafeInteger(lastId) || lastId < 0 || images.size > 4096) throw new RangeError('Invalid image checkpoint IDs');
+  const { normal, alt } = terminal._core.buffers;
+  const visitTiles = (visit: (run: ICheckpointTileRun) => void): void => {
+    visitBufferTiles(normal, 'normal', visit);
+    visitBufferTiles(alt, 'alternate', visit);
+  };
+  let byteLength = 0;
+  for (const [id, spec] of images) {
+    const source = spec.orig;
+    if (!Number.isSafeInteger(id) || id <= 0 || id > lastId || !source || !isImageRaster(source)
+      || !Number.isSafeInteger(source.width) || !Number.isSafeInteger(source.height)
+      || source.width <= 0 || source.height <= 0 || source.data.byteLength !== source.width * source.height * 4) {
+      throw new RangeError('Image checkpoint requires valid execution-host rasters');
+    }
+    byteLength += source.data.byteLength;
+    if (byteLength > maxBytes) throw new RangeError('Image checkpoint exceeds byte budget');
+  }
