+
+import type { IImageRaster, IImageRasterBackend } from './ImageRasterBackend';
+
+export type IImageSource = HTMLCanvasElement | ImageBitmap | IImageRaster;
+export type ImageOperation<T> = T | Promise<T>;
+
+export function isImageRaster(source: IImageSource): source is IImageRaster {
+  return 'kind' in source && source.kind === 'rgba';
+}
+
+export function closeImageSource(source: IImageSource | undefined): void {
+  if (source && 'close' in source) source.close();
+}
+
+export class ImageSourceOwner {
+  private _source: IImageSource | undefined;
+
+  public get value(): IImageSource {
+    if (!this._source) throw new Error('Image operation has no source');
+    return this._source;
+  }
+
+  public replace(source: IImageSource): void {
+    if (this._source !== source) closeImageSource(this._source);
+    this._source = source;
+  }
+
+  public transfer(): IImageSource {
+    const source = this.value;
+    this._source = undefined;
+    return source;
+  }
+
+  public dispose(): void {
+    closeImageSource(this._source);
+    this._source = undefined;
+  }
+}
+
+export function mapImageOperation<T, U>(result: ImageOperation<T>, next: (value: T) => ImageOperation<U>): ImageOperation<U> {
+  return result instanceof Promise ? result.then(next) : next(result);
+}
+
+export function createImageCanvas(localDocument: Document | undefined, width: number, height: number): HTMLCanvasElement {
+  const canvas = (localDocument ?? document).createElement('canvas');
+  canvas.width = width | 0;
+  canvas.height = height | 0;
+  return canvas;
+}
+
+function browserSource(source: IImageSource): HTMLCanvasElement | ImageBitmap {
+  if (isImageRaster(source)) throw new Error('Raster source requires its execution-host backend');
+  return source;
+}
+
+function rasterSource(source: IImageSource): IImageRaster {
+  if (!isImageRaster(source)) throw new Error('Host backend requires an owned raster source');
+  return source;
+}
+
+function ownedArrayView(bytes: Uint8Array): Uint8Array<ArrayBuffer> {
+  return bytes.buffer instanceof ArrayBuffer
+    ? new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.byteLength)
+    : new Uint8Array(bytes);
+}
+
+export class ImageSourceOperations {
+  constructor(private readonly _pixelLimit: number, private readonly _backend?: IImageRasterBackend) {}
