+
+import type { IBuffer } from 'common/buffer/Types';
+import { isImageRaster } from './ImageSource';
+import { CHECKPOINT_LEASE_BYTES } from './ImageCheckpointResources';
+import { BgFlags, type IImageSpec, type ITerminalExt } from './Types';
+import {
+  CHECKPOINT_TILE_BYTES, ImageStorageCheckpoint,
+  type ICheckpointImage, type ICheckpointTileRun
+} from './ImageStorageCheckpoint';
+
+function visitBufferTiles(buffer: IBuffer, bufferType: IImageSpec['bufferType'], visit: (run: ICheckpointTileRun) => void): void {
+  const cell = buffer.getNullCell();
+  for (let row = 0; row < buffer.lines.length; ++row) {
+    const line = buffer.lines.get(row);
+    if (!line) throw new Error('Missing image checkpoint buffer line');
+    let run: ICheckpointTileRun | undefined;
+    for (let col = 0; col < line.length; ++col) {
+      let imageId = -1;
+      let tileId = -1;
+      if (line.getBg(col) & BgFlags.HAS_EXTENDED) {
+        const attrs = line.loadCell(col, cell).extended;
+        if ('imageId' in attrs && 'tileId' in attrs && typeof attrs.imageId === 'number' && typeof attrs.tileId === 'number') {
+          imageId = attrs.imageId;
+          tileId = attrs.tileId;
+        }
+      }
+      if (imageId !== -1 && tileId !== -1) {
+        if (!Number.isSafeInteger(imageId) || imageId <= 0 || !Number.isSafeInteger(tileId) || tileId < 0) {
+          throw new RangeError('Invalid image checkpoint tile');
+        }
+        if (run && run.imageId === imageId && run.tileId + run.count === tileId) {
+          run = { ...run, count: run.count + 1 };
+          continue;
+        }
+      }
+      if (run) visit(run);
+      run = imageId !== -1 && tileId !== -1 ? { bufferType, row, col, imageId, tileId, count: 1 } : undefined;
+    }
+    if (run) visit(run);
+  }
+}
+
+export function captureImageStorageCheckpoint(
+  terminal: ITerminalExt, images: ReadonlyMap<number, IImageSpec>, lastId: number, maxBytes: number
