+
+import Base64Decoder from 'xterm-wasm-parts/lib/base64/Base64Decoder.wasm';
+import { ImageCheckpointResources, type ICheckpointResource } from './ImageCheckpointResources';
+import { planBase64UploadCheckpoint, copyBase64UploadCheckpoint, restoreBase64UploadCheckpoint,
+  checkUploadCheckpointBudget, type IBase64UploadCheckpoint } from './Base64UploadCheckpoint';
+import { captureHeaderFields, prepareFileHeader, type IHeaderFieldsCheckpoint } from './IIPHeaderCheckpoint';
+import type { IHeaderFields } from './IIPHeaderParser';
+
+export interface IIIPUploadCheckpointMetadata {
+  readonly multipart?: Readonly<{ header: IHeaderFieldsCheckpoint; aborted: boolean; base64?: IBase64UploadCheckpoint }>;
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+
+export class IIPUploadCheckpoint extends ImageCheckpointResources<IIIPUploadCheckpointMetadata> {}
+
+export function captureIIPUploadCheckpoint(
+  header: IHeaderFields | undefined, aborted: boolean, decoder: Base64Decoder, encodedByteLength: number, maxBytes: number
+): IIPUploadCheckpoint {
+  checkUploadCheckpointBudget(maxBytes, 0);
+  const resources = new Map<number, Uint8Array>();
+  const plan = header && !aborted ? planBase64UploadCheckpoint(decoder, encodedByteLength) : undefined;
+  const byteLength = plan?.byteLength ?? 0;
+  checkUploadCheckpointBudget(maxBytes, byteLength);
+  if (plan) resources.set(1, copyBase64UploadCheckpoint(plan));
+  const base64 = plan ? Object.freeze({ resourceId: 1, decodedByteLength: plan.decodedByteLength,
+    tailByteLength: plan.tailByteLength, encodedByteLength: plan.encodedByteLength, byteLength: plan.byteLength }) : undefined;
+  const copiedHeader = header ? captureHeaderFields({ type: header.type, name: header.name, size: header.size,
+    width: header.width, height: header.height, preserveAspectRatio: header.preserveAspectRatio, inline: header.inline }) : undefined;
+  return new IIPUploadCheckpoint(Object.freeze({
+    multipart: copiedHeader ? Object.freeze({ header: copiedHeader, aborted, base64 }) : undefined,
+    byteLength, resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareIIPUploadCheckpoint(
+  checkpoint: IIPUploadCheckpoint, maxEncodedBytes: number, initialBytes: number
+): Base64Decoder | undefined {
+  if (checkpoint.isDisposed) throw new Error('Pending IIP checkpoint lease is disposed');
+  const multipart = checkpoint.metadata.multipart;
+  if (!multipart) return undefined;
+  prepareFileHeader(multipart.header);
+  if (multipart.aborted) return undefined;
+  if (!multipart.base64) throw new Error('Pending IIP checkpoint has no decoder resource');
+  const decoder = new Base64Decoder(0, maxEncodedBytes, initialBytes);
+  restoreBase64UploadCheckpoint(checkpoint, multipart.base64, decoder);
+  return decoder;
+}
