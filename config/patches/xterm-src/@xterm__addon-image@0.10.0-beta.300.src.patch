+ */
+
+import type { IKittyCommand } from './KittyGraphicsTypes';
+import { checkpointNumberText, restoreCheckpointNumber } from '../ImageCheckpointNumber';
+
+type NumericField = 'format' | 'id' | 'imageNumber' | 'width' | 'height' | 'x' | 'y' | 'sourceWidth' | 'sourceHeight' | 'xOffset' | 'yOffset' | 'columns' | 'rows' | 'more' | 'quiet' | 'cursorMovement' | 'zIndex' | 'placementId' | 'unicodePlaceholder';
+export type IKittyCommandCheckpoint = Readonly<Omit<IKittyCommand, NumericField> & Partial<Record<NumericField, string>>>;
+
+function captureNumber(value: number | undefined): string | undefined {
+  return value === undefined ? undefined : checkpointNumberText(value);
+}
+function restoreNumber(value: string | undefined): number | undefined {
+  return value === undefined ? undefined : restoreCheckpointNumber(value);
+}
+function restoreString(value: string | undefined): string | undefined {
+  if (value !== undefined && (typeof value !== 'string' || value.length > 512)) throw new Error('Invalid Kitty checkpoint string');
+  return value;
+}
+
+export function captureKittyCommand(command: IKittyCommand): IKittyCommandCheckpoint {
+  return Object.freeze({
+    format: captureNumber(command.format),
+    id: captureNumber(command.id),
+    imageNumber: captureNumber(command.imageNumber),
+    width: captureNumber(command.width),
+    height: captureNumber(command.height),
+    x: captureNumber(command.x),
+    y: captureNumber(command.y),
+    sourceWidth: captureNumber(command.sourceWidth),
+    sourceHeight: captureNumber(command.sourceHeight),
+    xOffset: captureNumber(command.xOffset),
+    yOffset: captureNumber(command.yOffset),
+    columns: captureNumber(command.columns),
+    rows: captureNumber(command.rows),
+    more: captureNumber(command.more),
+    quiet: captureNumber(command.quiet),
+    cursorMovement: captureNumber(command.cursorMovement),
+    zIndex: captureNumber(command.zIndex),
+    placementId: captureNumber(command.placementId),
+    unicodePlaceholder: captureNumber(command.unicodePlaceholder),
+    action: restoreString(command.action),
+    transmission: restoreString(command.transmission),
+    deleteSelector: restoreString(command.deleteSelector),
+    compression: restoreString(command.compression),
+    payload: restoreString(command.payload),
+  });
+}
+
+export function restoreKittyCommand(command: IKittyCommandCheckpoint): IKittyCommand {
+  return {
+    format: restoreNumber(command.format),
+    id: restoreNumber(command.id),
+    imageNumber: restoreNumber(command.imageNumber),
+    width: restoreNumber(command.width),
+    height: restoreNumber(command.height),
+    x: restoreNumber(command.x),
+    y: restoreNumber(command.y),
+    sourceWidth: restoreNumber(command.sourceWidth),
+    sourceHeight: restoreNumber(command.sourceHeight),
+    xOffset: restoreNumber(command.xOffset),
+    yOffset: restoreNumber(command.yOffset),
+    columns: restoreNumber(command.columns),
+    rows: restoreNumber(command.rows),
+    more: restoreNumber(command.more),
+    quiet: restoreNumber(command.quiet),
+    cursorMovement: restoreNumber(command.cursorMovement),
+    zIndex: restoreNumber(command.zIndex),
+    placementId: restoreNumber(command.placementId),
+    unicodePlaceholder: restoreNumber(command.unicodePlaceholder),
+    action: restoreString(command.action),
+    transmission: restoreString(command.transmission),
+    deleteSelector: restoreString(command.deleteSelector),
+    compression: restoreString(command.compression),
+    payload: restoreString(command.payload),
