+  public fromRgba(data: Uint8Array | Uint8ClampedArray, width: number, height: number, bitmap: boolean, size?: { width: number; height: number }): ImageOperation<IImageSource> {
+    this._checkSize(width, height);
+    if (this._backend) return this._checkedRaster(this._backend.fromRgba(data, width, height));
+    const pixels = data.buffer instanceof ArrayBuffer
