+
+import { checkpointNumberText, restoreCheckpointNumber } from './ImageCheckpointNumber';
+import type { HeaderState, IHeaderFields, SequenceType } from './IIPHeaderParser';
+
+export const IIP_HEADER_CHECKPOINT_BYTES = 65536;
+const MAX_FIELDS = 128;
+const MAX_CHARS = 1024;
+type HeaderValue = number | string | Uint32Array | null | undefined;
+export type IHeaderCheckpointValue =
+  | Readonly<{ kind: 'number'; text: string }>
+  | Readonly<{ kind: 'string'; text: string }>
+  | Readonly<{ kind: 'codepoints'; points: readonly number[] }>
+  | Readonly<{ kind: 'null' | 'undefined' }>;
+export interface IHeaderFieldsCheckpoint {
+  readonly entries: readonly Readonly<{ name: string; value: IHeaderCheckpointValue }>[];
+  readonly byteLength: number;
+}
+export interface IHeaderParserCheckpoint {
+  readonly state: HeaderState;
+  readonly buffer: readonly number[];
+  readonly key: string;
+  readonly fields: IHeaderFieldsCheckpoint;
+  readonly byteLength: number;
+}
+
+function checkedString(value: string): number {
+  if (typeof value !== 'string' || value.length > MAX_CHARS) throw new Error('Invalid IIP checkpoint string');
+  return value.length * 4;
+}
+function checkedPoints(points: readonly number[] | Uint32Array): number {
+  if (points.length > MAX_CHARS || points.some(n => !Number.isInteger(n) || n < 0 || n > 0x10FFFF)) {
+    throw new Error('Invalid IIP checkpoint codepoints');
+  }
+  return points.length * 4;
+}
+function valueBytes(value: HeaderValue): number {
+  if (typeof value === 'string') return checkedString(value);
+  if (typeof value === 'number') return checkpointNumberText(value).length * 4;
+  if (value instanceof Uint32Array) return checkedPoints(value);
+  if (value === null || value === undefined) return 4;
+  throw new Error('Unsupported IIP checkpoint field');
+}
+function copyValue(value: HeaderValue): IHeaderCheckpointValue {
+  if (typeof value === 'number') return Object.freeze({ kind: 'number', text: checkpointNumberText(value) });
+  if (typeof value === 'string') return Object.freeze({ kind: 'string', text: value });
+  if (value instanceof Uint32Array) return Object.freeze({ kind: 'codepoints', points: Object.freeze(Array.from(value)) });
+  return Object.freeze({ kind: value === null ? 'null' : 'undefined' });
+}
+export function captureHeaderFields(fields: Record<string, HeaderValue>): IHeaderFieldsCheckpoint {
+  let byteLength = 0;
+  let count = 0;
+  for (const name in fields) {
+    if (!Object.prototype.hasOwnProperty.call(fields, name)) continue;
+    if (++count > MAX_FIELDS) throw new RangeError('IIP checkpoint has too many header fields');
+    byteLength += checkedString(name) + valueBytes(fields[name]) + 8;
+    if (byteLength > IIP_HEADER_CHECKPOINT_BYTES) throw new RangeError('IIP checkpoint header exceeds byte budget');
+  }
+  const entries = [];
+  for (const name in fields) {
+    if (Object.prototype.hasOwnProperty.call(fields, name)) entries.push(Object.freeze({ name, value: copyValue(fields[name]) }));
+  }
+  return Object.freeze({ entries: Object.freeze(entries), byteLength });
+}
+export function restoreHeaderFields(snapshot: IHeaderFieldsCheckpoint): Record<string, HeaderValue> {
+  if (!Array.isArray(snapshot.entries) || snapshot.entries.length > MAX_FIELDS) throw new Error('Invalid IIP checkpoint field count');
+  const fields: Record<string, HeaderValue> = {};
+  let byteLength = 0;
+  for (const entry of snapshot.entries) {
+    byteLength += checkedString(entry.name) + 8;
+    if (Object.prototype.hasOwnProperty.call(fields, entry.name)) throw new Error('Duplicate IIP checkpoint field');
+    const v = entry.value;
+    let value: HeaderValue;
+    switch (v.kind) {
+      case 'number':
+        value = restoreCheckpointNumber(v.text);
+        break;
+      case 'string': value = v.text; break;
+      case 'codepoints':
+        if (!Array.isArray(v.points)) throw new Error('Invalid IIP checkpoint codepoints');
+        checkedPoints(v.points);
+        value = new Uint32Array(v.points);
+        break;
+      case 'null': value = null; break;
+      case 'undefined': value = undefined; break;
+      default: throw new Error('Invalid IIP checkpoint field type');
+    }
+    byteLength += valueBytes(value);
+    if (byteLength > IIP_HEADER_CHECKPOINT_BYTES) throw new RangeError('IIP checkpoint header exceeds byte budget');
+    Object.defineProperty(fields, entry.name, { value, writable: true, enumerable: true, configurable: true });
+  }
