@@ -0,0 +1,66 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+export const CHECKPOINT_CHUNK_BYTES = 262144;
+export const CHECKPOINT_LEASE_BYTES = 128 * 1024 * 1024;
+
+export interface ICheckpointResource {
+  readonly id: number;
+  readonly byteLength: number;
+}
+
+export class ImageCheckpointResources<T> {
+  private _disposed = false;
+
+  constructor(
+    public readonly metadata: T,
+    protected readonly _resources: Map<number, Uint8Array>
+  ) {}
+
+  public get isDisposed(): boolean { return this._disposed; }
+
+  public getResourceByteLength(id: number): number {
+    if (this._disposed) throw new Error('Image checkpoint lease is disposed');
+    const bytes = this._resources.get(id);
+    if (!bytes) throw new RangeError('Invalid image checkpoint resource');
+    return bytes.byteLength;
+  }
+
+  public readResource(id: number, offset: number, length: number): Uint8Array {
+    if (this._disposed) throw new Error('Image checkpoint lease is disposed');
+    const bytes = this._resources.get(id);
+    if (!bytes || !Number.isSafeInteger(offset) || !Number.isSafeInteger(length)
+      || offset < 0 || length < 0 || length > CHECKPOINT_CHUNK_BYTES || offset + length > bytes.byteLength) {
+      throw new RangeError('Invalid image checkpoint resource window');
+    }
+    return bytes.slice(offset, offset + length);
+  }
+
+  public copyResource(id: number, length: number): Uint8Array {
+    if (this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+    const source = this._resources.get(id);
+    if (!source || !Number.isSafeInteger(length) || length < 0 || length > CHECKPOINT_LEASE_BYTES || length !== source.byteLength) {
+      throw new RangeError('Invalid image checkpoint resource length');
+    }
+    const bytes = new Uint8Array(length);
+    for (let offset = 0; offset < length; offset += CHECKPOINT_CHUNK_BYTES) {
+      bytes.set(this.readResource(id, offset, Math.min(CHECKPOINT_CHUNK_BYTES, length - offset)), offset);
+    }
+    if (this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+    return bytes;
+  }
+
+  public takeResources(): Map<number, Uint8Array> {
+    if (this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+    const resources = new Map(this._resources);
+    this.dispose();
+    return resources;
+  }
+
+  public dispose(): void {
+    this._disposed = true;
+    this._resources.clear();
+  }
+}
