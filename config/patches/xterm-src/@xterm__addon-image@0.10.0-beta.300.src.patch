+ * @license MIT
+ */
+
+import type { ICellSize, IImageSpec } from './Types';
+import { ImageCheckpointResources } from './ImageCheckpointResources';
+export { CHECKPOINT_CHUNK_BYTES } from './ImageCheckpointResources';
+
+export interface ICheckpointImage {
+  readonly id: number;
+  readonly width: number;
+  readonly height: number;
+  readonly resourceId: number;
+  readonly origCellSize: Readonly<ICellSize>;
+  readonly bufferType: IImageSpec['bufferType'];
+  readonly layer: IImageSpec['layer'];
+  readonly zIndex: number;
+  readonly kittyId: number | undefined;
+  readonly virtual: boolean;
+  readonly markerLine: number | undefined;
+  readonly tileCount: number;
+}
+
+export interface ICheckpointTileRun {
+  readonly bufferType: IImageSpec['bufferType'];
+  readonly row: number;
+  readonly col: number;
+  readonly imageId: number;
+  readonly tileId: number;
+  readonly count: number;
+}
+
+export interface IImageStorageCheckpointMetadata {
+  readonly cols: number;
+  readonly rows: number;
+  readonly normalLength: number;
+  readonly alternateLength: number;
+  readonly lastId: number;
+  readonly images: readonly ICheckpointImage[];
+  readonly tilesResourceId: number;
+  readonly resources: readonly Readonly<{ id: number; byteLength: number }>[];
+  readonly byteLength: number;
+}
+
+export const CHECKPOINT_TILE_BYTES = 32;
+
+// This lease covers decoded storage only; protocol state belongs to its handlers.
+export class ImageStorageCheckpoint extends ImageCheckpointResources<IImageStorageCheckpointMetadata> {
+  public forEachTileRun(visit: (run: ICheckpointTileRun) => void): void {
+    if (this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+    const bytes = this._resources.get(this.metadata.tilesResourceId);
+    if (!bytes) throw new Error('Missing image checkpoint tiles');
+    const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+    for (let offset = 0; offset < bytes.byteLength; offset += CHECKPOINT_TILE_BYTES) {
+      visit({
+        bufferType: view.getUint32(offset, true) ? 'alternate' : 'normal',
+        row: view.getUint32(offset + 4, true),
+        col: view.getUint32(offset + 8, true),
+        imageId: view.getFloat64(offset + 12, true),
+        tileId: view.getFloat64(offset + 20, true),
+        count: view.getUint32(offset + 28, true)
+      });
+    }
+  }
+
+}
