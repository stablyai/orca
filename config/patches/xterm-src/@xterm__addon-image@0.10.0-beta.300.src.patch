+  }
+
+  public resize(source: IImageSource, width: number, height: number): ImageOperation<IImageSource> {
+    this._checkSize(width, height);
+    if (width === source.width && height === source.height) return source;
+    if (this._backend) return this._checkedRaster(this._backend.resize(rasterSource(source), width, height));
+    if (typeof createImageBitmap !== 'function') return this._canvasTransform(width, height, ctx => ctx.drawImage(browserSource(source), 0, 0, width, height));
+    return createImageBitmap(browserSource(source), { resizeWidth: width, resizeHeight: height, premultiplyAlpha: 'premultiply' });
+  }
+
+  private _canvasTransform(width: number, height: number, draw: (context: CanvasRenderingContext2D) => void): HTMLCanvasElement {
+    const canvas = createImageCanvas(undefined, width, height);
+    try {
+      const context = canvas.getContext('2d');
+      if (!context) throw new Error('Failed to create image canvas context');
+      draw(context);
+      return canvas;
+    } catch (error) {
+      canvas.width = canvas.height = 0;
+      throw error;
+    }
+  }
+
+  public offset(source: IImageSource, x: number, y: number, width: number, height: number): ImageOperation<IImageSource> {
+    this._checkSize(width, height);
+    if (this._backend) return this._checkedRaster(this._backend.offset(rasterSource(source), x, y, width, height));
+    const canvas = createImageCanvas(undefined, width, height);
+    const context = canvas.getContext('2d');
+    if (!context) throw new Error('Failed to create offset canvas context');
+    context.drawImage(browserSource(source), x, y);
+    if (typeof createImageBitmap !== 'function') return canvas;
+    return createImageBitmap(canvas, { premultiplyAlpha: 'premultiply' }).then(
+      result => { canvas.width = canvas.height = 0; return result; },
+      error => { canvas.width = canvas.height = 0; throw error; }
+    );
+  }
+}
