+      id, width: source.width, height: source.height, resourceId,
+      origCellSize: Object.freeze({ ...spec.origCellSize }),
+      bufferType: spec.bufferType, layer: spec.layer, zIndex: spec.zIndex, kittyId: spec.kittyId,
