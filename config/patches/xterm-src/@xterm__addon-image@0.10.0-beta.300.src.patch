+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type { Decoder } from 'sixel/lib/Decoder';
+import { ImageCheckpointResources, type ICheckpointResource } from './ImageCheckpointResources';
+import { checkUploadCheckpointBudget } from './Base64UploadCheckpoint';
+import { checkedSixelProgramOptions, type ISixelProgramOptions } from './SixelStateCheckpoint';
+import { planSixelDecoderCheckpoint, sixelDecoderPalette, sixelCheckpointWords,
+  sixelCheckpointPixels, type ISixelDecoderState } from './SixelDecoderCheckpoint';
+import { ownSixelDecoderState, validateSixelDecoderState, validateSixelBandWidths } from './SixelDecoderCheckpointValidation';
+
+export interface ISixelActiveCheckpointMetadata extends ISixelProgramOptions {
+  readonly aborted: boolean;
+  readonly size: number;
+  readonly decoder?: ISixelDecoderState;
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+export class SixelActiveCheckpoint extends ImageCheckpointResources<ISixelActiveCheckpointMetadata> {}
+
+export function captureSixelActiveCheckpoint(
+  aborted: boolean, size: number, decoder: Decoder | undefined, palette: Uint32Array,
+  options: ISixelProgramOptions, pixelLimit: number, maxBytes: number
+): SixelActiveCheckpoint {
+  const program = checkedSixelProgramOptions(options);
+  const plan = !aborted && decoder ? planSixelDecoderCheckpoint(decoder) : undefined;
+  if (!aborted && !plan) throw new Error('Missing active SIXEL decoder');
+  const lengths = plan ? validateSixelDecoderState(plan.state, size, pixelLimit) : undefined;
+  const byteLength = 16384 + (lengths ? lengths.canvasByteLength + lengths.bandByteLength + lengths.widthsByteLength : 0);
+  checkUploadCheckpointBudget(maxBytes, byteLength);
+  if (plan && (plan.layout.lastOffset > plan.layout.canvas.length || !lengths)) {
+    throw new Error('Invalid SIXEL completed canvas layout');
+  }
+  if (plan) validateSixelBandWidths(plan.state, plan.layout.bandWidths);
+  const resources = new Map<number, Uint8Array>();
+  resources.set(1, sixelCheckpointWords(decoder ? sixelDecoderPalette(decoder) : palette));
+  if (plan && lengths) {
+    resources.set(2, sixelCheckpointWords(plan.layout.canvas.subarray(0, plan.state.lastOffset)));
+    const band = new Uint32Array(lengths.bandWidth * 6);
+    for (let row = 0; row < 6; row++) {
+      band.set(plan.layout.pixels.subarray(row * 16388, row * 16388 + lengths.bandWidth), row * lengths.bandWidth);
+    }
+    resources.set(3, sixelCheckpointWords(band));
+    resources.set(4, sixelCheckpointWords(plan.layout.bandWidths));
+  }
+  return new SixelActiveCheckpoint(Object.freeze({ ...program, aborted, size, decoder: plan?.state, byteLength,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareSixelActiveCheckpoint(checkpoint: SixelActiveCheckpoint, sizeLimit: number, pixelLimit: number) {
+  if (checkpoint.isDisposed) throw new Error('Active SIXEL checkpoint lease is disposed');
+  const supplied = checkpoint.metadata;
+  const options = checkedSixelProgramOptions(supplied);
+  const aborted = supplied.aborted;
+  const size = supplied.size;
+  const state = supplied.decoder ? ownSixelDecoderState(supplied.decoder) : undefined;
+  if (typeof aborted !== 'boolean' || !Number.isSafeInteger(size) || size < 0 || size > 0x7FFFFFFF
+    || aborted === Boolean(state) || (!aborted && size > sizeLimit)) {
+    throw new Error('Invalid active SIXEL decoder ownership or size');
+  }
+  const lengths = state ? validateSixelDecoderState(state, size, pixelLimit) : undefined;
+  const expected = [16384, ...(lengths ? [lengths.canvasByteLength, lengths.bandByteLength, lengths.widthsByteLength] : [])];
+  const byteLength = expected.reduce((sum, n) => sum + n, 0);
+  checkUploadCheckpointBudget(128 * 1024 * 1024, byteLength);
+  if (supplied.byteLength !== byteLength || !Array.isArray(supplied.resources) || supplied.resources.length !== expected.length) {
+    throw new Error('Invalid active SIXEL resource count or lengths');
+  }
+  for (let i = 0; i < expected.length; i++) {
+    if (supplied.resources[i].id !== i + 1 || supplied.resources[i].byteLength !== expected[i]
+      || checkpoint.getResourceByteLength(i + 1) !== expected[i]) throw new Error('Invalid active SIXEL resource descriptor');
+  }
+  const resources = expected.map((length, i) => sixelCheckpointPixels(checkpoint.copyResource(i + 1, length)));
+  const palette = resources[0];
+  if (!state || !lengths) return { aborted, size, options, palette };
+  const widths = Array.from(resources[3]);
+  validateSixelBandWidths(state, widths);
+  const canvas = new Uint32Array(lengths.canvasPixels);
+  canvas.set(resources[1]);
+  return { aborted, size, options, palette, live: { state, canvas, band: resources[2], widths } };
+}
