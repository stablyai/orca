+ * @license MIT
+ */
+
+export function checkpointNumberText(value: number): string {
+  return Object.is(value, -0) ? '-0' : String(value);
+}
+
+export function restoreCheckpointNumber(text: string): number {
+  if (typeof text !== 'string' || text.length > 32 || checkpointNumberText(Number(text)) !== text) {
+    throw new Error('Invalid image checkpoint numeric field');
+  }
+  return Number(text);
+}
