+
+import Base64Decoder from 'xterm-wasm-parts/lib/base64/Base64Decoder.wasm';
+import { ImageCheckpointResources, type ICheckpointResource } from '../ImageCheckpointResources';
+import { planBase64UploadCheckpoint, copyBase64UploadCheckpoint, validateBase64UploadCheckpoint,
+  restoreBase64UploadCheckpoint, checkUploadCheckpointBudget, type IBase64UploadCheckpoint } from '../Base64UploadCheckpoint';
+import { parseKittyCommand, type IKittyCommand, type IPendingTransmission } from './KittyGraphicsTypes';
+
+export interface IKittyActiveState {
+  readonly control: readonly number[];
+  readonly inControlData: boolean;
+  readonly commandParsed: boolean;
+  readonly totalEncodedSize: number;
+  readonly aborted: boolean;
+  readonly decodeError: boolean;
+  readonly pendingKey?: number;
+}
+
+export interface IKittyActiveCheckpointMetadata extends IKittyActiveState {
+  readonly base64?: IBase64UploadCheckpoint;
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+
+export class KittyActiveCheckpoint extends ImageCheckpointResources<IKittyActiveCheckpointMetadata> {}
+
+export function captureKittyActiveCheckpoint(
+  state: IKittyActiveState, decoder: Base64Decoder | null, maxBytes: number
+): KittyActiveCheckpoint {
+  checkUploadCheckpointBudget(maxBytes, 0);
+  const plan = decoder ? planBase64UploadCheckpoint(decoder, decoder.loadedBytes) : undefined;
+  checkUploadCheckpointBudget(maxBytes, plan?.byteLength ?? 0);
+  const resources = new Map<number, Uint8Array>();
+  const base64 = plan ? Object.freeze({ resourceId: 1, decodedByteLength: plan.decodedByteLength,
+    tailByteLength: plan.tailByteLength, encodedByteLength: plan.encodedByteLength, byteLength: plan.byteLength }) : undefined;
+  if (plan) resources.set(1, copyBase64UploadCheckpoint(plan));
+  return new KittyActiveCheckpoint(Object.freeze({
+    ...state, control: Object.freeze([...state.control]), base64, byteLength: plan?.byteLength ?? 0,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareKittyActiveCheckpoint(
+  checkpoint: KittyActiveCheckpoint, pending: ReadonlyMap<number, IPendingTransmission>, lastPendingKey: number | undefined,
+  maxEncodedBytes: number, initialBytes: number, storageBytes: number
+): { state: IKittyActiveState; command: IKittyCommand | null; decoder: Base64Decoder | null; alias: IPendingTransmission | undefined } {
+  if (checkpoint.isDisposed) throw new Error('Active Kitty checkpoint lease is disposed');
+  const supplied = checkpoint.metadata;
+  if (!Array.isArray(supplied.control) || supplied.control.length > 512 || supplied.resources.length > 1) {
+    throw new Error('Invalid active Kitty checkpoint object count');
+  }
+  const meta: IKittyActiveCheckpointMetadata = Object.freeze({
+    control: Object.freeze([...supplied.control]), inControlData: supplied.inControlData,
+    commandParsed: supplied.commandParsed, totalEncodedSize: supplied.totalEncodedSize,
+    aborted: supplied.aborted, decodeError: supplied.decodeError, pendingKey: supplied.pendingKey,
+    base64: supplied.base64 ? Object.freeze({ ...supplied.base64 }) : undefined,
+    byteLength: supplied.byteLength,
+    resources: Object.freeze(supplied.resources.map(r => Object.freeze({ id: r.id, byteLength: r.byteLength })))
+  });
+  if (!Array.isArray(meta.control) || meta.control.length > 512
+    || meta.control.some(code => !Number.isInteger(code) || code < 0 || code > 0x10FFFF)
+    || ![meta.inControlData, meta.commandParsed, meta.aborted, meta.decodeError].every(flag => typeof flag === 'boolean')
+    || !Number.isSafeInteger(meta.totalEncodedSize) || meta.totalEncodedSize < 0
+    || (meta.commandParsed && meta.inControlData)
+    || (!meta.commandParsed && !meta.inControlData && !meta.aborted)
+    || (meta.inControlData && (meta.totalEncodedSize !== 0 || meta.base64 || meta.pendingKey !== undefined))) {
+    throw new Error('Invalid active Kitty control state');
+  }
+  const command = meta.commandParsed ? parseKittyCommand(String.fromCodePoint(...meta.control)) : null;
+  const alias = meta.pendingKey === undefined ? undefined : pending.get(meta.pendingKey);
+  if (meta.pendingKey !== undefined && (!Number.isSafeInteger(meta.pendingKey) || !alias || !meta.base64)) {
+    throw new Error('Active Kitty checkpoint has an invalid decoder alias');
+  }
+  if (meta.base64) {
+    if (meta.aborted || meta.decodeError || !command
+      || meta.byteLength !== meta.base64.byteLength || meta.base64.resourceId !== 1
+      || meta.resources.length !== 1 || meta.resources[0].id !== 1 || meta.resources[0].byteLength !== meta.byteLength
+      || meta.base64.encodedByteLength !== (alias?.totalEncodedSize ?? 0) + meta.totalEncodedSize
+      || (alias && meta.pendingKey !== (command.id ?? lastPendingKey ?? 0))
+      || (!alias && pending.has(command.id ?? lastPendingKey ?? 0))) {
+      throw new Error('Invalid active Kitty decoder ownership');
+    }
+    validateBase64UploadCheckpoint(checkpoint, meta.base64, maxEncodedBytes);
+    const capacity = maxEncodedBytes + 131072;
+    if ((pending.size + (alias ? 0 : 1)) * capacity > storageBytes) {
+      throw new RangeError('Active Kitty checkpoint exceeds decoder capacity budget');
+    }
+  } else if (meta.byteLength !== 0 || meta.resources.length !== 0 || meta.pendingKey !== undefined
+    || (!meta.aborted && !meta.decodeError && meta.totalEncodedSize !== 0)) {
+    throw new Error('Active Kitty checkpoint has a missing decoder');
+  }
+  const decoder = meta.base64 ? new Base64Decoder(0, maxEncodedBytes, initialBytes) : null;
+  if (decoder && meta.base64) restoreBase64UploadCheckpoint(checkpoint, meta.base64, decoder);
+  return { state: meta, command, decoder, alias };
+}
