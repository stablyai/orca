+  const tilesResourceId = resources.size + 1;
+  resources.set(tilesResourceId, tiles);
+  return new ImageStorageCheckpoint(Object.freeze({
+    cols: terminal.cols, rows: terminal.rows,
+    normalLength: normal.lines.length, alternateLength: alt.lines.length, lastId,
+    images: Object.freeze(entries), tilesResourceId,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength }))),
+    byteLength: byteLength + tileBytes
