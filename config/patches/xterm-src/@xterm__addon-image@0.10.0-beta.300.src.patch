+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import { Decoder } from 'sixel/lib/Decoder';
+import { LIMITS } from 'sixel/lib/wasm';
+
+export interface ISixelDecoderState {
+  readonly fillColor: number;
+  readonly width: number;
+  readonly height: number;
+  readonly raster: readonly number[];
+  readonly truncate: number;
+  readonly level: number;
+  readonly mode: number;
+  readonly paletteLimit: number;
+  readonly clearedWidth: number;
+  readonly realWidth: number;
+  readonly bandHeight: number;
+  readonly parserState: number;
+  readonly currentColor: number;
+  readonly cursor: number;
+  readonly params: readonly number[];
+  readonly maxWidth: number;
+  readonly minWidth: number;
+  readonly lastOffset: number;
+  readonly currentHeight: number;
+  readonly bandCount: number;
+}
+
+function decoderLayout(value: unknown) {
+  if (!value || typeof value !== 'object'
+    || !('_states' in value) || !(value._states instanceof Uint32Array) || value._states.length !== 12
+    || !('_palette' in value) || !(value._palette instanceof Uint32Array) || value._palette.length !== 4096
+    || !('_pSrc' in value) || !(value._pSrc instanceof Uint32Array) || value._pSrc.length !== 106196
+    || !('_chunk' in value) || !(value._chunk instanceof Uint8Array) || value._chunk.length !== 16384
+    || !('_PIXEL_OFFSET' in value) || value._PIXEL_OFFSET !== 16388
+    || !('_canvas' in value) || !(value._canvas instanceof Uint32Array)
+    || !('_bandWidths' in value) || !Array.isArray(value._bandWidths)
+    || !('_lastOffset' in value) || typeof value._lastOffset !== 'number'
+    || !('_currentHeight' in value) || typeof value._currentHeight !== 'number'
+    || !('_maxWidth' in value) || typeof value._maxWidth !== 'number'
+    || !('_minWidth' in value) || typeof value._minWidth !== 'number'
+    || value._states.byteOffset !== 1056 || value._palette.byteOffset !== 1168
+    || value._chunk.byteOffset !== 17552 || value._pSrc.byteOffset !== 33968
+    || value._states.buffer.byteLength !== 458752 || value._palette.buffer !== value._states.buffer
+    || value._chunk.buffer !== value._states.buffer || value._pSrc.buffer !== value._states.buffer
+    || LIMITS.PALETTE_SIZE !== 4096 || LIMITS.MAX_WIDTH !== 16384 || LIMITS.CHUNK_SIZE !== 16384) {
+    throw new Error('Unsupported SIXEL decoder checkpoint layout');
+  }
+  const states = new Uint32Array(value._states.buffer, value._states.byteOffset, 28);
+  return { states, palette: value._palette, pixels: value._pSrc, canvas: value._canvas,
+    bandWidths: value._bandWidths, lastOffset: value._lastOffset, currentHeight: value._currentHeight,
+    maxWidth: value._maxWidth, minWidth: value._minWidth,
+    install: (state: ISixelDecoderState, canvas: Uint32Array, widths: number[]) => {
+      value._canvas = canvas;
+      value._bandWidths = widths;
+      value._lastOffset = state.lastOffset;
+      value._currentHeight = state.currentHeight;
+      value._maxWidth = state.maxWidth;
+      value._minWidth = state.minWidth;
+    }
+  };
+}
+
+export function sixelDecoderPalette(decoder: Decoder): Uint32Array { return decoderLayout(decoder).palette; }
+
+export function planSixelDecoderCheckpoint(decoder: Decoder) {
+  const layout = decoderLayout(decoder);
+  const s = layout.states;
+  if (s[0] !== s[1] || s[12] !== 0 || s[19] < 1 || s[19] > 8) throw new Error('Invalid SIXEL decoder checkpoint state');
+  const state: ISixelDecoderState = Object.freeze({ fillColor: s[0], width: s[2], height: s[3],
+    raster: Object.freeze(Array.from(s.subarray(4, 8))), truncate: s[8], level: s[9], mode: s[10],
+    paletteLimit: s[11], clearedWidth: s[10] === 1 ? s[13] : 0, realWidth: s[10] === 1 ? s[14] : 0,
+    bandHeight: s[10] === 1 ? s[15] : 0, parserState: s[16], currentColor: s[17], cursor: s[18],
+    params: Object.freeze(Array.from(s.subarray(20, 20 + s[19]))), maxWidth: layout.maxWidth,
+    minWidth: layout.minWidth, lastOffset: layout.lastOffset, currentHeight: layout.currentHeight,
+    bandCount: layout.bandWidths.length });
+  return { state, layout };
+}
+
+export function sixelCheckpointWords(words: Uint32Array | readonly number[]): Uint8Array {
+  const bytes = new Uint8Array(words.length * 4);
+  const view = new DataView(bytes.buffer);
+  for (let i = 0; i < words.length; i++) view.setUint32(i * 4, words[i], true);
+  return bytes;
+}
+
+export function sixelCheckpointPixels(bytes: Uint8Array): Uint32Array {
+  const words = new Uint32Array(bytes.byteLength / 4);
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  for (let i = 0; i < words.length; i++) words[i] = view.getUint32(i * 4, true);
+  return words;
+}
+
+export function installSixelDecoderCheckpoint(
+  decoder: Decoder, state: ISixelDecoderState, palette: Uint32Array, canvas: Uint32Array,
+  band: Uint32Array, widths: number[]
+): void {
+  const layout = decoderLayout(decoder);
+  const s = layout.states;
+  s.fill(0);
+  s.set([state.fillColor, state.fillColor, state.width, state.height, ...state.raster, state.truncate,
+    state.level, state.mode, state.paletteLimit, 0, state.clearedWidth, state.realWidth,
+    state.bandHeight, state.parserState, state.currentColor, state.cursor, state.params.length]);
+  s.set(state.params, 20);
+  layout.palette.set(palette);
+  const width = band.length / 6;
+  for (let row = 0; row < 6; row++) layout.pixels.set(band.subarray(row * width, (row + 1) * width), row * 16388);
+  layout.install(state, canvas, widths);
+}
