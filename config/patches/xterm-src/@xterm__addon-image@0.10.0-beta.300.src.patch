+
+import Base64Decoder from 'xterm-wasm-parts/lib/base64/Base64Decoder.wasm';
+import { ImageCheckpointResources, type ICheckpointResource } from '../ImageCheckpointResources';
+import { planBase64UploadCheckpoint, copyBase64UploadCheckpoint, validateBase64UploadCheckpoint,
+  restoreBase64UploadCheckpoint, checkUploadCheckpointBudget, type IBase64UploadCheckpoint } from '../Base64UploadCheckpoint';
+import { captureKittyCommand, restoreKittyCommand, type IKittyCommandCheckpoint } from './KittyCommandCheckpoint';
+import type { IPendingTransmission } from './KittyGraphicsTypes';
+
+export interface IKittyPendingUploadCheckpoint extends IBase64UploadCheckpoint {
+  readonly key: number;
+  readonly command: IKittyCommandCheckpoint;
+}
+
+export interface IKittyUploadCheckpointMetadata {
+  readonly pending: readonly IKittyPendingUploadCheckpoint[];
+  readonly lastPendingKey?: number;
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+
+export class KittyUploadCheckpoint extends ImageCheckpointResources<IKittyUploadCheckpointMetadata> {}
+
+export function captureKittyUploadCheckpoint(
+  pending: ReadonlyMap<number, IPendingTransmission>, lastPendingKey: number | undefined, maxBytes: number
+): KittyUploadCheckpoint {
+  checkUploadCheckpointBudget(maxBytes, 0);
+  if (pending.size > 256) throw new RangeError('Pending Kitty checkpoint exceeds object limit');
+  const plans = [...pending].map(([key, entry]) => {
+    if (entry.decodeError) throw new Error('Pending Kitty upload has failed decoding');
+    return { key, command: captureKittyCommand(entry.cmd), plan: planBase64UploadCheckpoint(entry.decoder, entry.totalEncodedSize) };
+  });
+  const byteLength = plans.reduce((sum, entry) => sum + entry.plan.byteLength, 0);
+  checkUploadCheckpointBudget(maxBytes, byteLength);
+  const resources = new Map<number, Uint8Array>();
+  const entries = plans.map(({ key, command, plan }, index) => {
+    const resourceId = index + 1;
+    resources.set(resourceId, copyBase64UploadCheckpoint(plan));
+    return Object.freeze({ key, command, resourceId, decodedByteLength: plan.decodedByteLength,
+      tailByteLength: plan.tailByteLength, encodedByteLength: plan.encodedByteLength, byteLength: plan.byteLength });
+  });
+  return new KittyUploadCheckpoint(Object.freeze({
+    pending: Object.freeze(entries), lastPendingKey, byteLength,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareKittyUploadCheckpoint(
+  checkpoint: KittyUploadCheckpoint, maxEncodedBytes: number, initialBytes: number, storageBytes: number
+): Map<number, IPendingTransmission> {
+  if (checkpoint.isDisposed) throw new Error('Pending Kitty checkpoint lease is disposed');
+  const entries = checkpoint.metadata.pending;
+  const capacity = maxEncodedBytes + 131072;
+  if (entries.length > 256 || entries.length * capacity > storageBytes) throw new RangeError('Pending Kitty checkpoint exceeds decoder capacity budget');
+  if (checkpoint.metadata.lastPendingKey !== undefined && !entries.some(entry => entry.key === checkpoint.metadata.lastPendingKey)) {
+    throw new Error('Pending Kitty checkpoint has an invalid continuation key');
+  }
+  const used = new Set<number>();
+  for (const entry of entries) {
+    if (!Number.isSafeInteger(entry.key) || used.has(entry.key)) throw new Error('Pending Kitty checkpoint repeats an upload key');
+    used.add(entry.key);
+    restoreKittyCommand(entry.command);
+    validateBase64UploadCheckpoint(checkpoint, entry, maxEncodedBytes);
+  }
+  const pending = new Map<number, IPendingTransmission>();
+  try {
+    for (const entry of entries) {
+      const decoder = new Base64Decoder(0, maxEncodedBytes, initialBytes);
+      restoreBase64UploadCheckpoint(checkpoint, entry, decoder);
+      pending.set(entry.key, { cmd: restoreKittyCommand(entry.command), decoder, totalEncodedSize: entry.encodedByteLength, decodeError: false });
+    }
+    return pending;
+  } catch (error) {
+    for (const entry of pending.values()) entry.decoder.release();
+    throw error;
+  }
+}
