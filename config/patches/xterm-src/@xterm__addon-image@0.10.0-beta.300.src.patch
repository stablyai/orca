new file mode 100644
index 0000000000000000000000000000000000000000..61ec2e72df783eca41ef1218edd1ec2a10cd59ae
--- /dev/null
+++ b/src/ImageRasterBackend.ts
@@ -0,0 +1,38 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type {} from '@xterm/addon-image';
+
+export interface IImageRaster {
+  readonly kind: 'rgba';
+  readonly width: number;
+  readonly height: number;
+  readonly data: Uint8ClampedArray;
+  close(): void;
+}
+
+export interface IImageColors {
+  foreground: { rgba: number };
+  background: { rgba: number };
+  ansi: readonly { rgba: number }[];
+}
+
+// Host operations stay synchronous so writeSync cannot pause the terminal parser.
+export interface IImageRasterBackend {
+  fromRgba(data: Uint8Array | Uint8ClampedArray, width: number, height: number): IImageRaster;
+  decode(data: Uint8Array, mime: string, pixelLimit: number): IImageRaster;
+  inflate(data: Uint8Array, byteLimit: number): Uint8Array;
+  crop(source: IImageRaster, x: number, y: number, width: number, height: number): IImageRaster;
+  resize(source: IImageRaster, width: number, height: number): IImageRaster;
+  offset(source: IImageRaster, x: number, y: number, width: number, height: number): IImageRaster;
+  getCellSize?(): { width: number; height: number } | undefined;
+  getColors?(): IImageColors | undefined;
+}
+
+declare module '@xterm/addon-image' {
+  interface IImageAddonOptions {
+    rasterBackend?: IImageRasterBackend;
+  }
+}
