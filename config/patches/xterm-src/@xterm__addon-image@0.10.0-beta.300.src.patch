+ * @license MIT
+ */
+
+import type { ISixelDecoderState } from './SixelDecoderCheckpoint';
+
+export function ownSixelDecoderState(s: ISixelDecoderState): ISixelDecoderState {
+  if (!s || !Array.isArray(s.raster) || s.raster.length !== 4
+    || !Array.isArray(s.params) || s.params.length < 1 || s.params.length > 8) {
+    throw new Error('Invalid SIXEL decoder checkpoint parameters');
+  }
+  return Object.freeze({ fillColor: s.fillColor, width: s.width, height: s.height,
+    raster: Object.freeze([...s.raster]), truncate: s.truncate, level: s.level, mode: s.mode,
+    paletteLimit: s.paletteLimit, clearedWidth: s.clearedWidth, realWidth: s.realWidth,
+    bandHeight: s.bandHeight, parserState: s.parserState, currentColor: s.currentColor, cursor: s.cursor,
+    params: Object.freeze([...s.params]), maxWidth: s.maxWidth, minWidth: s.minWidth,
+    lastOffset: s.lastOffset, currentHeight: s.currentHeight, bandCount: s.bandCount });
+}
+
+export function validateSixelDecoderState(s: ISixelDecoderState, size: number, pixelLimit: number) {
+  const integers = [s.width, s.height, ...s.raster, s.truncate, s.level, s.mode, s.paletteLimit,
+    s.clearedWidth, s.realWidth, s.bandHeight, s.parserState, s.cursor, ...s.params,
+    s.maxWidth, s.minWidth, s.lastOffset, s.currentHeight, s.bandCount];
+  if (!integers.every(n => Number.isSafeInteger(n) && n >= 0 && n <= 0x7FFFFFFF)
+    || ![s.fillColor, s.currentColor].every(n => Number.isInteger(n) && n >= 0 && n <= 0xFFFFFFFF)
+    || ![0, 1].includes(s.truncate) || s.mode > 2 || s.level > 2 || s.paletteLimit > 4096
+    || s.maxWidth > 16384 || s.minWidth > 16384 || s.bandHeight > 63 || s.bandCount > size
+    || !Number.isSafeInteger(pixelLimit) || pixelLimit < 1
+    || s.lastOffset > pixelLimit || s.currentHeight > size * 6) {
+    throw new RangeError('Invalid SIXEL decoder checkpoint dimensions or counters');
+  }
+  let bandWidth = 0;
+  let canvasPixels = 0;
+  if (s.mode === 0) {
+    if (s.level !== 0 || s.width || s.height || s.raster.some(n => n !== 0) || s.bandCount
+      || s.lastOffset || s.currentHeight || s.maxWidth || s.minWidth !== 16384
+      || s.cursor !== 4 || ![0, 34].includes(s.parserState)) {
+      throw new Error('Invalid undecided SIXEL checkpoint state');
+    }
+  } else if (s.mode === 1) {
+    if (s.width || s.height || s.level !== 1 || !s.truncate || ![0, 33, 35].includes(s.parserState)
+      || s.currentHeight !== s.bandCount * 6 || s.clearedWidth < 4 || s.clearedWidth > 16388
+      || (s.clearedWidth - 4) % 128 !== 0 || s.realWidth < 4 || s.realWidth > 16384 || s.cursor < 4) {
+      throw new Error('Invalid variable-width SIXEL checkpoint state');
+    }
+    bandWidth = s.clearedWidth - 4;
+    canvasPixels = s.lastOffset;
+    const touchedWidth = Math.min(16384, Math.max(s.realWidth, s.cursor)) - 4;
+    if (touchedWidth > bandWidth) throw new Error('Invalid SIXEL current band width');
+    const touchedHeight = s.bandHeight ? 32 - Math.clz32(s.bandHeight) : 0;
+    if (Math.max(s.maxWidth, touchedWidth) * (s.currentHeight + touchedHeight) > pixelLimit) {
+      throw new RangeError('SIXEL checkpoint exceeds pixel budget');
+    }
+  } else {
+    if (s.level !== 2 || s.truncate !== 1 || ![0, 33, 35].includes(s.parserState)
+      || s.width !== Math.min(s.raster[2], 16384) + 4 || s.height !== s.raster[3]
+      || s.maxWidth !== s.width - 4 || s.minWidth !== 16384 || s.bandCount
+      || s.currentHeight > s.height || s.lastOffset !== (s.width - 4) * s.currentHeight
+      || (s.currentHeight !== s.height && s.currentHeight % 6 !== 0) || s.cursor < 4) {
+      throw new Error('Invalid fixed-raster SIXEL checkpoint state');
+    }
+    bandWidth = s.width - 4;
+    canvasPixels = bandWidth * s.height;
+  }
+  if (canvasPixels > pixelLimit) throw new RangeError('SIXEL checkpoint exceeds pixel budget');
+  // Width entries become JS numbers again; admit their live footprint, not only their wire bytes.
+  const memoryBytes = 458752 + canvasPixels * 4 + s.bandCount * 8;
+  if (memoryBytes > pixelLimit * 4 + 458752) throw new RangeError('SIXEL checkpoint exceeds decoder memory budget');
+  return { bandWidth, canvasPixels, canvasByteLength: s.lastOffset * 4,
+    bandByteLength: bandWidth * 6 * 4, widthsByteLength: s.bandCount * 4 };
+}
+
+export function validateSixelBandWidths(s: ISixelDecoderState, widths: readonly number[]): void {
+  let offset = 0;
+  let maximum = 0;
+  let minimum = 16384;
+  for (const width of widths) {
+    if (!Number.isInteger(width) || width < 0 || width > 16380) throw new Error('Invalid SIXEL band width');
+    offset += width * 6;
+    maximum = Math.max(maximum, width);
+    minimum = Math.min(minimum, width);
+  }
+  if (s.mode === 1 && (offset !== s.lastOffset || maximum !== s.maxWidth || minimum !== s.minWidth)) {
+    throw new Error('Invalid SIXEL completed band dimensions');
+  }
+}
