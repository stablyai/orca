@@ -0,0 +1,60 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type { IBufferLine } from 'common/buffer/Types';
+import type { ImageStorageCheckpoint } from './ImageStorageCheckpoint';
+import { closeImageSource, ImageSourceOperations, type IImageSource } from './ImageSource';
+import type { IImageAddonOptions, ITerminalExt } from './Types';
+
+export function checkImageCheckpointGeometry(terminal: ITerminalExt, checkpoint: ImageStorageCheckpoint): void {
+  const metadata = checkpoint.metadata;
+  if (checkpoint.isDisposed || metadata.cols !== terminal.cols || metadata.rows !== terminal.rows
+    || metadata.normalLength !== terminal._core.buffers.normal.lines.length
+    || metadata.alternateLength !== terminal._core.buffers.alt.lines.length) {
+    throw new Error('Image checkpoint does not match restored text buffers');
+  }
+  checkpoint.forEachTileRun(run => {
+    const buffer = run.bufferType === 'normal' ? terminal._core.buffers.normal : terminal._core.buffers.alt;
+    const line = buffer.lines.get(run.row);
+    if (!line || run.col + run.count > line.length) throw new Error('Missing image checkpoint target cells');
+  });
+}
+
+export async function prepareImageCheckpointSources(
+  checkpoint: ImageStorageCheckpoint, opts: IImageAddonOptions
+): Promise<Map<number, IImageSource>> {
+  const sources = new Map<number, IImageSource>();
+  const operations = new ImageSourceOperations(opts.pixelLimit, opts.rasterBackend);
+  let pixels = 0;
+  for (const image of checkpoint.metadata.images) pixels += image.width * image.height;
+  if (pixels * 4 > Math.max(opts.storageLimit * 1000000, opts.pixelLimit * 4)) {
+    throw new RangeError('Image checkpoint exceeds target storage budget');
+  }
+  try {
+    for (const image of checkpoint.metadata.images) {
+      const length = image.width * image.height * 4;
+      if (image.width * image.height > opts.pixelLimit) throw new RangeError('Image checkpoint exceeds target pixel limit');
+      const bytes = checkpoint.copyResource(image.resourceId, length);
+      sources.set(image.id, await operations.fromRgba(bytes, image.width, image.height, true));
+      if (checkpoint.isDisposed) throw new Error('Image checkpoint lease was disposed during preparation');
+    }
+    return sources;
+  } catch (error) {
+    for (const source of sources.values()) closeImageSource(source);
+    throw error;
+  }
+}
+
+export function visitImageCheckpointCells(
+  terminal: ITerminalExt, checkpoint: ImageStorageCheckpoint,
+  visit: (line: IBufferLine, col: number, imageId: number, tileId: number) => void
+): void {
+  checkpoint.forEachTileRun(run => {
+    const buffer = run.bufferType === 'normal' ? terminal._core.buffers.normal : terminal._core.buffers.alt;
+    const line = buffer.lines.get(run.row);
+    if (!line) throw new Error('Missing image checkpoint target line');
+    for (let col = 0; col < run.count; ++col) visit(line, run.col + col, run.imageId, run.tileId + col);
+  });
+}
