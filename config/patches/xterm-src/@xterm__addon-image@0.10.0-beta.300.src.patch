+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+
+import type { ITerminalExt } from './Types';
+
+export function imageParserState(terminal: ITerminalExt): number {
+  const parser = terminal._core._inputHandler._parser;
+  if (!('currentState' in parser) || typeof parser.currentState !== 'number'
+    || !Number.isInteger(parser.currentState) || parser.currentState < 0 || parser.currentState > 16) {
+    throw new Error('Unsupported image checkpoint parser layout');
+  }
+  return parser.currentState;
+}
+
+export function requireImageParserState(terminal: ITerminalExt, state: number): void {
+  if (imageParserState(terminal) !== state) throw new Error('Image checkpoint requires a drained parser boundary');
+}
+
+export function startImageCheckpointParser(terminal: ITerminalExt, prefix: readonly number[], state: number): void {
+  requireImageParserState(terminal, 0);
+  const parser = terminal._core._inputHandler._parser;
+  const data = new Uint32Array(prefix);
+  if (parser.parse(data, data.length)) throw new Error('Image checkpoint parser bootstrap paused');
+  requireImageParserState(terminal, state);
+}
