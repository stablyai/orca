+export interface IImageAddonCheckpointMetadata {
+  readonly version: 1;
+  readonly activeBuffer: 'normal' | 'alternate';
+  readonly components: readonly IImageCheckpointComponent[];
+  readonly resources: readonly ICheckpointResource[];
+  readonly resourceByteLength: number;
+  readonly metadataByteLength: number;
+  readonly byteLength: number;
+}
+
+declare module '@xterm/addon-image' {
+  interface ImageAddon {
+    captureCheckpoint(maxBytes: number): ImageAddonCheckpoint;
+    /** Apply only to an unpublished replacement with its text buffers restored. */
+    restoreCheckpoint(checkpoint: ImageAddonCheckpoint): Promise<void>;
+  }
+}
+
+function component(part: IImageCheckpointPart, resourceIds: readonly number[]): IImageCheckpointComponent {
+  switch (part.kind) {
+    case 'decoded': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'kitty-sources': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'kitty-pending': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'iip-pending': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'sixel-state': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'kitty-active': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'iip-active': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+    case 'sixel-active': return Object.freeze({ kind: part.kind, metadata: part.checkpoint.metadata, resourceIds });
+  }
+}
+
+export class ImageAddonCheckpoint extends ImageCheckpointResources<IImageAddonCheckpointMetadata> {
+  private readonly _borrowedResources = new Set<Map<number, Uint8Array>>();
+
+  public override dispose(): void {
+    for (const resources of this._borrowedResources) resources.clear();
+    this._borrowedResources.clear();
+    super.dispose();
+  }
+
+  public openComponent(entry: IImageCheckpointComponent): IImageCheckpointPart {
+    if (this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+    const resources = new Map<number, Uint8Array>();
+    for (let i = 0; i < entry.metadata.resources.length; i++) {
+      const bytes = this._resources.get(entry.resourceIds[i]);
+      if (!bytes) throw new Error('Missing image checkpoint resource');
+      resources.set(entry.metadata.resources[i].id, bytes);
+    }
+    switch (entry.kind) {
+      case 'decoded': return this._bindPart({ kind: entry.kind, checkpoint: new ImageStorageCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'kitty-sources': return this._bindPart({ kind: entry.kind, checkpoint: new KittyStorageCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'kitty-pending': return this._bindPart({ kind: entry.kind, checkpoint: new KittyUploadCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'iip-pending': return this._bindPart({ kind: entry.kind, checkpoint: new IIPUploadCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'sixel-state': return this._bindPart({ kind: entry.kind, checkpoint: new SixelStateCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'kitty-active': return this._bindPart({ kind: entry.kind, checkpoint: new KittyActiveCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'iip-active': return this._bindPart({ kind: entry.kind, checkpoint: new IIPActiveCheckpoint(entry.metadata, resources) }, entry, resources);
+      case 'sixel-active': return this._bindPart({ kind: entry.kind, checkpoint: new SixelActiveCheckpoint(entry.metadata, resources) }, entry, resources);
+    }
+  }
+
+  private _bindPart<T extends IImageCheckpointPart>(part: T, entry: IImageCheckpointComponent, resources: Map<number, Uint8Array>): T {
+    this._borrowedResources.add(resources);
+    let disposed = false;
+    const view = part.checkpoint;
+    const globalId = (id: number): number => {
+      if (disposed || this.isDisposed) throw new Error('Image checkpoint lease is disposed');
+      const index = entry.metadata.resources.findIndex(r => r.id === id);
+      if (index < 0) throw new Error('Invalid image checkpoint resource');
+      return entry.resourceIds[index];
+    };
+    Object.defineProperty(view, 'isDisposed', { get: () => disposed || this.isDisposed });
+    view.dispose = () => { disposed = true; resources.clear(); this._borrowedResources.delete(resources); };
+    view.takeResources = () => { throw new Error('Borrowed image checkpoint resources cannot be moved'); };
+    view.getResourceByteLength = id => this.getResourceByteLength(globalId(id));
+    view.readResource = (id, offset, length) => this.readResource(globalId(id), offset, length);
+    return part;
+  }
+}
+
+export function captureImageAddonCheckpoint(
+  activeBuffer: 'normal' | 'alternate', maxBytes: number,
+  captures: readonly ((remaining: number) => IImageCheckpointPart)[], active?: IImageCheckpointPart
+): ImageAddonCheckpoint {
+  checkUploadCheckpointBudget(maxBytes, 0);
+  const resources = new Map<number, Uint8Array>();
+  const components: IImageCheckpointComponent[] = [];
+  let resourceByteLength = 0;
+  function append(part: IImageCheckpointPart): void {
+    const resourceIds: number[] = [];
+    try {
+      const moved = part.checkpoint.takeResources();
+      for (const local of part.checkpoint.metadata.resources) {
+        const bytes = moved.get(local.id);
+        if (!bytes || bytes.byteLength !== local.byteLength) throw new Error('Invalid captured image resource');
+        const id = resources.size + 1;
+        resources.set(id, bytes);
+        resourceIds.push(id);
+        resourceByteLength += bytes.byteLength;
+      }
+      checkUploadCheckpointBudget(maxBytes, resourceByteLength);
+      components.push(component(part, Object.freeze(resourceIds)));
+    } finally { part.checkpoint.dispose(); }
+  }
+  try {
+    const reserved = active?.checkpoint.metadata.byteLength ?? 0;
+    for (const capture of captures) append(capture(maxBytes - resourceByteLength - reserved));
+    if (active) append(active);
+    const header = { version: 1 as const, activeBuffer, components: Object.freeze(components),
+      resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength }))),
+      resourceByteLength, metadataByteLength: 0, byteLength: 0 };
+    const metadataByteLength = imageCheckpointMetadataBytes(header);
+    const byteLength = resourceByteLength + metadataByteLength;
+    checkUploadCheckpointBudget(maxBytes, byteLength);
+    return new ImageAddonCheckpoint(ownImageCheckpointMetadata({ ...header, metadataByteLength, byteLength }), resources);
+  } catch (error) { resources.clear(); active?.checkpoint.dispose(); throw error; }
+}
+
+const COMPONENT_ORDER = ['decoded', 'kitty-sources', 'kitty-pending', 'iip-pending', 'sixel-state', 'kitty-active', 'iip-active', 'sixel-active'];
+
+export function validateImageAddonCheckpoint(checkpoint: ImageAddonCheckpoint): IImageAddonCheckpointMetadata {
+  if (checkpoint.isDisposed) throw new Error('Image checkpoint lease is disposed');
+  const header = ownImageCheckpointMetadata(checkpoint.metadata);
+  if (header.version !== 1 || (header.activeBuffer !== 'normal' && header.activeBuffer !== 'alternate')
+    || !Array.isArray(header.components) || header.components.length < 1 || header.components.length > 8
+    || !Array.isArray(header.resources) || header.resources.length > 8192
+    || header.metadataByteLength !== imageCheckpointMetadataBytes(header)) throw new Error('Invalid image checkpoint header');
+  const descriptors = new Map<number, number>();
+  let resourceBytes = 0;
+  for (const resource of header.resources) {
+    if (!Number.isSafeInteger(resource.id) || resource.id < 1 || descriptors.has(resource.id)
+      || !Number.isSafeInteger(resource.byteLength) || resource.byteLength < 0
+      || checkpoint.getResourceByteLength(resource.id) !== resource.byteLength) throw new Error('Invalid image checkpoint resource');
+    descriptors.set(resource.id, resource.byteLength);
+    resourceBytes += resource.byteLength;
+  }
+  const used = new Set<number>();
+  const kinds = new Set<string>();
+  let prior = -1;
+  for (const entry of header.components) {
+    const index = COMPONENT_ORDER.indexOf(entry.kind);
+    if (index <= prior || !Array.isArray(entry.resourceIds) || !Array.isArray(entry.metadata.resources)
+      || entry.resourceIds.length !== entry.metadata.resources.length) throw new Error('Invalid image checkpoint component order');
+    prior = index;
+    kinds.add(entry.kind);
+    const localIds = new Set<number>();
+    let bytes = 0;
+    entry.metadata.resources.forEach((local: ICheckpointResource, i: number) => {
+      const id = entry.resourceIds[i];
+      if (!Number.isSafeInteger(local.id) || local.id < 1 || localIds.has(local.id) || used.has(id)
+        || !descriptors.has(id) || descriptors.get(id) !== local.byteLength) throw new Error('Invalid image checkpoint component resource');
+      localIds.add(local.id); used.add(id); bytes += local.byteLength;
+    });
+    if (bytes !== entry.metadata.byteLength) throw new Error('Invalid image checkpoint component byte length');
+  }
+  const active = ['kitty-active', 'iip-active', 'sixel-active'].filter(kind => kinds.has(kind));
+  if (!kinds.has('decoded') || kinds.has('kitty-sources') !== kinds.has('kitty-pending')
+    || (kinds.has('kitty-active') && !kinds.has('kitty-pending'))
+    || (kinds.has('iip-active') && kinds.has('iip-pending')) || (kinds.has('sixel-active') && kinds.has('sixel-state'))
+    || active.length > 1 || used.size !== descriptors.size || resourceBytes !== header.resourceByteLength
+    || header.byteLength !== resourceBytes + header.metadataByteLength || header.byteLength > CHECKPOINT_LEASE_BYTES) {
+    throw new Error('Invalid image checkpoint ownership');
+  }
+  return header;
+}
