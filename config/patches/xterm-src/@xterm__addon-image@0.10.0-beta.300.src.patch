+    const canvas = createImageCanvas(undefined, width, height);
+    canvas.getContext('2d')?.putImageData(image, 0, 0);
+    return resizing ? this.resize(canvas, size.width, size.height) : canvas;
+  }
+
+  public decode(bytes: Uint8Array, mime: string, size?: { width: number; height: number }): ImageOperation<IImageSource> {
+    if (this._backend) return this._checkedRaster(this._backend.decode(bytes, mime, this._pixelLimit));
+    if (size) this._checkSize(size.width, size.height);
+    const blob = new Blob([ownedArrayView(bytes)], { type: mime });
+    if (typeof createImageBitmap !== 'function') {
+      const url = URL.createObjectURL(blob);
+      const image = new Image();
+      return new Promise<HTMLCanvasElement>((resolve, reject) => {
+        image.addEventListener('load', () => {
+          URL.revokeObjectURL(url);
+          try {
+            this._checkSize(image.width, image.height);
+            const canvas = createImageCanvas(undefined, size?.width ?? image.width, size?.height ?? image.height);
+            const context = canvas.getContext('2d');
+            if (!context) throw new Error('Failed to create image canvas context');
+            context.drawImage(image, 0, 0, canvas.width, canvas.height);
+            resolve(canvas);
+          } catch (error) {
+            reject(error);
+          }
+        });
+        image.addEventListener('error', () => {
+          URL.revokeObjectURL(url);
+          reject(new Error('Failed to load image'));
+        });
+        image.src = url;
+      });
