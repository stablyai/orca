+ * @license MIT
+ */
+
+import Base64Decoder from 'xterm-wasm-parts/lib/base64/Base64Decoder.wasm';
+import { ImageCheckpointResources, type ICheckpointResource } from './ImageCheckpointResources';
+import { planBase64UploadCheckpoint, copyBase64UploadCheckpoint, validateBase64UploadCheckpoint,
+  restoreBase64UploadCheckpoint, checkUploadCheckpointBudget, type IBase64UploadCheckpoint } from './Base64UploadCheckpoint';
+import { HeaderParser, HeaderState, SequenceType, type IHeaderFields } from './IIPHeaderParser';
+import { captureHeaderFields, prepareFileHeader, IIP_HEADER_CHECKPOINT_BYTES,
+  type IHeaderFieldsCheckpoint, type IHeaderParserCheckpoint } from './IIPHeaderCheckpoint';
+
+export interface IIIPActiveState {
+  readonly aborted: boolean;
+  readonly isMultipart: boolean;
+  readonly abortMulti: boolean;
+  readonly multipartEncodedSize: number;
+}
+export interface IIIPActiveCheckpointMetadata extends IIIPActiveState {
+  readonly headerParser: IHeaderParserCheckpoint;
+  readonly header: IHeaderFieldsCheckpoint;
+  readonly headerByteLength: number;
+  readonly base64?: IBase64UploadCheckpoint;
+  readonly byteLength: number;
+  readonly resources: readonly ICheckpointResource[];
+}
+export class IIPActiveCheckpoint extends ImageCheckpointResources<IIIPActiveCheckpointMetadata> {}
+
+export function captureIIPActiveCheckpoint(
+  state: IIIPActiveState, parser: HeaderParser, header: IHeaderFields, decoder: Base64Decoder, maxBytes: number
+): IIPActiveCheckpoint {
+  checkUploadCheckpointBudget(maxBytes, 0);
+  const headerParser = parser.captureCheckpoint();
+  const copiedHeader = captureHeaderFields({ type: header.type, name: header.name, size: header.size,
+    width: header.width, height: header.height, preserveAspectRatio: header.preserveAspectRatio, inline: header.inline });
+  const headerByteLength = headerParser.byteLength + copiedHeader.byteLength;
+  if (headerByteLength > IIP_HEADER_CHECKPOINT_BYTES) throw new RangeError('IIP active checkpoint exceeds header budget');
+  const live = (state.isMultipart && !state.abortMulti)
+    || (!state.aborted && parser.state === HeaderState.END && parser.fields.type === SequenceType.FILE);
+  const plan = live ? planBase64UploadCheckpoint(decoder, decoder.loadedBytes) : undefined;
+  checkUploadCheckpointBudget(maxBytes, plan?.byteLength ?? 0);
+  const resources = new Map<number, Uint8Array>();
+  const base64 = plan ? Object.freeze({ resourceId: 1, decodedByteLength: plan.decodedByteLength,
+    tailByteLength: plan.tailByteLength, encodedByteLength: plan.encodedByteLength, byteLength: plan.byteLength }) : undefined;
+  if (plan) resources.set(1, copyBase64UploadCheckpoint(plan));
+  return new IIPActiveCheckpoint(Object.freeze({ ...state, headerParser, header: copiedHeader, headerByteLength,
+    base64, byteLength: plan?.byteLength ?? 0,
+    resources: Object.freeze([...resources].map(([id, bytes]) => Object.freeze({ id, byteLength: bytes.byteLength })))
+  }), resources);
+}
+
+export function prepareIIPActiveCheckpoint(
+  checkpoint: IIPActiveCheckpoint, maxEncodedBytes: number, initialBytes: number, storageBytes: number
+): { state: IIIPActiveState; parser: HeaderParser; header: IHeaderFields; decoder?: Base64Decoder } {
+  if (checkpoint.isDisposed) throw new Error('Active IIP checkpoint lease is disposed');
+  const supplied = checkpoint.metadata;
+  const state: IIIPActiveState = Object.freeze({ aborted: supplied.aborted, isMultipart: supplied.isMultipart,
+    abortMulti: supplied.abortMulti, multipartEncodedSize: supplied.multipartEncodedSize });
+  const parser = new HeaderParser();
+  parser.restoreCheckpoint(supplied.headerParser);
+  const header = prepareFileHeader(supplied.header);
+  const headerByteLength = supplied.headerParser.byteLength + supplied.header.byteLength;
+  if (supplied.headerByteLength !== headerByteLength || headerByteLength > IIP_HEADER_CHECKPOINT_BYTES
+    || ![state.aborted, state.isMultipart, state.abortMulti].every(flag => typeof flag === 'boolean')
+    || !Number.isSafeInteger(state.multipartEncodedSize) || state.multipartEncodedSize < 0) {
+    throw new Error('Invalid IIP active checkpoint state');
+  }
+  const base64 = supplied.base64 ? Object.freeze({ ...supplied.base64 }) : undefined;
+  if (!Array.isArray(supplied.resources) || supplied.resources.length > 1) throw new Error('Invalid IIP active resource count');
+  const descriptors = supplied.resources.map(r => ({ id: r.id, byteLength: r.byteLength }));
+  const live = (state.isMultipart && !state.abortMulti)
+    || (!state.aborted && parser.state === HeaderState.END && parser.fields.type === SequenceType.FILE);
+  if (live !== Boolean(base64)) throw new Error('Invalid IIP active decoder ownership');
+  if (!base64) {
+    if (supplied.byteLength !== 0 || descriptors.length) throw new Error('Invalid IIP active resource length');
+    return { state, parser, header };
+  }
+  if (base64.resourceId !== 1 || supplied.byteLength !== base64.byteLength || descriptors.length !== 1
+    || descriptors[0].id !== 1 || descriptors[0].byteLength !== base64.byteLength
+    || (state.isMultipart && state.multipartEncodedSize > base64.encodedByteLength)) {
+    throw new Error('Invalid IIP active decoder counters');
+  }
+  validateBase64UploadCheckpoint(checkpoint, base64, maxEncodedBytes);
+  if (maxEncodedBytes + 131072 > storageBytes) throw new RangeError('Active IIP checkpoint exceeds decoder capacity budget');
+  const decoder = new Base64Decoder(0, maxEncodedBytes, initialBytes);
+  restoreBase64UploadCheckpoint(checkpoint, base64, decoder);
+  return { state, parser, header, decoder };
+}
