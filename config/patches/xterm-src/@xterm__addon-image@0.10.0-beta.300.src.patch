+ * @license MIT
+ */
+
+import Base64Decoder from 'xterm-wasm-parts/lib/base64/Base64Decoder.wasm';
+import Base64Encoder from 'xterm-wasm-parts/lib/base64/Base64Encoder.wasm';
+import { ImageCheckpointResources, CHECKPOINT_CHUNK_BYTES, CHECKPOINT_LEASE_BYTES } from './ImageCheckpointResources';
+
+export interface IBase64UploadCheckpoint {
+  readonly resourceId: number;
+  readonly decodedByteLength: number;
+  readonly tailByteLength: number;
+  readonly encodedByteLength: number;
+  readonly byteLength: number;
+}
+
+export interface IBase64UploadPlan extends Omit<IBase64UploadCheckpoint, 'resourceId'> {
+  readonly decoded: Uint8Array;
+  readonly tail: Uint8Array;
+  readonly carrySource?: Uint8Array;
+}
+
+function decoderArrays(value: unknown): { data: Uint8Array; states: Uint32Array } {
+  if (!value || typeof value !== 'object'
+    || !('_d' in value) || !(value._d instanceof Uint8Array)
+    || !('_m32' in value) || !(value._m32 instanceof Uint32Array)
+    || !('_ended' in value) || value._ended !== false
+    || value._d.buffer !== value._m32.buffer || value._d.byteOffset !== 5152
+    || value._m32.byteOffset !== 0 || value._m32.length < 1283) {
+    throw new Error('Unsupported pending Base64 decoder layout');
+  }
+  return { data: value._d, states: value._m32 };
+}
+
+export function planBase64UploadCheckpoint(decoder: Base64Decoder, encodedByteLength: number): IBase64UploadPlan {
+  // The pinned decoder mixes a decoded prefix and lazy ASCII tail in one WASM allocation.
+  const { data, states } = decoderArrays(decoder);
+  const loaded = states[1280];
+  const processed = states[1281];
+  const decoded = states[1282];
+  if (!Number.isSafeInteger(encodedByteLength) || encodedByteLength < 0 || encodedByteLength > loaded
+    || loaded !== decoder.loadedBytes || loaded > decoder.maxBytes || loaded > data.byteLength
+    || processed > loaded || processed % 4 !== 0 || decoded * 4 !== processed * 3
+    || decoded !== decoder.data8.byteLength || loaded - processed > 131075) {
+    throw new Error('Invalid pending Base64 decoder state');
+  }
+  const decodedByteLength = encodedByteLength < processed ? Math.floor(encodedByteLength / 4) * 3 : decoded;
+  const tailByteLength = encodedByteLength < processed ? encodedByteLength % 4 : encodedByteLength - processed;
+  return {
+    decodedByteLength, tailByteLength, encodedByteLength, byteLength: decodedByteLength + tailByteLength,
+    decoded: data.subarray(0, decodedByteLength),
+    tail: encodedByteLength < processed ? data.subarray(0, 0) : data.subarray(processed, encodedByteLength),
+    carrySource: encodedByteLength < processed && tailByteLength ? data.subarray(decodedByteLength, decodedByteLength + 3) : undefined
+  };
+}
+
+export function copyBase64UploadCheckpoint(plan: IBase64UploadPlan): Uint8Array {
+  const bytes = new Uint8Array(plan.byteLength);
+  bytes.set(plan.decoded);
+  if (plan.carrySource) {
+    const encoder = new Base64Encoder(0);
+    try {
+      bytes.set(encoder.encode(plan.carrySource).subarray(0, plan.tailByteLength), plan.decodedByteLength);
+    } finally {
+      encoder.release();
+    }
+  } else {
+    bytes.set(plan.tail, plan.decodedByteLength);
+  }
+  return bytes;
+}
+
+export function validateBase64UploadCheckpoint<T>(
+  lease: ImageCheckpointResources<T>, metadata: IBase64UploadCheckpoint, maxEncodedBytes: number
+): void {
+  if (lease.isDisposed) throw new Error('Image checkpoint lease is disposed');
+  const { decodedByteLength, tailByteLength, encodedByteLength, byteLength } = metadata;
+  if (![decodedByteLength, tailByteLength, encodedByteLength, byteLength].every(n => Number.isSafeInteger(n) && n >= 0)
+    || decodedByteLength % 3 !== 0 || tailByteLength > 131075
+    || encodedByteLength !== decodedByteLength / 3 * 4 + tailByteLength
+    || encodedByteLength > maxEncodedBytes || byteLength !== decodedByteLength + tailByteLength
+    || byteLength > CHECKPOINT_LEASE_BYTES || lease.getResourceByteLength(metadata.resourceId) !== byteLength) {
+    throw new RangeError('Pending image checkpoint exceeds payload limit or has invalid lengths');
+  }
+}
+
+export function restoreBase64UploadCheckpoint<T>(
+  lease: ImageCheckpointResources<T>, metadata: IBase64UploadCheckpoint, decoder: Base64Decoder
+): void {
+  validateBase64UploadCheckpoint(lease, metadata, decoder.maxBytes);
+  const encoder = new Base64Encoder(0);
+  try {
+    decoder.init();
+    const decodedChunk = Math.floor(CHECKPOINT_CHUNK_BYTES / 4) * 3;
+    for (let offset = 0; offset < metadata.decodedByteLength; offset += decodedChunk) {
+      const bytes = lease.readResource(metadata.resourceId, offset, Math.min(decodedChunk, metadata.decodedByteLength - offset));
+      if (Number(decoder.put(encoder.encode(bytes))) !== 0) throw new Error('Invalid restored Base64 prefix');
+    }
+    for (let offset = 0; offset < metadata.tailByteLength; offset += CHECKPOINT_CHUNK_BYTES) {
+      const bytes = lease.readResource(metadata.resourceId, metadata.decodedByteLength + offset,
+        Math.min(CHECKPOINT_CHUNK_BYTES, metadata.tailByteLength - offset));
+      if (Number(decoder.put(bytes)) !== 0) throw new Error('Invalid restored Base64 tail');
+    }
+    if (lease.isDisposed || decoder.loadedBytes !== metadata.encodedByteLength) throw new Error('Pending image checkpoint changed during restoration');
+  } catch (error) {
+    decoder.release();
+    throw error;
+  } finally {
+    encoder.release();
+  }
+}
+
+export function checkUploadCheckpointBudget(maxBytes: number, byteLength: number): void {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 0 || maxBytes > CHECKPOINT_LEASE_BYTES || byteLength > maxBytes) {
+    throw new RangeError('Pending image checkpoint exceeds byte budget');
+  }
+}
