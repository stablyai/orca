+  return fields;
+}
+function isHeaderState(value: unknown): value is HeaderState {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 0 && value <= 4;
+}
+function isSequenceType(value: unknown): value is SequenceType {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 0 && value <= 5;
+}
+export function captureHeaderParser(
+  state: HeaderState, buffer: Uint32Array, key: string, fields: Record<string, HeaderValue>
+): IHeaderParserCheckpoint {
+  const copiedFields = captureHeaderFields(fields);
+  const byteLength = copiedFields.byteLength + checkedPoints(buffer) + checkedString(key);
+  if (byteLength > IIP_HEADER_CHECKPOINT_BYTES) throw new RangeError('IIP parser checkpoint exceeds header budget');
+  return Object.freeze({ state, buffer: Object.freeze(Array.from(buffer)), key, fields: copiedFields, byteLength });
+}
+export function prepareHeaderParser(snapshot: IHeaderParserCheckpoint): {
+  state: HeaderState; buffer: Uint32Array; key: string; fields: Record<string, HeaderValue>
+} {
+  if (!isHeaderState(snapshot.state) || !Array.isArray(snapshot.buffer)) throw new Error('Invalid IIP header parser state');
+  const bytes = checkedPoints(snapshot.buffer) + checkedString(snapshot.key);
+  const fields = restoreHeaderFields(snapshot.fields);
+  const byteLength = snapshot.fields.byteLength + bytes;
+  if (snapshot.byteLength !== byteLength || byteLength > IIP_HEADER_CHECKPOINT_BYTES) throw new Error('Invalid IIP header parser length');
+  return { state: snapshot.state, buffer: new Uint32Array(snapshot.buffer), key: snapshot.key, fields };
+}
+export function prepareFileHeader(snapshot: IHeaderFieldsCheckpoint): IHeaderFields {
+  const fields = restoreHeaderFields(snapshot);
+  const { type, name, size, width, height, preserveAspectRatio, inline } = fields;
+  if (!isSequenceType(type) || typeof name !== 'string' || typeof size !== 'number'
+    || (width !== undefined && typeof width !== 'string') || (height !== undefined && typeof height !== 'string')
+    || (preserveAspectRatio !== undefined && typeof preserveAspectRatio !== 'number')
+    || (inline !== undefined && typeof inline !== 'number')) throw new Error('Invalid IIP file header');
+  return { type, name, size, width, height, preserveAspectRatio, inline };
+}
