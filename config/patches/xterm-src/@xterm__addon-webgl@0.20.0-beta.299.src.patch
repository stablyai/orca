new file mode 100644
index 0000000000000000000000000000000000000000..8a87eea52ce780fa92de8e1f31ec41f40a337776
--- /dev/null
+++ b/src/ImageLayerRenderer.ts
@@ -0,0 +1,186 @@
+/**
+ * Copyright (c) 2026 The xterm.js authors. All rights reserved.
+ * @license MIT
+ */
+import type { IDimensions } from 'browser/renderer/shared/Types';
+import type { IImageDraw, IWebGL2RenderingContext } from './Types';
+import { Disposable, toDisposable } from 'common/Lifecycle';
+import type { ILogService } from 'common/services/Services';
+import { createProgram } from './WebglUtils';
+
+const VERTEX_SHADER = `#version 300 es
+layout(location=0) in vec2 a_position;
+layout(location=1) in vec2 a_uv;
+out vec2 v_uv;
+void main() { gl_Position = vec4(a_position, 0.0, 1.0); v_uv = a_uv; }`;
+const FRAGMENT_SHADER = `#version 300 es
+precision mediump float;
+uniform sampler2D u_image;
+in vec2 v_uv;
+out vec4 outColor;
+void main() { outColor = texture(u_image, v_uv); }`;
+
+// Negative image textures are an additional bounded cache of visible sources.
+const TEXTURE_LIMIT = 32 * 1024 * 1024;
+const TEXTURE_COUNT_LIMIT = 4096;
+
+type ImageSource = IImageDraw['source'];
+type ImageTile = { texture: WebGLTexture; x: number; y: number; width: number; height: number };
+type TextureEntry = { tiles: ImageTile[]; bytes: number };
+
+export class ImageLayerRenderer extends Disposable {
+  private readonly _program: WebGLProgram;
+  private readonly _vertices: WebGLBuffer;
+  private readonly _textures = new Map<ImageSource, TextureEntry>();
+  private readonly _seen = new Set<ImageSource>();
+  private _textureBytes = 0;
+  private _textureCount = 0;
+  private readonly _quad = new Float32Array(16);
+  private readonly _maxTextureSize: number;
+  private readonly _bindVao: () => void;
+
+  constructor(private readonly _gl: IWebGL2RenderingContext, logService: ILogService) {
+    super();
+    const program = createProgram(_gl, VERTEX_SHADER, FRAGMENT_SHADER, logService);
+    const vertices = _gl.createBuffer();
+    const vao = _gl.createVertexArray();
+    if (!program || !vertices || !vao) {
+      if (program) _gl.deleteProgram(program);
+      if (vertices) _gl.deleteBuffer(vertices);
+      if (vao) _gl.deleteVertexArray(vao);
+      throw new Error('Unable to create inline image renderer');
+    }
+    this._program = program;
+    this._vertices = vertices;
+    this._maxTextureSize = _gl.getParameter(_gl.MAX_TEXTURE_SIZE);
+    _gl.bindVertexArray(vao);
+    _gl.bindBuffer(_gl.ARRAY_BUFFER, vertices);
+    _gl.enableVertexAttribArray(0);
+    _gl.enableVertexAttribArray(1);
+    _gl.vertexAttribPointer(0, 2, _gl.FLOAT, false, 16, 0);
+    _gl.vertexAttribPointer(1, 2, _gl.FLOAT, false, 16, 8);
+    this._bindVao = () => _gl.bindVertexArray(vao);
+    this._register(toDisposable(() => {
+      for (const entry of this._textures.values()) this._deleteEntry(entry);
+      this._textures.clear();
+      this._seen.clear();
+      _gl.deleteVertexArray(vao);
+      _gl.deleteBuffer(vertices);
+      _gl.deleteProgram(program);
+    }));
+  }
+
+  public render(draws: readonly IImageDraw[], behindBackground: boolean, viewport: IDimensions): void {
+    const gl = this._gl;
+    gl.useProgram(this._program);
+    this._bindVao();
+    gl.bindBuffer(gl.ARRAY_BUFFER, this._vertices);
+    gl.activeTexture(gl.TEXTURE0);
+    gl.uniform1i(gl.getUniformLocation(this._program, 'u_image'), 0);
+    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
+    try {
+      for (const draw of draws) {
+        if (draw.behindCellBackground !== behindBackground) continue;
+        const entry = this._textureFor(draw.source);
+        if (!entry) continue;
+        this._seen.add(draw.source);
+        const [sx, sy, sw, sh] = draw.sourceRect;
+        const [dx, dy, dw, dh] = draw.targetRect;
+        for (const tile of entry.tiles) {
+          const left = Math.max(sx, tile.x);
+          const top = Math.max(sy, tile.y);
+          const right = Math.min(sx + sw, tile.x + tile.width);
+          const bottom = Math.min(sy + sh, tile.y + tile.height);
+          if (left >= right || top >= bottom) continue;
+          gl.bindTexture(gl.TEXTURE_2D, tile.texture);
+          const x = (dx + (left - sx) / sw * dw) / viewport.width * 2 - 1;
+          const y = 1 - (dy + (top - sy) / sh * dh) / viewport.height * 2;
+          const xr = x + (right - left) / sw * dw / viewport.width * 2;
+          const yb = y - (bottom - top) / sh * dh / viewport.height * 2;
+          const u = (left - tile.x) / tile.width;
+          const v = (top - tile.y) / tile.height;
+          const ur = (right - tile.x) / tile.width;
+          const vb = (bottom - tile.y) / tile.height;
+          this._quad.set([x, y, u, v, x, yb, u, vb, xr, y, ur, v, xr, yb, ur, vb]);
+          gl.bufferData(gl.ARRAY_BUFFER, this._quad, gl.DYNAMIC_DRAW);
+          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        }
+      }
+    } finally {
+      gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
+      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, 0);
+    }
+  }
+
+  public endFrame(): void {
+    for (const [source, entry] of this._textures) {
+      if (!this._seen.has(source)) {
+        this._deleteEntry(entry);
+        this._textures.delete(source);
+      }
+    }
+    this._seen.clear();
+  }
+
+  private _deleteEntry(entry: TextureEntry): void {
+    for (const tile of entry.tiles) this._gl.deleteTexture(tile.texture);
+    this._textureBytes -= entry.bytes;
+    this._textureCount -= entry.tiles.length;
+  }
+
+  private _textureFor(source: ImageSource): TextureEntry | undefined {
+    const existing = this._textures.get(source);
+    if (existing) return existing;
+    const bytes = source.width * source.height * 4;
+    const count = Math.ceil(source.width / this._maxTextureSize) * Math.ceil(source.height / this._maxTextureSize);
+    if (!bytes || bytes > TEXTURE_LIMIT || count > TEXTURE_COUNT_LIMIT) return;
+    while (this._textureCount + count > TEXTURE_COUNT_LIMIT || this._textureBytes + bytes > TEXTURE_LIMIT) {
+      const victim = [...this._textures].find(([image]) => !this._seen.has(image));
+      if (!victim) return;
+      this._deleteEntry(victim[1]);
+      this._textures.delete(victim[0]);
+    }
+    const gl = this._gl;
+    const tiles: ImageTile[] = [];
+    // Long, thin sources can exceed a GPU's dimension limit while fitting the byte budget.
+    const crop = count > 1 ? document.createElement('canvas') : undefined;
+    try {
+      for (let y = 0; y < source.height; y += this._maxTextureSize) {
+        for (let x = 0; x < source.width; x += this._maxTextureSize) {
+          const width = Math.min(source.width - x, this._maxTextureSize);
+          const height = Math.min(source.height - y, this._maxTextureSize);
+          let upload: ImageSource = source;
+          if (crop) {
+            crop.width = width;
+            crop.height = height;
+            const context = crop.getContext('2d');
+            if (!context) throw new Error('Unable to crop inline image texture');
+            context.drawImage(source, x, y, width, height, 0, 0, width, height);
+            upload = crop;
+          }
+          const texture = gl.createTexture();
+          if (!texture) throw new Error('Unable to allocate inline image texture');
+          tiles.push({ texture, x, y, width, height });
+          gl.bindTexture(gl.TEXTURE_2D, texture);
+          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, 1);
+          gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, 0);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, upload);
+        }
+      }
+    } catch {
+      for (const tile of tiles) gl.deleteTexture(tile.texture);
+      return;
+    } finally {
+      if (crop) { crop.width = 0; crop.height = 0; }
+    }
+    const entry = { tiles, bytes };
+    this._textures.set(source, entry);
+    this._textureBytes += bytes;
+    this._textureCount += tiles.length;
+    return entry;
+  }
+}
