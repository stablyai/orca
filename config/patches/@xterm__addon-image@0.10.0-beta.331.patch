able {\n  private _aborted = false;\n  private _generation = 0;\n  private _inFlightDecodes = 0;\n  private _activeDecodeCount = 0;\n  private readonly _pendingDecodes: IPendingPngDecode[] = [];\n  private readonly _fileReads: Set<AbortController> = new Set();\n  private _decodeError = false;\n\n  private _activeDecoder: Base64Decoder | null = null;\n  private readonly _idleDecoders: Base64Decoder[] = [];\n  private readonly _contentCache: Map<string, IContentCacheEntry> = new Map();\n  private _contentCacheBytes = 0;\n  private readonly _maxEncodedBytes: number;\n  private readonly _initialEncodedBytes: number;\n\n  // Streaming related states\n\n  // True while receiving control data (before semicolon).\n  private _inControlData = true;\n\n  // Buffer for control data.\n  private _controlData = new Uint32Array(Constants.MAX_CONTROL_DATA_SIZE);\n  private _controlLength = 0;\n\n  // Pre-calculated encoded size limit\n  private _encodedSizeLimit = 0;\n  private _totalEncodedSize = 0;\n\n  // Parsed command. These are the control data before semicolon.\n  private _parsedCommand: IKittyCommand | null = null;\n\n  // Storage related states\n\n  private _pendingTransmissions: Map<number, IPendingTransmission> = new Map();\n  // Tracks the pending key of the most recently started chunked upload.\n  // Per spec, subsequent chunks only need m= (and optionally q=), without i=.\n  // When a chunk arrives with no i=, this key is used to find the pending upload.\n  private _lastPendingKey: number | undefined;\n\n  constructor(\n    private readonly _opts: IImageAddonOptions,\n    private readonly _renderer: ImageRenderer,\n    private readonly _kittyStorage: KittyImageStorage,\n    private readonly _coreTerminal: ITerminalExt\n  ) {\n    // Convert decoded size limit -> max encoded bytes.\n    this._maxEncodedBytes = Math.ceil(this._opts.kittySizeLimit * 4 / 3);\n    this._initialEncodedBytes = Math.min(Constants.DECODER_INITIAL_DATA, this._maxEncodedBytes);\n    this._kittyStorage.onWipeAlternate = () => this._clearContentCache('alternate');\n    this._kittyStorage.onStorageImageDeleted = (storageId: number) => {\n      for (let i = this._pendingDecodes.length - 1; i >= 0; --i) {\n        if (this._pendingDecodes[i].storageId === storageId) {\n          this._pendingDecodes.splice(i, 1);\n        }\n      }\n    };\n  }\n\n  public get isDecoding(): boolean {\n    return this._inFlightDecodes > 0 || this._pendingDecodes.length > 0 || this._pendingTransmissions.size > 0;\n  }\n\n  private _acquireDecoder(): Base64Decoder {\n    const reused = this._idleDecoders.pop();\n    if (reused) {\n      reused.init();\n      return reused;\n    }\n    const created = new Base64Decoder(Constants.DECODER_KEEP_DATA, this._maxEncodedBytes, this._initialEncodedBytes);\n    created.init();\n    return created;\n  }\n\n  private _recycleDecoder(decoder: Base64Decoder): void {\n    decoder.release();\n    if (this._idleDecoders.length < 2) {\n      this._idleDecoders.push(decoder);\n    }\n  }\n\n  private _releaseContentEntry(entry: IContentCacheEntry): void {\n    entry.refs = Math.max(0, entry.refs - 1);\n    if (entry.refs === 0) {\n      entry.bitmap.close();\n    }\n  }\n\n  private _clearContentCache(bufferType?: 'alternate' | 'normal'): void {\n    for (const [k, entry] of [...this._contentCache.entries()]) {\n      if (bufferType && entry.bufferType !== bufferType) continue;\n      this._contentCache.delete(k);\n      this._contentCacheBytes = Math.max(0, this._contentCacheBytes - entry.byteSize);\n      this._releaseContentEntry(entry);\n    }\n  }\n\n  private _storeInContentCache(\n    rawBytes: Uint8Array,\n    bitmap: ImageBitmap,\n    bufferType: 'alternate' | 'normal'\n  ): { bitmap: ImageBitmap; onRelease: () => void } | undefined {\n    if (rawBytes.byteLength === 0 || rawBytes.byteLength > MAX_CONTENT_CACHE_ITEM_BYTES) {\n      return undefined;\n    }\n    const key = hashPngBytes(rawBytes);\n    const existing = this._contentCache.get