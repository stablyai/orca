 const isCurrent = (): boolean => generation === this._generation && this._kittyStorage.getImage(image.id) === image;\n    let bitmap: ImageBitmap | undefined;\n    try {\n      bitmap = await this._createBitmap(image);\n      if (!isCurrent()) throw new Error('image decode canceled');\n      const cropped = this._cropImage(bitmap, cmd);\n      bitmap = cropped instanceof Promise ? await cropped : cropped;\n\n      const cw = this._renderer.dimensions?.css.cell.width || CELL_SIZE_DEFAULT.width;\n      const ch = this._renderer.dimensions?.css.cell.height || CELL_SIZE_DEFAULT.height;\n      const { cols, rows } = this._placementGrid(bitmap, cmd, cw, ch);\n\n      if (bitmap.width * bitmap.height > this._opts.pixelLimit) {\n        throw new Error('image exceeds pixel limit');\n      }\n\n      if (!isCurrent()) throw new Error('image decode canceled');\n      this._kittyStorage.addVirtualPlacement(image.id, cmd.placementId ?? 0, bitmap, cols, rows);\n      bitmap = undefined;  // ownership transferred to storage\n      if (replaces) this._kittyStorage.discardVirtualPlacements(image.id, cmd.placementId ?? 0);\n      return true;\n    } catch {\n      bitmap?.close();\n      if (replaces && isCurrent()) this._kittyStorage.discardVirtualPlacements(image.id);\n      return false;\n    }\n  }\n\n  // Create ImageBitmap from already-decoded image data.\n  private async _createBitmap(image: IKittyImageData): Promise<ImageBitmap> {\n    let bytes: Uint8Array = new Uint8Array(await image.data.arrayBuffer());\n\n    if (image.compression === KittyCompression.ZLIB) {\n      bytes = await this._decompressZlib(bytes);\n    }\n\n    if (image.format === KittyFormat.PNG) {\n      const metrics = imageType(bytes);\n      // IHDR dimensions are parsed with signed shifts, so a value >= 0x80000000 comes\n      // back negative and a bare `>` pixel-limit test passes it; require positive.\n      if (metrics.mime !== 'image/png' || !(metrics.width > 0) || !(metrics.height > 0) || metrics.