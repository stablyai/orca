ease;\n    this._enforceDecodedBitmapBudget(kittyId);\n  }\n\n  public retainDecodedBitmap(kittyId: number): IKittyBitmapLease | undefined {\n    const image = this._images.get(kittyId);\n    const holder = image?.decodedHolder;\n    if (!image || !holder) {\n      return undefined;\n    }\n    this._images.delete(kittyId);\n    this._images.set(kittyId, image);\n    holder.refs += 1;\n    image.decodedRefs = holder.refs;\n    let released = false;\n    return {\n      bitmap: holder.bitmap,\n      onRelease: () => {\n        if (released) return;\n        released = true;\n        this._releaseDecodedHolder(holder);\n      }\n    };\n  }\n\n  private _enforceDecodedBitmapBudget(keepKittyId?: number): void {\n    const budgetBytes = Math.min(KittyImageStorage._maxDecodedCacheBytes, this._storage.getLimit() * 1000000);\n    let totalBytes = 0;\n    for (const img of this._images.values()) {\n      if (img.decodedBitmap) {\n        totalBytes += img.decodedByteSize ?? (img.decodedBitmap.width * img.decodedBitmap.height * 4);\n      }\n    }\n    if (totalBytes <= budgetBytes) return;\n    for (const [id, img] of this._images) {\n      if (totalBytes <= budgetBytes) break;\n      if (id === keepKittyId || !img.decodedBitmap) continue;\n      if (this._kittyIdToStorageId.has(id)) continue;\n      totalBytes -= img.decodedByteSize ?? (img.decodedBitmap.width * img.decodedBitmap.height * 4);\n      this._releaseImageDecodedCache(img);\n    }\n  }\n\n  public wipeAlternate(): void {\n    let removed = false;\n    for (const image of this._images.values()) {\n      if (image.decodedBitmap && image.decodedBufferType === 'alternate') {\n        this._releaseImageDecodedCache(image);\n        removed = true;\n      }\n    }\n    this.onWipeAlternate?.();\n    if (removed && !this.hasRetainedImages) {\n      this._renderer.refreshAll();\n    }\n  }\n\n  public reset(): void {\n    this._nextImageId = 1;\n    for (const image of this._images.values()) {\n      this._releaseImage