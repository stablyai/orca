      "id": "terminal-provider.ssh-remote-reattach-contract",
      "title": "SSH restore and remote-runtime recovery preserve live terminal ownership",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "terminal-provider",
      "layer": "provider-contract",
      "surfaces": [
