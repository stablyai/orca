      ],
      "demotionRule": "Demote or quarantine if the fault harness flakes without a product or harness bug, if healthy operation exceeds one runtime watcher child, if total physical operation exceeds eight children including retiring generations, if quarantine children outlive their roots or repeat after fusing, if event delivery becomes unbounded, or if metadata/stat work returns to the serve process."
    },
    {
      "id": "terminal-input.plugin-explicit-worktree-routing",
      "title": "Plugin terminal input stays inside the freshly resolved worktree",
      "maturity": "experimental",
      "protection": "none",
      "owner": "plugin-platform",
      "layer": "main-relay-contract",
      "surfaces": [
        "plugin host API terminal input",
        "active worktree resolution",
        "provider terminal inventory",
        "relay capability enforcement"
      ],
      "platforms": ["macos", "linux", "windows"],
      "providers": ["local", "daemon", "ssh", "wsl", "remote-runtime", "mobile-relay"],
      "coveredPlatforms": [],
      "coveredProviders": [],
      "coverageNotes": "Audit1678 removes low-value test projections, mock wiring, private-state assertions, inventories and duplicate examples without equivalent replacement coverage. Per-source reviews record retained public behavior and refusal boundaries with injected/native/remote limits. Affected historical receipts are retired; gates without active current evidence are downgraded. Historical scope before this audit: Deterministic macOS contract evidence covers opaque local- and SSH-shaped terminal ids, one bounded worktree listing, mismatch rejection, and the main/relay host-call adapter matrix. It does not launch a live PTY or provision a relay-hosted plugin.",
