    {
      "id": "terminal-input.agent-prompt-injection",
      "title": "Orchestration agent prompts arrive as bracketed paste before submit",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "terminal-input",
      "layer": "runtime-contract-and-cli-repro",
      "surfaces": [
