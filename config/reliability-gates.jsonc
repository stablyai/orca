        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/client-context.test.ts\",\n          \"assertions\": [\n            \"a retired close-on-release owner closes an ownerless manual reconnect\",\n            \"a Relay recovery path change rerenders observers without a transport-state change\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/host-open-recovery.test.tsx\",\n          \"assertions\": [\n            \"catalog, missing-host, and construction failures retry without remounting\",\n            \"final release and forget prevent later client publication\",\n            \"refresh bypasses a never-settling stale open and stale failure cannot clobber its replacement\",\n            \"revival expedites recovery without resetting the failure tier\",\n            \"a retired owner's release cannot cancel a newer owner's open\",\n            \"explicit reconnect demand survives a pre-client failure\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/rpc-session-liveness-watchdog.test.ts\",\n          \"assertions\": [\n            \"does not reuse a probe id after the same identity starts a new generation\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/rpc-session-liveness-integration.test.ts\",\n          \"assertions\": [\n            \"upgrades a focus probe on resume without letting repeated nudges extend the deadline\",\n            \"reconnects when control probes stall while terminal and browser traffic continues\",\n            \"ignores superseded probes and unrelated RPC replies during a control check\",\n            \"does not let probe replies consume the authentication retry budget\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/mobile-relay-rpc-session.test.ts\",\n          \"assertions\": [\n            \"releases stream listeners on failure even when close follows it\",\n            \"connects when an older runtime rejects capability negotiation\",\n            \"connects when the relay never answers capability negotiation\",\n            \"rejects a mismatched outer credential version and closes the physical link\",\n            \"routes terminal and browser binary streams after confirmation\",\n            \"keeps the configured connect default for omitted options and honors explicit timeouts\",\n            \"rejects pending RPC work when the physical link fails\",\n            \"releases requests waiting on a failed session once it is retired, unsent\",\n            \"keeps a synchronous pre-write relay failure definite\",\n            \"marks in-flight requests delivery-unknown when the session closes\",\n            \"marks a relay RPC timeout delivery-unknown\",\n            \"sends a server workspace call as the same top-level executionHost frame as before the envelope\",\n            \"merges an envelope under the transport fields on requests, subscribes and unsubscribes\",\n            \"carries captured GitHub authority through the production relay physical await without replay\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/mobile-relay-rpc-session-liveness.test.ts\",\n          \"assertions\": [\n            \"keeps availability returns tolerant while a proven resume bypasses recent probes\",\n            \"probes an idle relay and closes it when the probes go unanswered\",\n            \"keeps an idle relay open while a slow reply is still downloading\",\n            \"closes a silent relay even while requests keep going unanswered\",\n            \"keeps an idle relay open while a stream backlog delays the probe reply\"\n          ]\n        }",
        "Audit2003 historical original assertionRefs object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n{\n          \"file\": \"mobile/src/transport/stable-logical-rpc-client.test.ts\",\n          \"assertions\": [\n            \"makes before break, rejects in-flight work, and replays subscriptions\",\n            \"keeps replies that commit before cutover and carries viewport state into replay\",\n            \"suspends one physical session and replays subscriptions on foreground replacement\",\n            \"reports requests the suspended session never sent as suspended, and written ones as ambiguous\",\n            \"preserves delivery ambiguity without replaying a mutation after relay replacement\",\n            \"lets the physical close settle in-flight requests on close, keeping pre-write failures definite\",\n            \"preserves a committed response when logical close wins the callback race\",\n            \"publishes the replacement dial phases while the client is suspended\",\n            \"forwards a reconnecting phase published by the dialing session itself\",\n            \"names a relay dial started from reconnecting without disturbing the state\",\n            \"publishes recovery-path changes and keeps Relay pending between failed dials\",\n            \"does not revive a stale recovery path after a connection later drops\",\n            \"drops the pending path when the previous session recovers mid-dial\",\n            \"never downgrades a live session while a make-before-break replacement dials\",\n            \"restores disconnected when a dial it was narrating fails\",\n            \"outlives the flat bound when the relay cell holds the dial\",\n            \"closes a replacement that fails authentication and preserves the active session\",\n            \"drops a stream event that lands after the caller unsubscribed\"\n          ]\n        }",
        "Audit2003 historical original coveredPlatforms object, preserved verbatim; retired objects are not active execution evidence or replacement coverage:\n[\"macos\", \"linux\"]",
