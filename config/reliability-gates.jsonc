      "id": "terminal-input.cooked-reply-queue",
      "title": "Terminal query replies stay atomic and bounded without evicting ordinary input",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "terminal-runtime",
      "layer": "renderer-provider-contract",
      "surfaces": [
