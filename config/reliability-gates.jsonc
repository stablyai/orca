            "source retention charges max UTF-8 or UTF-16 storage plus one record",
            "fragmented multi-PTY source, charged-byte, and frame caps bind independently"
          ]
        },
        {
          "file": "src/relay/pty-source-credit-scheduler.test.ts",
          "assertions": [
