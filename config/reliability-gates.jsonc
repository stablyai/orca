    {
      "id": "agent-session.completed-turn-duration",
      "title": "Completed turn duration survives client recovery and history pagination",
      "maturity": "experimental",
      "protection": "none",
      "owner": "agent-session-runtime",
      "layer": "shared-and-renderer-unit",
      "surfaces": ["native chat", "structured agent history", "structured agent subscriptions"],
      "platforms": ["macos", "linux", "windows"],
      "providers": ["local", "ssh", "remote-runtime", "mobile"],
      "coveredPlatforms": [],
      "coveredProviders": [],
      "coverageNotes": "Audit1348 intentionally deletes or reduces the listed sources. No fresh execution result validates their reduced selectors. Historical coverage account: Deterministic provider, journal recovery, RPC projection and shared renderer tests run on macOS. Shared logic serves desktop and mobile; these tests do not prove native mobile or real SSH transport. Local/daemon PTY input, geometry and WSL process launch are unaffected. Test-value audit1293 removes src/main/runtime/rpc/methods/structured-agent-session-turn-item-capability.test.ts (5 authored cases), src/main/codex/codex-structured-journal-translation-turn-lifecycle.test.ts (2 authored cases). Their isolated assertions no longer run; surviving tests are not claimed as equivalent coverage. Fresh execution against the candidate SHA is required. Audit1348: src/main/codex/structured/turns/codex-requested-close-turn-timing.test.ts removed. Requested/unexpected close event timing/fence metadata after a hand-supplied refused terminal receipt. No equivalent replacement coverage is claimed.",
      "motivatingLinks": ["https://github.com/stablyai/orca/pull/19695"],
      "invariant": "An observed completed turn retains the same host-recorded duration and initiating user-message attribution through client reload, settlement retry and loading older history; older clients receive the compatible item carrier, and a host-recorded unknown duration suppresses local estimates.",
      "oracle": "No current automated execution oracle is claimed for this gate after Audit1348 retired changed-source receipts. Historical oracle account: Render a host-settled duration without observing completion locally; preserve an exit at 2000 through failed settlement at 60000 and later retry; retain a seven-second older turn beyond 256 submitted turns; prune aliases with removed user items and preserve alias identity during item-only streaming; render no completed duration for an unverifiable turn both before and after client reload.",
      "commands": [],
      "testFiles": [],
      "assertionRefs": [],
      "evidenceRuns": [],
      "runtimeBudget": {
        "p95Seconds": 30,
        "scope": "Historical prior-selector budget; reduced selector has no new runtime measurement."
      },
      "flakeHistory": {
        "status": "not-started",
        "evidence": "Audit1348 retired changed-source receipts; reduced selector has no new soak result. Historical account: No CI soak history for this combined gate."
      },
      "redGreenEvidence": {
        "status": "missing",
        "evidence": "Audit1348 changed referenced test sources; no new red/green validation. Historical account: Before fixes, failed settlement stored 60000 instead of observed 2000 and older-page duration was undefined instead of seven seconds after 257 submissions. Mounted unverifiable recovery also displayed a local 59 seconds versus no duration after reload, including an older-host row without a start; the focused regressions pass after fixes."
      },
      "performanceBudget": {
        "required": true,
        "evidence": "Historical budget only after Audit1348 changed test sources; no new measurement. Previous account: No polling, process fanout or new timer. Alias retention follows loaded user items plus 256 recent records; lookup uses a Set, removal/reset prunes aliases, and item-only stream batches retain the submission array identity."
      },
      "knownGaps": [
        "This deterministic gate does not launch Electron or prove a full app restart; exact-head manual screenshots are separate PR evidence.",
        "Native mobile, live SSH/relay transport and Windows/Linux execution are not exercised by this command.",
