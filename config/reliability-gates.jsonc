      "id": "terminal-session.io-failure-cleanup",
      "title": "Native PTY I/O failures preserve termination ownership",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "terminal-runtime",
      "layer": "provider-contract",
      "surfaces": ["daemon PTY teardown"],
