      "id": "ssh-port-forward.renderer-snapshot-continuity",
      "title": "SSH forwarded-port state survives stale renderer hydration",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "desktop-ssh",
      "layer": "renderer-ssh-snapshot-reconciliation",
      "surfaces": [
