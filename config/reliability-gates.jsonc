nsport/system-ssh-operations.test.ts src/main/ssh/port-forwarding/ssh-port-forward.test.ts\",\n        \"ORCA_RUN_DOCKER_SSH_BROWSER_E2E=1 pnpm exec vitest run --config config/vitest.config.ts tests/e2e/ssh-browser-network-execution-route.docker.unit.test.ts\",\n        \"ORCA_RUN_DOCKER_SSH_BROWSER_E2E=1 node_modules/.bin/vitest run --config config/vitest.config.ts tests/e2e/ssh-browser-network-execution-route.docker.unit.test.ts\"\n      ]\ntestFiles: [\n        \"src/main/browser/routing/guest-authority/browser-route-webcontents-registry.test.ts\",\n        \"src/main/runtime/browser/client-pages/runtime-browser-client-page-recovery.test.ts\",\n        \"src/shared/browser/network/tunnels/browser-network-tunnel-protocol.test.ts\",\n        \"src/main/runtime/browser-host/reconciliation/browser-host-page-retirement.test.ts\",\n        \"src/main/runtime/browser-host/reconciliation/browser-host-page-placement-replacement.test.ts\",\n        \"src/main/runtime/browser-host/reconciliation/browser-host-page-placement.test.ts\",\n        \"src/main/runtime/browser-host/commands/browser-host-command-ledger.test.ts\",\n        \"src/main/runtime/browser-host/commands/browser-host-command-ledger-capacity.test.ts\",\n        \"src/main/runtime/browser-host/leases/browser-host-lease-registry.test.ts\",\n        \"src/main/runtime/rpc/server/runtime-rpc-browser-host-admission.test.ts\",\n        \"src/main/runtime/rpc/methods/browser/browser-client-host.test.ts\",\n        \"src/main/runtime/rpc/methods/browser/browser-client-host-reconciliation.test.ts\",\n        \"src/main/browser/client-hosts/leases/paired-runtime-browser-host-lease.test.ts\",\n        \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-reconnect.test.ts\",\n        \"src/main/browser/network/client-routes/browser-client-network-route-registry.test.ts\",\n        \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-composition.test.ts\",\n        \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-registry.test.ts\",\n        \"src/main/browser/client-pages/execution/browser-client-page-command-executor.test.ts\",\n        \"src/main/browser/client-pages/execution/browser-client-page-command-integration.test.ts\",\n        \"src/main/browser/client-pages/lifecycle/browser-client-page-reconciliation-adapters.test.ts\",\n        \"src/main/browser/client-pages/lifecycle/browser-client-page-inventory.test.ts\",\n        \"src/main/browser/routing/sessions/browser-route-prepared-page-rekey.test.ts\",\n        \"src/main/browser/client-hosts/commands/browser-client-host-command-dispatcher.test.ts\",\n        \"src/main/browser/network/tunnels/browser-network-tunnel-session.test.ts\",\n        \"src/main/browser/network/tunnels/browser-network-tunnel-session-aggregate-memory.test.ts\",\n        \"src/main/browser/network/tunnels/browser-network-tunnel-client.test.ts\",\n        \"src/main/browser/network/tunnels/browser-network-tunnel-outbound-memory-budget.test.ts\",\n        \"src/main/browser/network/execution-routes/browser-network-deferred-socket.test.ts\",\n        \"src/main/browser/network/execution-routes/browser-network-execution-route.test.ts\",\n        \"src/main/browser/network/execution-routes/paired-runtime-browser-network-route.test.ts\",\n        \"src/main/browser/network/execution-routes/ssh-browser-network-execution-route.test.ts\",\n        \"src/main/browser/network/tunnels/system-ssh-socks-client-socket.test.ts\",\n        \"src/main/ssh/system-transport/forwarding/system-ssh-dynamic-forward-process.test.ts\",\n        \"src/main/ssh/port-forwarding/ssh-port-forward.test.ts\",\n        \"src/main/browser/network/tunnels/remote-browser-socks-server.test.ts\",\n        \"src/main/runtime/rpc/methods/browser/browser-network-tunnel.test.ts\",\n        \"src/main/runtime/browser/network/browser-network-tunnel-paired-runtime.integration.test.ts\",\n        \"src/shared/remote-runtime/remote-runtime-client.test.ts\",\n        \"src/shared/remote-runtime/requests/remote-runtime-subscription-request.test.ts\",\n        \"src/shared/ws-outbound-backpressure-queue.test.ts\",\n        \"tests/e2e/ssh-browser-network-execution-route.docker.unit.test.ts\"\n      ]\nassertionRefs: [\n        {\n          \"file\": \"src/main/runtime/rpc/server/runtime-rpc-browser-host-admission.test.ts\",\n          \"assertions\": [\n            \"one paired device cannot consume the second device's reserved browser-host share\",\n            \"asks and browser hosts share a ceiling that retains one quarter of total capacity for waits\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-hosts/leases/paired-runtime-browser-host-lease.test.ts\",\n          \"assertions\": [\"closes a subscription acquired after local teardown\"]\n        },\n        {\n          \"file\": \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-reconnect.test.ts\",\n          \"assertions\": [\n            \"an acknowledged mutation replay uses the preserved dispatcher result without rerunning its handler\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-composition.test.ts\",\n          \"assertions\": [\n            \"waits for old handlers and ignores their late callbacks before replacement\",\n            \"keeps one command gate across repeated loss while fencing stale route recovery\",\n            \"fails closed without racing page cleanup when handlers do not settle\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-pages/execution/browser-client-page-command-executor.test.ts\",\n          \"assertions\": [\"holds Session and route release for the exact destroyed acknowledgement\"]\n        },\n        {\n          \"file\": \"src/main/browser/client-pages/lifecycle/browser-client-page-reconciliation-adapters.test.ts\",\n          \"assertions\": [\n            \"destroys a guest rekeyed during an authority transition instead of granting navigation\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/routing/sessions/browser-route-prepared-page-rekey.test.ts\",\n          \"assertions\": [\n            \"prepared authority rekeys without changing its opaque capability token\",\n            \"stale, occupied, cross-page, and cross-renderer targets fail without mutation\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-pages/execution/browser-client-page-command-integration.test.ts\",\n          \"assertions\": [\n            \"spontaneous exact guest destruction revokes active inventory before explicit page retirement\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-hosts/lifecycle/paired-runtime-browser-client-host-registry.test.ts\",\n          \"assertions\": [\"keeps a failed authority transition tombstoned until cleanup settles\"]\n        },\n        {\n          \"file\": \"src/main/browser/network/client-routes/browser-client-network-route-registry.test.ts\",\n          \"assertions\": [\n            \"retains one exact route until its final page releases it\",\n            \"keeps an ambiguously closed route fenced until final registry cleanup\",\n            \"retires old authority routes without destroying them before exact page cleanup\",\n            \"aborts a stale route recovery without retaining its retry timer\",\n            \"fails bounded recovery after one route exhausts grace without leaking timers\",\n            \"mints a fresh route for a retain that lands while the previous one is closing\",\n            \"waits for a route still closing before reporting retirement\",\n            \"rejects a retain the moment its signal aborts mid-startup\",\n            \"refuses a retain that waited out a closing route onto a retired registry\",\n            \"reports a failed final cleanup to an awaiting retirement\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/client-hosts/commands/browser-client-host-command-dispatcher.test.ts\",\n          \"assertions\": [\n            \"keeps a timed-out retirement fenced until its handler actually settles\",\n            \"bounds close while canceling queued and non-cooperative handlers\"\n          ]\n        },\n        {\n          \"file\": \"src/main/runtime/browser-host/commands/browser-host-command-ledger-capacity.test.ts\",\n          \"assertions\": [\n            \"oversized wire payloads fail before page, sequence, or delivery admission\",\n            \"new issue delivery failure closes the ledger and fences every outstanding outcome\"\n          ]\n        },\n        {\n          \"file\": \"src/main/runtime/rpc/methods/browser/browser-client-host.test.ts\",\n          \"assertions\": [\n            \"negotiated exact reattach emits ready before replaying the unchanged unsettled command\",\n            \"reattach before old cleanup preserves the same authority and ends only the superseded connection stream\",\n            \"only the exact negotiated connection, paired device, and live page placement can settle a server-owned command\",\n            \"exact duplicate results are idempotent while conflicts and stale or retired placement fail closed\",\n            \"a second browser-host identity on one authenticated connection is rejected\"\n          ]\n        },\n        {\n          \"file\": \"src/main/runtime/rpc/methods/browser/browser-client-host-reconciliation.test.ts\",\n          \"assertions\": [\n            \"command result settlement requires the exact negotiated reconciliation authority\"\n          ]\n        },\n        {\n          \"file\": \"src/shared/browser/network/tunnels/browser-network-tunnel-protocol.test.ts\",\n          \"assertions\": [\n            \"remote DNS names round-trip without client resolution\",\n            \"unknown versions, opcodes, oversized payloads, and length mismatches fail closed\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/browser-network-tunnel-session.test.ts\",\n          \"assertions\": [\n            \"replenishes client credit only after the destination write settles\",\n            \"keeps concurrent streams alive when late data arrives for a retired stream\",\n            \"flushes credited destination bytes before close\",\n            \"caps aggregate retained destination bytes and releases exact stream accounting\",\n            \"caps unsettled destination writes and releases retirement exactly once\",\n            \"releases queued bytes once when an accepted send closes reentrantly\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/browser-network-tunnel-session-aggregate-memory.test.ts\",\n          \"assertions\": [\n            \"multiple execution-host routes share browser-host application-byte admission in both traffic directions\",\n            \"route close releases aggregate claims exactly before stale destination-write callbacks\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/browser-network-tunnel-client.test.ts\",\n          \"assertions\": [\n            \"preserves remote DNS and waits for an opened acknowledgement\",\n            \"sends only credited bytes in bounded frames and replenishes consumed input\",\n            \"ignores a retired stream frame but rejects a never-allocated stream ID\",\n            \"never reuses stream IDs within one generation after its bounded ledger exhausts\",\n            \"replenishes only bytes settled after the readable consumer takes them\",\n            \"fails closed when pending tiny destination frames exceed the chunk cap\",\n            \"drains data that precedes a remote close before retiring the socket\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/browser-network-tunnel-outbound-memory-budget.test.ts\",\n          \"assertions\": [\n            \"application, encrypted-queue, and native socket bytes share one host ceiling\",\n            \"distinct hosts share one process ceiling with exact release\",\n            \"zero-byte claims, socket sources, hosts, and leases have independent bounds\",\n            \"released leases cannot admit work and retained owners keep exact accounting alive\",\n            \"unavailable native-buffer evidence fails closed until its exact source releases\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/remote-browser-socks-server.test.ts\",\n          \"assertions\": [\n            \"domain CONNECT preserves the final execution-host DNS target\",\n            \"unsupported commands and unavailable routes open no fallback destination\"\n          ]\n        },\n        {\n          \"file\": \"src/main/runtime/rpc/methods/browser/browser-network-tunnel.test.ts\",\n          \"assertions\": [\n            \"ungranted or wrong-key SSH routes are rejected before resolver or binary registration\",\n            \"connector diagnostics are mapped to a stable public error without local path disclosure\",\n            \"grant revocation aborts connector startup immediately and cannot race through route admission\",\n            \"the server allocates route generations and fences the replaced route\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/execution-routes/paired-runtime-browser-network-route.test.ts\",\n          \"assertions\": [\n            \"closes a subscription that resolves after route teardown\",\n            \"settles startup when close follows subscription acquisition before readiness\",\n            \"bounds the post-auth readiness wait\",\n            \"binds and releases the exact browser-host outbound memory lease\",\n            \"keeps one listener fail-closed and accepts an increasing replacement generation\",\n            \"ignores late callbacks from a superseded transport\",\n            \"recovers again after a second transport death\",\n            \"rejects a non-increasing replacement generation and remains retryable\",\n            \"fences a ready generation even when the replacement closes before its await resumes\",\n            \"replaces the tunnel generation before recycling a bounded stream ID\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/execution-routes/browser-network-deferred-socket.test.ts\",\n          \"assertions\": [\n            \"destroy before source attachment emits one close and destroys a late source\",\n            \"source close after destroy cannot emit duplicate wrapper close\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/execution-routes/browser-network-execution-route.test.ts\",\n          \"assertions\": [\n            \"execution-host route keys cannot collide on delimiter-containing identities\",\n            \"native routing accepts only the exact runtime revision without retaining an invalidation callback\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/execution-routes/ssh-browser-network-execution-route.test.ts\",\n          \"assertions\": [\n            \"does not adopt a replacement ssh2 client under the captured authority\",\n            \"releases a deferred socket when forwardOut throws during disconnect\",\n            \"aborts system SSH startup when route authorization is revoked\",\n            \"reaches external sites over ssh2 through the host proxy and keeps local names direct\",\n            \"dials directly while the host environment is unreadable and adopts it once a retry reads it\",\n            \"reaches external sites over system SSH through the host proxy\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/network/tunnels/system-ssh-socks-client-socket.test.ts\",\n          \"assertions\": [\n            \"the internal SOCKS5 client encodes the exact destination as a domain request\"\n          ]\n        },\n        {\n          \"file\": \"src/main/ssh/system-transport/forwarding/system-ssh-dynamic-forward-process.test.ts\",\n          \"assertions\": [\n            \"authority invalidation cancels an in-progress SSH launch and destroys its active readiness probe immediately\"\n          ]\n        },\n        {\n          \"file\": \"tests/e2e/ssh-browser-network-execution-route.docker.unit.test.ts\",\n          \"assertions\": [\n            \"an ephemeral sshd resolves a container-only domain and returns a unique HTTP marker\",\n            \"the real ssh2 forwardOut receives that exact domain and provider loss fences the route\",\n            \"one non-interactive system-OpenSSH dynamic forward passes the same remote-only oracle and closes cleanly\"\n          ]\n        },\n        {\n          \"file\": \"src/shared/remote-runtime/requests/remote-runtime-subscription-request.test.ts\",\n          \"assertions\": [\n            \"nested JSON responses route by exact request ID under reverse-order delivery\"\n          ]\n        },\n        {\n          \"file\": \"src/shared/remote-runtime/remote-runtime-client.test.ts\",\n          \"assertions\": [\n            \"the authenticated socket binds the optional tunnel capability\",\n            \"the dedicated outbound queue reports hard overflow instead of dropping a frame\",\n            \"encrypted queue claims release synchronously while native socket ownership remains charged through exact close\"\n          ]\n        },\n        {\n          \"file\": \"src/shared/ws-outbound-backpressure-queue.test.ts\",\n          \"assertions\": [\n            \"direct and already-retained queued frames use distinct aggregate admission semantics\",\n            \"queued drain yields after its configured frame quantum without reordering\",\n            \"aggregate queue claims release on drain, denial, disposal, and close\"\n          ]\n        }\n      ]",
        "Test-value audit: Retire the paired-host late subscription smoke: it checks a mocked close count and startup rejection, without remote unsubscribe or successor outcomes. No equivalent replacement or fresh execution is claimed.",
        "Test-value audit3842 removes four authored/four finite outbound queue probes and the count80 row from each of three inbound queue declarations (zero extra authored removals, three extra finite removals). Direct fast-path failure, synthetic work quantum, injected aggregate callback accounting, supplied unwritable guard, and repeated eighty-payload alarms are accepted losses without equivalent replacement claims. Remaining inbound count8 cases retain actual WeakRef/GC and FIFO/rejection observations. All three unrelated dated gate receipts retain their original command/results/counts and are not fresh validation of changed sources."
      ],
      "demotionRule": "Keep experimental or demote if a self-asserted or ambiguous host can receive a route, an SSH descriptor bypasses capability, lease-bound grant, or provider-authority checks, late cleanup can remove a replacement, a route can resolve names on the desktop, exceed a byte or stream bound, replenish credit before destination settlement, accept a stale or non-increasing generation, reuse a stream ID within one generation, lose or bypass its fail-closed listener during reconnect, expose the SOCKS listener off-loopback, accept BIND/UDP, or fall back when the selected route is unavailable."
