html-preview-local-render.spec.ts\",\n        \"tests/e2e/paired-preview-address-bar-convergence.spec.ts\",\n        \"tests/e2e/paired-browser-create-navigation-deadline.spec.ts\",\n        \"tests/e2e/paired-browser-creation-reconciliation-failure.spec.ts\",\n        \"src/renderer/src/runtime/web-session-tabs-sync/navigation/web-session-tabs-sync-focus-intent.test.ts\"\n      ]\nassertionRefs: [\n        {\n          \"file\": \"src/renderer/src/hooks/useIpcEvents-close-routing-session-tabs.test.ts\",\n          \"assertions\": [\"explicit cleanup cannot close a page owned by another worktree\"]\n        },\n        {\n          \"file\": \"src/renderer/src/store/slices/browser/browser.test.ts\",\n          \"assertions\": [\n            \"a requested canonical page ID is stored on the page rather than reused as its workspace ID\",\n            \"duplicate canonical page IDs are rejected before a second tab can materialize\"\n          ]\n        },\n        {\n          \"file\": \"tests/e2e/paired-remote-html-preview-local-render.spec.ts\",\n          \"assertions\": [\n            \"the host's HTML document renders inside the client-local orca-preview guest\",\n            \"neither the client browser-workspace count nor the host browser-tab count moves off baseline\",\n            \"the preview opens in its own split with mode html-preview and leaves the source editor active\",\n            \"an explicit click reactivates the preview, and closing it preserves the source editor, its group, and the terminal\",\n            \"the document reports having attempted both its unattended and its post-press egress, so neither absence assertion can pass on a document that never tried\",\n            \"a scripted window.open and location.href driven by a real press elsewhere in the document route nothing and move no browser count\",\n            \"a real target=_blank press in the rendered document routes out as an Orca browser tab while the preview stays open\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/document-preview/doc-preview-file-reader.test.ts\",\n          \"assertions\": [\n            \"reads a document too large for one reply by range under the same grant\",\n            \"refuses a document rewritten between ranges instead of splicing versions\",\n            \"requires approval for a sibling directory before touching the runtime\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/document-preview/doc-preview-grant-registry.test.ts\",\n          \"assertions\": [\n            \"keeps silent authority over a document directory strictly inside the workspace, and only there\",\n            \"uses Windows semantics when authorizing a sibling directory\",\n            \"keeps an approved SSH directory inside the canonical workspace boundary\"\n          ]\n        },\n        {\n          \"file\": \"src/main/browser/document-preview/doc-preview-failure-notice.test.ts\",\n          \"assertions\": [\"413 and 415 map to distinct reasons and everything else stays generic\"]\n        },\n        {\n          \"file\": \"src/main/browser/document-preview/doc-preview-guest-policy.test.ts\",\n          \"assertions\": [\n            \"never rebinds a bound guest onto a second grant\",\n            \"leaves a re-minted preview registered when the guest it replaced tears down\"\n          ]\n        },\n        {\n          \"file\": \"src/shared/document-preview/doc-preview-scheme.test.ts\",\n          \"assertions\": [\n            \"malformed grant ids and unsupported schemes are refused\",\n            \"undecodable percent escapes are refused\"\n          ]\n        },\n        {\n          \"file\": \"src/renderer/src/store/slices/browser/pages/browser-workspace-doc-location.test.ts\",\n          \"assertions\": [\n            \"a document page's url is blank in the store, in the written session and after restore\",\n            \"a document navigation report leaves its URL blank, its title standing and nothing loading; its session excludes preview URLs\"\n          ]\n        },\n        {\n          \"file\": \"src/renderer/src/components/browser-pane/workspace-doc/HtmlDocPreview.toolbar.test.tsx\",\n          \"assertions\": [\n            \"a preview that is the reader's surface hands its guest focus, and one that is not leaves focus alone\",\n            \"the window taking focus back re-offers it to the guest, and re-offers nothing for a preview that was refusing\"\n          ]\n        },\n        {\n          \"file\": \"tests/e2e/paired-browser-create-navigation-deadline.spec.ts\",\n          \"assertions\": [\n            \"a held navigation exceeds the former create deadline while the first RPC returns the exact authoritative host page ID\",\n            \"host inventory contains exactly one new page and the user retry branch is never entered\"\n          ]\n        },\n        {\n          \"file\": \"tests/e2e/paired-browser-creation-reconciliation-failure.spec.ts\",\n          \"assertions\": [\n            \"the exact created page exists on the host while publication is held and no browser tab materializes on the client\",\n            \"a forced post-create reconciliation timeout closes the exact host page and removes only the reserved empty split\",\n            \"a forced capability rejection after caller preflight shows a toast and restores exact host and client inventories\",\n            \"headed and headless hosts preserve the unrelated editor and terminal without local fallback\"\n          ]\n        },\n        {\n          \"file\": \"src/renderer/src/runtime/web-session-tabs-sync/navigation/web-session-tabs-sync-focus-intent.test.ts\",\n          \"assertions\": [\n            \"replays a snapshot that beat the RPC response and focuses the exact adopted leaf\",\n            \"retains exact-leaf focus intent when a split sibling publishes first\"\n          ]\n        }\n      ]",
        "Audit3832 deliberately retires76 authored/79 finite cases:75 runtime compatibility cases/78 finite cases across14 fragments, plus one localization extractor default-flag case. Three whole runtime fragments are deleted;27 authored/30 finite cases remain across the reviewed sources. This gate retains only its own selected scope; no equivalent replacement or fresh runtime/native/remote evidence is claimed. Runtime component A: Audit3828 composes3822 with independent3824: deliberately retires49 authored/52 finite cases from seven compatibility fragments, leaving15 authored/18 finite cases and deleting two entire fragments. Accepted losses: positive folder-worker recovery/materialization and reveal deadline; persisted-key normalization and legacy split/group/focus projection; fixed stale CAS refusal; occupied/alias/restored/preallocated terminal-handle variants; fixed OpenCode/Cursor/Claude/Codex/Antigravity classification, readiness, title and management examples; direct private-map browser authority projections; browser-focus and OMP title projection; already-aborted claim cleanup. Additional3824 loss: src/main/runtime/orca-runtime-tests/terminal-handles-and-agent-status-part-02.spec.ts :: does not poll a wrapper foreground for a speculative CLI prompt send :: Speculative retryForegroundWrappers:false check must return false on a wrapper after one foreground read, without polling the supplied later codex response. These real bounded alarms are deliberately retired for low marginal value. Retained callbacks are unchanged and provide only their own bounded scope, not equivalent replacement. Historical receipts do not validate reduced callbacks. No fresh runtime/native/SSH/WSL/phone/browser evidence or full transitive closure is claimed. Runtime component B: Audit3834 deliberately retires26 authored/26 finite cases from seven fresh compatibility fragments, leaving10/10 and deleting the one-case saved-binding reattachment fragment. Original position58 is excluded: its existing substantive3578 KEEP7 review remains historical, with no fresh credit. Accepted losses: fixed hook/provider-session identities and stale metadata refusal; decorative/pre-title foreground ordering variants; saved-binding surface reattachment; saved-row exit ghost removal and silent activation selection; unsupported headless wake; positive pending materialization/group projections; per-caller navigation selection; positive SSH hydration/read partition; laptop mobile publication/buffer and background/pending/status projections; abnormal/unregistered SSH grace, normal-exit refusal, persisted SSH hydration, positive serve reattachment, pending-agent launch arguments and direct seeded running-launch admission guard. These are real bounded alarms deliberately retired for low marginal value. Retained cases preserve their own distinct deferred foreground coalescing, usable handle continuity, stale inventory refresh, concurrent browser snapshot preservation, renderer graph fencing, caller dedup isolation, SSH partition writes, runtime split lifetime, independent relay-ready publication, lease admission/state/expiry. The direct running-launch no-spawn guard alarm is deliberately retired; no remaining owning-launch refusal coverage is claimed. Historical runs do not validate reduced callbacks. No equivalent replacement, runtime/native/SSH/WSL/phone/browser result or full transitive closure is claimed. Additional extractor loss: config/scripts/localization/source-extraction/audit-localization-native-dialogs.test.mjs :: does not change the existing renderer scan by default :: Default options must omit the five native-only fields in this supplied snippet. No equivalent replacement is claimed."
      ],
      "demotionRule": "Demote if a paired HTML preview creates a browser workspace on either side, renders from anything other than the orca-preview scheme, serves a read the host reported as truncated or over-cap, serves a document without the self-only content security policy, lets the preview session carry an off-machine request, reads an SSH path that canonicalizes outside its grant root, steals focus from the source editor when it opens, removes unrelated editor or terminal state on close, hides a document that rendered because one subresource was refused, leaves a grant readable after the tab or renderer that owns it is gone, mints one for a sender that is not the trusted renderer, opens a browser tab for a navigation the document started with no one at the keyboard, or lets the guest gather an ICE candidate; or if a paired browser creation this gate still owns produces duplicate client or host identities or loses its requested split."
    },
