{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/main/pi/rpc-model-schema.ts",
    "../src/main/pi/rpc-model-options.ts",
    "../src/shared/**/*"
  ],
  "exclude": [
    "../src/renderer/src/components/terminal-pane/pty-agent-pane-launch.test.ts",
    "../src/renderer/src/components/right-sidebar/SourceControlAgentActionDialog.picker.test.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
