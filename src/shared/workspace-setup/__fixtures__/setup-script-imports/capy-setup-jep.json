{
  "$schema": "https://api.capy.ai/schemas/setup.v1.json",
  "format_version": 1,
  "scripts": {
    "initialize": "./scripts/setup.sh",
    "refresh": "./scripts/setup.sh"
  },
  "startup": [],
  "commands": [
    {
      "name": "dev",
      "command": "pnpm db:start && ./scripts/with-local-supabase.sh pnpm dev --host 0.0.0.0 --port 3000",
      "port": 3000
    },
    {
      "name": "test",
      "command": "pnpm test"
    },
    {
      "name": "validate",
      "command": "pnpm db:start && pnpm validate"
    },
    {
      "name": "database",
      "command": "pnpm db:start"
    }
  ]
}
