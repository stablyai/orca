/rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Done"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check text-emerald-500 size-2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></span><span class="min-w-0 flex-1 truncate"><span class="font-medium text-foreground">Summarize logs</span></span><span class="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">900</span></li><li class="flex h-6 min-w-0 items-center gap-2 text-foreground/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot size-3.5 shrink-0 text-muted-foreground" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Working"><span data-agent-spinner="" class="agent-working-spinner block rounded-full border-2 border-yellow-500 border-t-transparent motion-reduce:border-t-yellow-500 size-1.5"></span></span><span class="min-w-0 flex-1 truncate"><span class="font-medium text-foreground">Review the parser</span></span><span class="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">18.2k · 10m 0s</span></li><li class="flex h-6 min-w-0 items-center gap-2 text-foreground/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot size-3.5 shrink-0 text-muted-foreground" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Blocked"><span class="block rounded-full size-1.5 bg-red-500"></span></span><span class="min-w-0 flex-1 truncate"><span class="font-medium text-foreground">Explore</span><span class="text-muted-foreground"> · failed</span></span><span class="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">8m 20s</span></li><li class="flex h-6 min-w-0 items-center gap-2 text-foreground/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot size-3.5 shrink-0 text-muted-foreground" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Working"><span data-agent-spinner="" class="agent-working-spinner block rounded-full border-2 border-yellow-500 border-t-transparent motion-reduce:border-t-yellow-500 size-1.5"></span></span><span class="min-w-0 flex-1 truncate"><span class="font-medium text-foreground">Old host child</span></span><span class="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">6m 40s</span></li></ul></div><div class="mt-1.5 border-t border-border/60 pt-1.5"><p class="px-0.5 pb-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Shell</p><ul role="list" aria-label="Shell" class="space-y-0.5"><li class="flex h-6 min-w-0 items-center gap-2 text-foreground/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-terminal size-3.5 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Working"><span data-agent-spinner="" class="agent-working-spinner block rounded-full border-2 border-yellow-500 border-t-transparent motion-reduce:border-t-yellow-500 size-1.5"></span></span><span class="min-w-0 flex-1 truncate"><span class="font-medium text-foreground">npm run dev</span></span><span class="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">11m 40s</span></li></ul></div><div class="mt-1.5 border-t border-border/60 pt-1.5"><p class="px-0.5 pb-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">Monitors</p><ul role="list" aria-label="Monitors" class="space-y-0.5"><li class="flex h-6 min-w-0 items-center gap-2 text-foreground/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity size-3.5 shrink-0 text-yellow-500" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg><span class="inline-flex shrink-0 items-center justify-center h-2.5 w-2.5" aria-label="Monitoring background tasks"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity text-yellow-500 size-2.5" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.9