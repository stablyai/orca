{
  "id": "aiwork",
  "engineVersion": 1,
  "anchors": [
    {
      "id": "approval_menu_en",
      "why": "AiWork reports its own state over OSC 7501 (blocked/permission while this box is open); these anchors are the fallback for releases or settings without it, and they give terminal wait its blocked reason. AiWork's title does not change while the box is open. English literals avoid inner spaces, which the tail can lose where a chunk ends. Footer keys stay untranslated and AiWork cuts its footer from the end, so `enter confirm` survives narrow panes.",
      "when": {
        "region": "text",
        "find": {
          "lastOf": "proceed"
        },
        "withinLastLines": 12,
        "after": {
          "all": [
            {
              "contains": "reject"
            },
            {
              "regex": "enter\\s*confirm"
            }
          ]
        },
        "lines": {
          "atLeast": 1,
          "includingLast": false,
          "test": {
            "regex": "choose\\s*how\\s*to\\s*proceed"
          }
        }
      },
      "answer": {
        "state": "blocked",
        "reason": "agent-approval-prompt"
      }
    },
    {
      "id": "approval_menu_zh",
      "why": "approval_menu_en in AiWork's default Simplified Chinese UI (`选择处理方式`, `拒绝`, `enter 确认当前选项`).",
      "when": {
        "region": "text",
        "find": {
          "lastOf": "选择处理方式"
        },
        "withinLastLines": 12,
        "after": {
          "all": [
            {
              "contains": "拒绝"
            },
            {
              "regex": "enter\\s*确认"
            }
          ]
        }
      },
      "answer": {
        "state": "blocked",
        "reason": "agent-approval-prompt"
      }
    },
    {
      "id": "approval_menu_zh_hk",
      "why": "approval_menu_en in AiWork's Traditional Chinese UI (`選擇處理方式`, `拒絕`, `enter 確認當前選項`).",
      "when": {
        "region": "text",
        "find": {
          "lastOf": "選擇處理方式"
        },
        "withinLastLines": 12,
        "after": {
          "all": [
            {
              "contains": "拒絕"
            },
            {
              "regex": "enter\\s*確認"
            }
          ]
        }
      },
      "answer": {
        "state": "blocked",
        "reason": "agent-approval-prompt"
      }
    },
    {
      "id": "question_menu_en",
      "why": "AiWork's ask-user box ends with `Decline answer` (`Decline all questions` for a group) and a footer such as `↑↓ Switch options · enter Submit · esc Exit`; multi-question and multi-select boxes say `enter Next`, `enter Confirm` or `enter Review`. Enter takes the highlighted answer, so typed input must wait.",
      "when": {
        "region": "text",
        "find": {
          "lastOf": "decline"
        },
        "withinLastLines": 12,
        "after": {
          "all": [
            {
              "regex": "^decline\\s*(?:answer|all\\s*questions)"
            },
            {
              "regex": "enter\\s*(?:submit|confirm|next|review)"
            }
          ]
        }
      },
      "answer": {
        "state": "blocked",
        "reason": "agent-interactive-prompt"
      }
    },
    {
      "id": "question_menu_zh",
      "why": "question_menu_en in Simplified Chinese (`拒绝回答` or `拒绝整组问题`, footer `enter 提交`, `确认`, `下一题` or `审查`).",
      "when": {
