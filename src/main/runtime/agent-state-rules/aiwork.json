    {
      "id": "composer_back",
      "why": "AiWork repaints without newlines, so an answered box stays in the line tail. Its composer `❱` (U+2771, unlike other agents' `❯`) is hidden while a box or the plan review is open and painted again above its `─` rule once it closes, in every language and width. Sent messages also start with `❱` but no rule follows them, and the pane must show AiWork's mode row (`Agent ·`, `Plan ·`).",
      "when": {
        "region": "text",
        "find": {
          "lastOf": "❱"
        },
        "after": {
          "regex": "^❱[^❱]*─{8,}"
        },
        "lines": {
          "atLeast": 1,
          "includingLast": false,
          "test": {
            "regex": "(?:agent|plan)\\s*·\\s*(?:◆\\s*)?\\S"
          }
        }
      },
      "answer": {
        "state": "live"
      }
    }
  ],
  "rules": []
