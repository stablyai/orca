# ============================================================================
# orca-serve-instance.env.template — PER-INSTANCE configuration (one per slot)
#
# Deployed to @PREFIX@/etc/instances/<slot>.env and loaded by orca-serve@<slot>.service
# as the SECOND EnvironmentFile= line — it overrides any overlapping key from the host
# orca-serve.conf. Copy to the slot name (e.g. factory.env, lesley.env, canary.env).
#
# Authoring rule (CONTRACT.md v2 §2b): a value goes HERE if it differs by INSTANCE or
# VERSION. Host-wide values belong in orca-serve.conf; never duplicate a value in both.
#
# .template semantics: install.sh installs this file and creates the LIVE <slot>.env
# alongside it ONLY IF <slot>.env is absent — it must never clobber an operator-edited
# live env. The live file is what the unit's second EnvironmentFile= reads.
# ============================================================================

# ---------------------------------------------------------------------------
# Build pin
# ---------------------------------------------------------------------------
# Which Orca build this slot runs. SET for a pinned slot (canary under an RC test);
# UNSET for a slot that CHASES LATEST (factory tracks the stable release via the
# auto-upgrade engine). UNSET makes serve-fg resolve the running build from the
# stable serve-root symlink; SETTING it runs share/serve-root-<pin> and SHADOWS
# auto-upgrade on that slot (the marker advances but the serve keeps the pinned build).
# ---------------------------------------------------------------------------
ORCA_VERSION=1.4.110

# ---------------------------------------------------------------------------
# Per-instance pairing port (CONTRACT §1 table)
#   factory 6768   lesley 6769   jessica 6770   canary 6771 (on-demand)
# Must be unique per host. A collision is Bucket 3 (Server Config) — the pinned
# port is defeated, or a stale mobile-ws-fallback-port.json pre-empts it (STA-1511).
# ---------------------------------------------------------------------------
ORCA_SERVE_PORT=6768

# ---------------------------------------------------------------------------
# Profile / isolation mode
#   shared  -> svc_orca:revive tree (setgid+ACL, group-readable/writable) — the ONE
#              shared factory instance multiple humans access.
#   private -> svc_orca:svc_orca 0700 (mutually invisible per-user slots).
# ---------------------------------------------------------------------------
ORCA_PROFILE_MODE=shared

# Account this instance's automation hub runs under (config, never a hardcode).
ORCA_CLAUDE_ACCOUNT=riley

# ---------------------------------------------------------------------------
# Per-instance logging verbosity
#
# The ONLY verbosity knob is ELECTRON_ENABLE_LOGGING (Electron/Chromium internal
# logging -> stderr -> journald + serve-fg.log). Setting it here escalates THIS slot
# only, because this file is the second EnvironmentFile= and overrides the host
# orca-serve.conf default of 0 — that is how you reproduce a GPU/native-crash fault
# on `canary` without flooding the always-on slots.
#
# There is NO app-level log level: `ORCA_LOG_LEVEL` and `ORCA_DEBUG` are not
# implemented in the Orca source, and `orca serve` rejects `--verbose` as an unknown
# flag. Do not add them here. For more signal, take a diag bundle
# (`orca-serve-diag --phase after`); see docs/guides/orca-serve-logging-guide.md §2.
# ---------------------------------------------------------------------------
# ELECTRON_ENABLE_LOGGING=1

# ---------------------------------------------------------------------------
# Instance-scoped agent tool auth (factory/seats) — NOT host-wide.
#
# A private slot (lesley/jessica) sets its own .auth/<user> paths here; the shared
# factory slot sets the daemon seat's /data/opt/<app>/.auth/svc_orca stores. These
# MUST NOT live in orca-serve.conf — that would glue every instance to one identity.
# Examples:
#    CLAUDE_CONFIG_DIR=/data/opt/claude/.auth/svc_orca
#    GH_CONFIG_DIR=/data/opt/github/.auth/svc_orca
#    GROK_HOME=/data/opt/grok/.auth/svc_orca
# ---------------------------------------------------------------------------