+  ['powershell', 'powershell.exe'],
+  ['pwsh.exe', 'pwsh.exe'],
+  ['pwsh', 'pwsh.exe'],
+  ['cmd.exe', 'cmd.exe'],
+  ['cmd', 'cmd.exe'],
+  ['wsl.exe', 'wsl.exe'],
+  ['wsl', 'wsl.exe'],
