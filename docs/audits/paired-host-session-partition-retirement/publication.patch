+  AGENT_STATUS_STORE_SNAPSHOT_VERSION,
+  AGENT_STATUS_STORE_TOMBSTONE_RETENTION_REVISIONS,
+  type AgentStatusFactIdentity,
+  type AgentStatusFactRecord,
