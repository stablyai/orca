<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Keeps reading agent replies aloud with the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service
      android:name="expo.modules.orcareadaloud.ReadAloudService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
    <service
      android:name="expo.modules.orcareadaloud.ReadAloudTileService"
      android:exported="true"
      android:icon="@drawable/orca_read_aloud_auto_read"
      android:label="Read aloud"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
        android:name="android.service.quicksettings.TOGGLEABLE_TILE"
        android:value="true" />
    </service>
  </application>
</manifest>
