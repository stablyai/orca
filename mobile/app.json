{
  "expo": {
    "name": "Orca",
    "slug": "orca-mobile",
    "version": "0.0.68",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "orca",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "pt-BR": "./locales/pt-BR.json",
      "ru": "./locales/ru.json",
      "tr": "./locales/tr.json",
      "de": "./locales/de.json"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stably.orca.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocalNetworkUsageDescription": "Orca connects to the desktop app on your LAN.",
        "NSMicrophoneUsageDescription": "Allow Orca to use your microphone for voice dictation, transcribed on this phone or on your paired computer.",
        "NSPhotoLibraryUsageDescription": "Allow Orca to attach photos from your library to a terminal session on your paired desktop.",
        "NSPhotoLibraryAddUsageDescription": "Allow Orca to save images from your sessions to Photos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "fd7a:115c:a1e0::/48": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "dev.orca.app",
      "versionCode": 32,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "zh-Hans", "zh-Hant", "ja", "ko", "es", "fr", "pt-BR", "ru", "tr", "de"]
          }
        }
      ],
      [
        "./plugins/android-locale-config.js",
        {
          "locales": ["en", "zh-Hans", "zh-Hant", "ja", "ko", "es", "fr", "pt-BR", "ru", "tr", "de"]
        }
      ],
      "expo-notifications",
      "./plugins/android-respect-rotation-lock.js",
      "./plugins/android-window-density.js",
      "./plugins/android-release-signing.js",
      "./plugins/android-navigation-bar-theme.js",
      "./plugins/android-device-transfer-rules.js",
      "./plugins/android-retired-app-name.js",
      "./plugins/ios-pod-deployment-target-floor.js",
      "./plugins/ios-scene-lifecycle.js",
      "./plugins/ios-bundle-phase-quoted-script-path.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Orca to use the camera for QR code scanning.",
          "microphonePermission": "Allow Orca to use your microphone for voice dictation sent to your paired desktop for transcription.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Orca to attach photos from your library to a terminal session on your paired desktop."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "OrcaUsage",
              "displayName": "Agent Usage",
              "description": "Agent usage from your paired desktops, as Orca last saw it.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "configuration": {
                  "title": "Agent Usage",
                  "parameters": {
                    "desktop": {
                      "title": "Desktop",
                      "entity": true,
                      "type": "enum",
                      "dynamic": true,
                      "values": [{ "name": "Most recently updated", "value": "automatic" }],
                      "default": "automatic"
                    },
                    "agentMode": {
                      "title": "Agent Selection",
                      "type": "enum",
                      "values": [
                        { "name": "Automatic (most used)", "value": "automatic" },
                        { "name": "Choose", "value": "custom" }
                      ],
                      "default": "automatic"
                    },
                    "agents": {
                      "title": "Agents",
                      "visibleWhen": { "parameter": "agentMode", "equalTo": "custom" },
                      "type": "enum",
                      "dynamic": true,
                      "multiple": true,
                      "size": { "systemSmall": 2, "systemMedium": 3, "systemLarge": 6 },
                      "values": [],
                      "default": "automatic"
                    },
                    "window": {
                      "title": "Usage Window",
                      "type": "enum",
                      "values": [
                        { "name": "Automatic", "value": "automatic" },
                        { "name": "5 hours", "value": "session" },
                        { "name": "Weekly", "value": "weekly" },
                        { "name": "5 hours and weekly", "value": "both" }
                      ],
                      "default": "automatic"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
