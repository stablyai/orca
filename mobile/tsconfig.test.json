{
  // The main config excludes test files so Metro never compiles them into the release bundle, and
  // vitest transpiles without typechecking — so until this config existed nothing typechecked a
  // mobile test, and a type-level pin written in one proved nothing.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    // These tests are Node-side, not React Native: they import the desktop main process or
    // @orca/process-host, whose modules are written against @types/node. This program's libs
    // are React Native's, where `setTimeout` answers a number rather than a NodeJS.Timeout, so
    // pulling that graph in reports ~280 errors about the desktop rather than about mobile. Their
    // own runtime coverage is vitest, which runs them under Node.
    "src/components/WorktreeAgentList.runtime-lineage.test.tsx",
    "src/session/mobile-native-command-discovery.test.tsx",
    "src/tasks/agent-launch-mobile-replay.test.ts",
    "src/worktree/project-sections-owner-recovery.test.ts",
    "src/mobile-web-shell/mobile-web-shell-project-controls.test.ts",
    "src/mobile-web-shell/mobile-web-shell-nested-project-filter.test.ts",
    // Creation shares their checked host-declaration owner but executes in Mobile CI's Bun role.
    "src/components/new-workspace-owner-controls.test.tsx",
    "src/test-support/rpc-recording/recorded-request-params.test.ts",
    "src/tasks/mobile-agent-launch-architecture.test.ts",
    "src/transport/mobile-relay-browser-cancel-budget.test.ts",
    "src/transport/mobile-web-bundle-host-slow-link.test.ts"
  ]
}
