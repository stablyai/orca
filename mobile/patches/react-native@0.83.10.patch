index 5d95b90bca818a75a925a6a8b4b786b11d1a9355..c070881d52a10a4f20c8b445943329ac28ce9a49 100644
--- a/React/CoreModules/RCTWebSocketModule.mm
+++ b/React/CoreModules/RCTWebSocketModule.mm
@@ -7,7 +7,10 @@
 
 #import <React/RCTWebSocketModule.h>
 
+#import <netinet/in.h>
+#import <netinet/tcp.h>
 #import <objc/runtime.h>
+#import <sys/socket.h>
 
 #import <FBReactNativeSpec/FBReactNativeSpec.h>
 #import <React/RCTConvert.h>
@@ -16,6 +19,33 @@
 
 #import "CoreModulesPlugins.h"
 
+// Orca: SocketRocket leaves Nagle's algorithm on, which holds every small frame until the one
+// before it is acknowledged; overlapping terminal input then leaves once per round trip.
+static void RCTWebSocketDisableNagle(SRWebSocket *webSocket)
+{
+  @try {
+    // SocketRocket keeps its streams private; the output stream is the connected socket's.
+    id stream = [webSocket valueForKey:@"outputStream"];
+    if (![stream isKindOfClass:[NSOutputStream class]]) {
+      return;
+    }
+    CFDataRef handle = (CFDataRef)CFWriteStreamCopyProperty(
+        (__bridge CFWriteStreamRef)stream, kCFStreamPropertySocketNativeHandle);
+    if (handle == NULL) {
+      return;
+    }
+    if (CFDataGetLength(handle) == sizeof(CFSocketNativeHandle)) {
+      CFSocketNativeHandle socket;
+      CFDataGetBytes(handle, CFRangeMake(0, sizeof(socket)), (UInt8 *)&socket);
+      int enabled = 1;
+      setsockopt(socket, IPPROTO_TCP, TCP_NODELAY, &enabled, sizeof(enabled));
+    }
+    CFRelease(handle);
+  } @catch (NSException *exception) {
+    // A SocketRocket without that ivar keeps its default behaviour.
+  }
+}
+
 @implementation SRWebSocket (React)
 
