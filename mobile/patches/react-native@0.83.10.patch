 - (void)webSocketDidOpen:(SRWebSocket *)webSocket
 {
+  RCTWebSocketDisableNagle(webSocket);
   [self sendEventWithName:@"websocketOpen"
                      body:@{@"id" : webSocket.reactTag, @"protocol" : webSocket.protocol ? webSocket.protocol : @""}];
 }
