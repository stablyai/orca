{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    // Mobile stays on TypeScript 6 so Expo/Metro can still use the JS
    // compiler API (require('typescript').sys) during release bundling.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "paths": {
      "tweetnacl": ["./node_modules/tweetnacl"],
      "ws": ["./node_modules/@types/ws"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // The measurement harness drives the desktop main-process reader directly; that code is
  // typed against Node's lib, which this React Native program cannot model.
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "scripts/mobile-web-package-download-measurement.ts",
    "scripts/mobile-web-package-download-loopback-clients.ts"
  ]
}
