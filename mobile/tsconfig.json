{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@project-grouping-test-host/*": ["../src/*"],
      "@noble/hashes/*": ["./node_modules/@noble/hashes/*"],
      "smol-toml": ["./node_modules/smol-toml"],
      "tweetnacl": ["./node_modules/tweetnacl"],
      "ws": ["./node_modules/@types/ws"],
      "zod": ["./node_modules/zod"],
      "@orca/test-mobile/*": ["./src/*"],
      "@orca/test-host/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-fixture.ts"]
}
