{
  "name": "orca-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native": "node scripts/native-client.mjs",
    "postinstall": "node scripts/build-terminal-webview-engine.mjs && node scripts/build-mermaid-page-engine.mjs && node scripts/build-katex-page-style.mjs && node scripts/build-terminal-document-script.mjs",
    "test": "vitest run",
    "typecheck": "node ../config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --project=mobile/tsconfig.json",
    "typecheck:tests": "node ../config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --project=mobile/tsconfig.test.json",
    "check:tests-typecheck": "node scripts/check-tests-typecheck-ratchet.mjs",
    "rpc:record": "tsx --conditions=orca-source scripts/rpc-recording.mts",
    "rpc:diff": "tsx --conditions=orca-source scripts/rpc-diff.mts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "mock-server": "npx tsx scripts/mock-server.ts",
    "repro:workspace-picker-lag": "npx tsx scripts/repro-workspace-picker-lag.ts",
    "start:emulator": "node scripts/start-emulator.mjs"
  },
