!src/renderer/src/env.d.ts
!src/renderer/src/mermaid.d.ts
!src/types/build-constants.d.ts

node_modules/
# Match symlinked installs too; the trailing-slash pattern only matches directories.
node_modules

dist/
dist-electron/
out/
/build/
release/
native/**/.build/
native/windows-cli-launcher/target/
native/windows-agent-hook/target/
