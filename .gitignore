native/windows-registry/bin/
native/windows-security/build/
native/windows-security/bin/
.build/windows-security/

.pnpm-store/
package-lock.json

.env
.env.local
.env.*.local

.vscode/
.idea/
.serena/
*.swp
*.swo
*~

