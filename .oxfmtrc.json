{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schemas/oxfmt/v0.41.0/config.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "ignorePatterns": [
    "cloud/**",
    "resources/licenses/**",
    ".github/actions/cloud-sql-rollout-lease/**",
    ".anti-slop-plugin/**",
    "src/main/runtime/__fixtures__/*.timing.json",
    "resources/skills/released-digests.json",
    "docs/schemas/plugins/**/*.schema.json",
    "examples/plugins/*/orca-plugin.v2.schema.json",
    "docs/reference/plugin-manifest.md",
    "docs/reference/plugin-catalog.md"
  ]
}
