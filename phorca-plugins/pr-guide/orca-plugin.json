{
  "manifestVersion": 1,
  "id": "pr-guide",
  "publisher": "phocassoftware",
  "name": "PR Guide",
  "version": "0.4.7",
  "description": "Review GitHub PRs with chaptered guides, real diffs, and inline comments sent to GitHub or a local agent session.",
  "engines": { "orca": ">=1.4.224" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [
      { "id": "create-guide", "title": "PR Guide: Create from clipboard" }
    ]
  },
  "capabilities": [{ "kind": "notifications:show" }, { "kind": "storage" }]
}
